{
  "name": "@extenddb/dev",
  "version": "0.1.0",
  "description": "ExtendDB dev server launcher: a DynamoDB-compatible database for local development and CI. Spawns the extenddb dev binary (file-backed by default, in-memory with --memory) and hands back an endpoint plus credentials any AWS SDK accepts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtendDB/extenddb.git",
    "directory": "packaging/npm"
  },
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "extenddb": "bin/extenddb-launcher.js"
  },
  "files": [
    "index.js",
    "bin/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/launcher.test.js"
  },
  "optionalDependencies": {
    "@extenddb/linux-x64": "0.1.0",
    "@extenddb/linux-arm64": "0.1.0",
    "@extenddb/darwin-x64": "0.1.0",
    "@extenddb/darwin-arm64": "0.1.0",
    "@extenddb/win32-x64": "0.1.0"
  }
}
