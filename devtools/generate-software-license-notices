set -euo pipefail
exec < /dev/null

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_DIR"

EXPECTED_VERSION="0.9.0"
MODE="generate"
BACKEND="postgres"
OUTPUT="SOFTWARE-LICENSE-NOTICES.html"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --check)
            MODE="check"
            shift
            ;;
        --backend)
            if [[ $# -lt 2 || -z "$2" ]]; then
                echo "error: --backend requires a value" >&2
                exit 2
            fi
            BACKEND="$2"
            shift 2
            ;;
        *)
            echo "usage: devtools/generate-software-license-notices [--check] [--backend postgres|mongodb]" >&2
            exit 2
            ;;
    esac
done
case "$BACKEND" in
    postgres) OUTPUT="SOFTWARE-LICENSE-NOTICES.html" ;;
    mongodb) OUTPUT="SOFTWARE-LICENSE-NOTICES-MONGODB.html" ;;
    *)
        echo "error: --backend must be 'postgres' or 'mongodb'" >&2
        exit 2
        ;;
esac
if ! cargo about --version >/dev/null 2>&1; then
    echo "error: cargo-about $EXPECTED_VERSION is required" >&2
    echo "install with: cargo install --locked --version $EXPECTED_VERSION --features cli cargo-about" >&2
    exit 1
fi

ACTUAL_VERSION=$(cargo about --version | awk '{print $2}')
if [[ "$ACTUAL_VERSION" != "$EXPECTED_VERSION" ]]; then
    echo "error: cargo-about $EXPECTED_VERSION required; found $ACTUAL_VERSION" >&2
    exit 1
fi

TEMP=$(mktemp "${TMPDIR:-/tmp}/extenddb-notices.XXXXXX")
trap 'rm -f "$TEMP"' EXIT

cargo about generate \
    --manifest-path crates/bin/Cargo.toml \
    --no-default-features \
    --features "$BACKEND" \
    --locked \
    --fail \
    about.hbs \
    --output-file "$TEMP"

if [[ "$MODE" == "check" ]]; then
    if ! cmp -s "$TEMP" "$OUTPUT"; then
        echo "error: $OUTPUT is stale" >&2
        echo "run: devtools/generate-software-license-notices --backend $BACKEND" >&2
        exit 1
    fi
    echo "$OUTPUT is current"
else
    mv "$TEMP" "$OUTPUT"
    chmod 0644 "$OUTPUT"
    trap - EXIT
    echo "generated $OUTPUT"
fi
