def workflow(*lines: str) -> str:
    """A workflow whose job `build` has the steps in lines, each line indented
    as it is under `steps:`."""
    return "on: push\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n" + "".join(
        f"      {line}\n" for line in lines
    )


def composite(*lines: str) -> str:
    """A composite action with the steps in lines."""
    return "runs:\n  using: composite\n  steps:\n" + "".join(f"    {line}\n" for line in lines)


def write_tree(top: str, files: dict[str, str], links: tuple[tuple[str, str], ...] = ()) -> None:
    """Write files ({path: text}, with <sha> replaced by SHA) and symlinks
    ((path, target) pairs) under top."""
    for path, text in files.items():
        os.makedirs(os.path.dirname(os.path.join(top, path)), exist_ok=True)
        with open(os.path.join(top, path), "w", encoding="utf-8") as f:
            f.write(text.replace("<sha>", SHA))
    for path, target in links:
        os.makedirs(os.path.dirname(os.path.join(top, path)), exist_ok=True)
        os.symlink(target, os.path.join(top, path))


class SelfTest(unittest.TestCase):
    """A pinned and an unpinned control, and the cases that a check reading
    `uses:` lines one at a time gets wrong. Such a check passes the unpinned
    references in A1 to A5. It fails the pinned references in B1 and B2. It
    passes the trees in C1 and C2, which it cannot read. A6 and C3 hold job
    ids that YAML 1.1 reads as one key."""

    def run_check(self, files: dict[str, str], links=(), root: str = "") -> tuple[int, str]:
        with tempfile.TemporaryDirectory() as top:
            write_tree(top, files, links)
            code, lines = check(os.path.join(top, root))
        return code, "\n".join(lines)

    def assert_line(self, out: str, line: str) -> None:
        self.assertIn(line, out.splitlines(), out)

    def test_control_pinned_references_pass(self) -> None:
        code, out = self.run_check({
            ".github/workflows/ci.yml": (
                workflow(
                    "- uses: actions/checkout@<sha> # v6.1.0",
                    "- uses: 'actions/setup-python@<sha>'",
                    "- uses: docker://alpine:3.20",
                    "- uses: ./.github/actions/local",
                )
                + "  remote:\n    uses: owner/repo/.github/workflows/build.yml@<sha> # v1\n"
                + "  local:\n    uses: ./.github/workflows/called.yml\n"
            ),
            ".github/workflows/called.yml": workflow("- uses: actions/cache@<sha> # v4"),
            ".github/actions/local/action.yml": composite("- uses: actions/cache@<sha> # v4"),
        })
        self.assertEqual(code, 0, out)
        self.assert_line(out, "Files checked: 2 workflow, 1 action.")

    def test_control_an_unpinned_reference_fails_with_its_file_job_and_step(self) -> None:
        code, out = self.run_check({".github/workflows/ci.yml": workflow(
            "- uses: actions/checkout@<sha>", "- name: Cache", "  uses: actions/cache@v4")})
        self.assertEqual(code, 1, out)
        self.assert_line(out, ".github/workflows/ci.yml: jobs.build.steps[1] (Cache): actions/cache@v4")
        self.assertNotIn("checkout", out)

    def test_a1_a_value_on_the_line_after_the_key_is_read(self) -> None:
        code, out = self.run_check({".github/workflows/ci.yml": workflow("- uses:", "    actions/cache@v4")})
        self.assertEqual(code, 1, out)
        self.assert_line(out, ".github/workflows/ci.yml: jobs.build.steps[0]: actions/cache@v4")

    def test_a2_a_step_in_flow_style_is_read(self) -> None:
        code, out = self.run_check({".github/workflows/ci.yml": workflow("- {uses: actions/cache@v4}")})
        self.assertEqual(code, 1, out)
        self.assert_line(out, ".github/workflows/ci.yml: jobs.build.steps[0]: actions/cache@v4")

    def test_a3_a_local_action_outside_github_is_read(self) -> None:
        code, out = self.run_check({
            ".github/workflows/ci.yml": workflow("- uses: ./ci/act"),
            "ci/act/action.yml": composite("- uses: actions/cache@v4"),
        })
        self.assertEqual(code, 1, out)
        self.assert_line(out, "ci/act/action.yml: runs.steps[0]: actions/cache@v4")

    def test_a4_symlinks_that_point_outside_the_repository_are_read(self) -> None:
        code, out = self.run_check({
            "repo/.github/workflows/ci.yml": workflow("- uses: ./.github/actions/act"),
            "outside/linked.yml": workflow("- uses: actions/cache@v4"),
            "outside/act/action.yml": composite("- uses: actions/setup-node@v4"),
        }, links=(
            ("repo/.github/workflows/linked.yml", "../../../outside/linked.yml"),
            ("repo/.github/actions/act", "../../../outside/act"),
        ), root="repo")
        self.assertEqual(code, 1, out)
        self.assert_line(out, ".github/workflows/linked.yml: jobs.build.steps[0]: actions/cache@v4")
        self.assert_line(out, ".github/actions/act/action.yml: runs.steps[0]: actions/setup-node@v4")

    def test_a5_a_file_name_with_a_colon_is_read(self) -> None:
        code, out = self.run_check({".github/workflows/a:b.yml": workflow("- uses: actions/cache@v4")})
        self.assertEqual(code, 1, out)
        self.assert_line(out, ".github/workflows/a:b.yml: jobs.build.steps[0]: actions/cache@v4")

    def test_a6_job_ids_that_yaml_1_1_reads_as_one_boolean_are_two_jobs(self) -> None:
        code, out = self.run_check({".github/workflows/ci.yml": (
            "on: push\njobs:\n"
            "  yes:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/cache@v4\n"
            "  on:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/cache@<sha>\n")})
        self.assertEqual(code, 1, out)
        self.assert_line(out, ".github/workflows/ci.yml: jobs.yes.steps[0]: actions/cache@v4")

    def test_b1_a_pinned_value_in_a_block_scalar_passes(self) -> None:
        code, out = self.run_check({".github/workflows/ci.yml": workflow("- uses: >-", "    actions/cache@<sha>")})
        self.assertEqual(code, 0, out)

    def test_b2_a_pinned_value_with_an_anchor_and_its_alias_pass(self) -> None:
        pinned = workflow("- uses: &cache actions/cache@<sha>", "- uses: *cache")
        code, out = self.run_check({".github/workflows/ci.yml": pinned})
        self.assertEqual(code, 0, out)
        code, out = self.run_check({".github/workflows/ci.yml": pinned.replace("@<sha>", "@v4")})
        self.assertEqual(code, 1, out)
        self.assert_line(out, ".github/workflows/ci.yml: jobs.build.steps[0]: actions/cache@v4")
        self.assert_line(out, ".github/workflows/ci.yml: jobs.build.steps[1]: actions/cache@v4")

    def test_c1_a_file_that_cannot_be_read_or_parsed_fails(self) -> None:
        code, out = self.run_check({
            ".github/workflows/ok.yml": workflow("- uses: actions/cache@<sha>"),
            ".github/workflows/bad.yml": "jobs: [\n",
            ".github/workflows/shape.yml": "jobs:\n  build:\n    steps: run\n",
            ".github/workflows/repeated.yml": workflow("- uses: actions/cache@<sha>", "  uses: actions/cache@v4"),
            ".github/workflows/merge.yml": workflow("- &step {uses: actions/cache@<sha>}", "- {<<: *step}"),
        }, links=((".github/workflows/gone.yml", "missing.yml"),))
        self.assertEqual(code, 2, out)
        for name in ("bad", "shape", "repeated", "merge", "gone"):
            self.assertIn(f"error: .github/workflows/{name}.yml: ", out)
        self.assertNotIn("error: .github/workflows/ok.yml", out)

    def test_c3_two_keys_that_read_as_one_value_fail(self) -> None:
        code, out = self.run_check({".github/workflows/ci.yml": (
            "on: push\njobs:\n"
            "  1:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/cache@v4\n"
            "  0x1:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/cache@<sha>\n")})
        self.assertEqual(code, 2, out)
        self.assertIn("error: .github/workflows/ci.yml: line 3: two keys of one mapping read as one value", out)

    def test_c2_a_tree_with_no_workflow_file_fails(self) -> None:
        for files in ({"README.md": "no .github folder\n"}, {".github/workflows/notes.txt": "no workflow\n"}):
            code, out = self.run_check(files)
            self.assertEqual(code, 2, out)
            self.assertIn("error: no workflow file in ", out)

    def test_a_missing_local_action_or_workflow_fails(self) -> None:
        code, out = self.run_check({".github/workflows/ci.yml": (
            workflow("- uses: ./ci/missing") + "  call:\n    uses: ./.github/workflows/missing.yml\n")})
        self.assertEqual(code, 2, out)
        self.assert_line(out, "error: .github/workflows/ci.yml: jobs.build.steps[0]: ./ci/missing"
                              " does not name a folder with an action.yml or action.yaml")
        self.assert_line(out, "error: .github/workflows/ci.yml: jobs.call: ./.github/workflows/missing.yml"
                              " does not name a workflow file")

    def test_the_command_exits_with_the_code_of_the_check(self) -> None:
        trees = (
            (0, {".github/workflows/ci.yml": workflow("- uses: actions/cache@<sha>")}),
            (1, {".github/workflows/ci.yml": workflow("- uses: actions/cache@v4")}),
            (2, {"README.md": "no .github folder\n"}),
        )
        for want, files in trees:
            with tempfile.TemporaryDirectory() as top:
                write_tree(top, files)
                done = subprocess.run([sys.executable, os.path.abspath(__file__), top],
                                      capture_output=True, text=True, timeout=60, check=False)
            self.assertEqual(done.returncode, want, done.stdout + done.stderr)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
