"""Fails when a workflow or an action names another repository's action or
reusable workflow by anything other than a full 40-character commit SHA:

    devtools/check-actions-pinned [repository root]
    devtools/check-actions-pinned --selftest

The repository root defaults to the current directory. The check parses with
PyYAML each workflow file in .github/workflows and each action.yml or
action.yaml under the root, except under .git. It opens symlinked files
through the link. It reads the `uses` value of each job (a reusable
workflow), of each step of a job and of each step of a composite action
(runs.steps). A value from another repository passes only as
owner/repo[/path]@<40 lowercase hex characters>. By convention the version
goes in a trailing comment, which YAML does not read. The check skips
docker:// images. It follows a local reference (./path) to the workflow file
that the path names, or to the action.yml or action.yaml in that folder.
That file must exist.

YAML 1.2 does not allow a repeated key in a mapping, and GitHub Actions does
not read the merge key (<<) of YAML 1.1. PyYAML accepts both, so the check
refuses both as parse errors.

PyYAML follows YAML 1.1, which reads `yes`, `no`, `on` and `off` as booleans.
GitHub reads only the YAML 1.2 core booleans (true, True, TRUE, false, False,
FALSE). The check reads booleans as GitHub does, so job ids such as `yes` and
`on` stay two jobs. It also refuses a mapping whose keys read as fewer values
than the mapping has keys, for example the job ids `1` and `0x1`, so that no
job that GitHub runs can drop out of the check.

Exit code 0: every reference is pinned.
Exit code 1: a reference is not pinned. The check lists each one with its
file, job and step.
Exit code 2: the check did not complete, for one of these causes:
  - no workflow file
  - a file that cannot be read or parsed, or that has the wrong shape
  - a missing local file
  - any other error

--selftest runs the cases of SelfTest, each on a temporary tree.
"""
import os
import re
import subprocess
import sys
import tempfile
import traceback
import unittest

try:
    import yaml
except ImportError as e:
    print(f"error: {e}. The Actions pinned workflow installs PyYAML==6.0.3.", file=sys.stderr)
    sys.exit(2)

# owner/repo[/path]@<40-character commit SHA>. Unlike a tag or a branch, a
# commit SHA always names the same code.
PINNED = re.compile(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(/[^@\s]+)?@[0-9a-f]{40}", re.ASCII)
ACTION_FILES = ("action.yml", "action.yaml")
MERGE_TAG = "tag:yaml.org,2002:merge"
BOOL_TAG = "tag:yaml.org,2002:bool"


class CheckError(Exception):
    """A file that the check cannot read, parse or follow."""


class Loader(yaml.SafeLoader):
    """PyYAML's safe loader, with the YAML 1.2 core booleans that GitHub reads.
    It refuses a mapping whose keys read as fewer values than it has keys."""

    def construct_mapping(self, node, deep=False):
        value = super().construct_mapping(node, deep=deep)
        if len(value) < len(node.value):
            raise CheckError(f"line {node.start_mark.line + 1}: two keys of one mapping read as one value")
        return value


Loader.yaml_implicit_resolvers = {
    first: [(tag, regexp) for tag, regexp in resolvers if tag != BOOL_TAG]
    for first, resolvers in yaml.SafeLoader.yaml_implicit_resolvers.items()
}
Loader.add_implicit_resolver(BOOL_TAG, re.compile(r"^(?:true|True|TRUE|false|False|FALSE)$"), list("tTfF"))


def refuse_repeated_and_merge_keys(node: yaml.Node, seen: set[int]) -> None:
    """Raise CheckError at a repeated key or a merge key anywhere under node.
    An alias is the node of its anchor, so `seen` stops a loop."""
    if id(node) in seen:
        return
    seen.add(id(node))
    if isinstance(node, yaml.MappingNode):
        keys = set()
        for key, value in node.value:
            line = key.start_mark.line + 1
            if key.tag == MERGE_TAG:
                raise CheckError(f"line {line}: a merge key (<<)")
            if isinstance(key, yaml.ScalarNode):
                if (key.tag, key.value) in keys:
                    raise CheckError(f"line {line}: a repeated key {key.value!r}")
                keys.add((key.tag, key.value))
            refuse_repeated_and_merge_keys(key, seen)
            refuse_repeated_and_merge_keys(value, seen)
    elif isinstance(node, yaml.SequenceNode):
        for item in node.value:
            refuse_repeated_and_merge_keys(item, seen)


def load(path: str):
    """The document in the file at path, as Loader reads it."""
    try:
        with open(path, "rb") as f:
            loader = Loader(f)
            try:
                node = loader.get_single_node()
                if node is None:
                    return None
                refuse_repeated_and_merge_keys(node, set())
                return loader.construct_document(node)
            finally:
                loader.dispose()
    except (OSError, yaml.YAMLError) as e:
        raise CheckError(" ".join(str(e).split())) from e


def mapping(value, where: str) -> dict:
    """value, which must be a mapping."""
    if not isinstance(value, dict):
        raise CheckError(f"{where} is not a mapping")
    return value


def step_references(parent: dict, where: str):
    """(location, uses value, False) for each step under parent that has a
    uses key."""
    steps = parent.get("steps", [])
    if not isinstance(steps, list):
        raise CheckError(f"{where}.steps is not a list")
    for i, step in enumerate(steps):
        step = mapping(step, f"{where}.steps[{i}]")
        if "uses" in step:
            label = step.get("name") or step.get("id")
            yield f"{where}.steps[{i}]" + (f" ({label})" if label else ""), step["uses"], False


def references(doc, kind: str):
    """(location, uses value, whether a job holds it) for each reference in a
    workflow or an action document."""
    doc = mapping(doc, "the document")
    if kind == "action":
        yield from step_references(mapping(doc.get("runs"), "runs"), "runs")
        return
    for job_id, job in mapping(doc.get("jobs"), "jobs").items():
        job = mapping(job, f"jobs.{job_id}")
        if "uses" in job:
            yield f"jobs.{job_id}", job["uses"], True
        yield from step_references(job, f"jobs.{job_id}")


def local_files(value: str, is_job: bool) -> list[tuple[str, str]]:
    """The (kind, path) of each file that a local reference can name. A job
    names a workflow file. A step names a folder with an action.yml or
    action.yaml."""
    if is_job:
        return [("workflow", os.path.normpath(value))]
    return [("action", os.path.normpath(os.path.join(value, name))) for name in ACTION_FILES]


def check(root: str) -> tuple[int, list[str]]:
    """Check the tree at root. Return the exit code and the lines to print."""
    errors, unpinned, counts = [], [], {"workflow": 0, "action": 0}
    workflows = os.path.join(root, ".github", "workflows")
    try:
        names = sorted(os.listdir(workflows))
    except (FileNotFoundError, NotADirectoryError):
        names = []
    queue = [
        ("workflow", os.path.join(".github", "workflows", n)) for n in names if n.lower().endswith((".yml", ".yaml"))
    ]
    if not queue:
        errors.append(f"error: no workflow file in {workflows}")

    def walk_error(e: OSError) -> None:
        errors.append(f"error: cannot list {e.filename}: {e.strerror}")

    for top, dirs, files in os.walk(root, onerror=walk_error):
        dirs[:] = sorted(d for d in dirs if d != ".git")
        queue += [("action", os.path.relpath(os.path.join(top, n), root)) for n in sorted(files) if n in ACTION_FILES]

    done = set()
    while queue:
        kind, path = queue.pop(0)
        full = os.path.join(root, path)
        if (kind, os.path.realpath(full)) in done:
            continue
        done.add((kind, os.path.realpath(full)))
        counts[kind] += 1
        try:
            for where, value, is_job in references(load(full), kind):
                if not isinstance(value, str):
                    errors.append(f"error: {path}: {where}: uses is not a string: {value!r}")
                elif value.startswith("./"):
                    found = [(k, p) for k, p in local_files(value, is_job) if os.path.isfile(os.path.join(root, p))]
                    if not found:
                        wanted = "a workflow file" if is_job else "a folder with an action.yml or action.yaml"
                        errors.append(f"error: {path}: {where}: {value} does not name {wanted}")
                    queue += found
                elif not value.startswith("docker://") and not PINNED.fullmatch(value):
                    unpinned.append(f"{path}: {where}: {value if value.isprintable() else repr(value)}")
        except CheckError as e:
            errors.append(f"error: {path}: {e}")

    lines = (["These action references are not pinned to a full commit SHA:"] + unpinned) if unpinned else []
    lines += errors
    lines.append(f"Files checked: {counts['workflow']} workflow, {counts['action']} action.")
    if not (errors or unpinned):
        lines.append("Every reference to another repository is pinned to a commit SHA.")
    return (2 if errors else 1 if unpinned else 0), lines


def main(argv: list[str]) -> int:
    if argv[1:] == ["--selftest"]:
        suite = unittest.defaultTestLoader.loadTestsFromTestCase(SelfTest)
        return 0 if unittest.TextTestRunner(verbosity=2).run(suite).wasSuccessful() else 1
    if len(argv) > 2 or (len(argv) == 2 and argv[1].startswith("-")):
        print(__doc__, file=sys.stderr)
        return 2
    try:
        code, lines = check(argv[1] if len(argv) == 2 else ".")
    except Exception:  # an error the check did not foresee fails it
        traceback.print_exc()
        return 2
    print("\n".join(lines))
    return code


