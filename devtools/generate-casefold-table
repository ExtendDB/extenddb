"""Generate crates/auth/src/policy/casefold.rs from Python's str.casefold.

Python's str.casefold implements Unicode full case folding (the Case Folding
data's C + F mappings), which is what the live service applies to condition key
names and tag keys on the DynamoDB request path. The table maps every code point
whose fold differs from itself to its folded form; a code point absent from the
table folds to itself (so the dotless i U+0131 and the dotted I U+0130, which do
not fold to plain ASCII i, are handled correctly).

The Unicode version is whatever the running Python's unicodedata reports; it is
recorded in the generated file header. Run from the repository root:

    devtools/generate-casefold-table > crates/auth/src/policy/casefold.rs

No Unicode data file is vendored; the data comes from the Python standard
library.
"""
import subprocess
import sys
import unicodedata

OUT_PATH = "crates/auth/src/policy/casefold.rs"


def entries():
    for c in range(0x110000):
        ch = chr(c)
        f = ch.casefold()
        if f != ch:
            yield c, f


def esc(folded):
    return "".join("\\u{%x}" % ord(x) for x in folded)


def main():
    uni = unicodedata.unidata_version
    rows = list(entries())
    out = []
    w = out.append
    w("// Copyright 2026 ExtendDB contributors")
    w("// SPDX-License-Identifier: Apache-2.0")
    w("")
    w("//! Unicode full case folding (the Case Folding data's full `C` + `F`")
    w("//! mappings). The live service resolves a condition key name and a tag key")
    w("//! on the `DynamoDB` request path under full case folding, so a name spelled")
    w("//! with a non-ASCII letter that folds to a resolvable key (long s to s, the")
    w("//! st ligature to st, sharp s to ss) is matched. The dotless i (U+0131) and")
    w("//! the dotted I (U+0130) do not fold to a plain ASCII `i` and so read as")
    w("//! absent, matching the service.")
    w("//!")
    w(f"//! Unicode version: {uni}. Generated by `devtools/generate-casefold-table`")
    w("//! from Python's `str.casefold`; do not edit by hand. Regenerate with")
    w("//! `devtools/generate-casefold-table > crates/auth/src/policy/casefold.rs`.")
    w("")
    w("/// Code point to its full case fold. Code points not listed fold to")
    w("/// themselves. Sorted by code point for binary search.")
    w("pub(crate) static CASE_FOLD: &[(u32, &str)] = &[")
    for c, f in rows:
        w('    (0x%X, "%s"),' % (c, esc(f)))
    w("];")
    w("")
    w("/// Fold a string under Unicode full case folding, matching the service's")
    w("/// resolution of condition key names and tag keys. ASCII letters fold to")
    w("/// ASCII lowercase; a non-ASCII code point folds per [`CASE_FOLD`] or to")
    w("/// itself.")
    w("#[must_use]")
    w("pub fn case_fold(s: &str) -> String {")
    w("    // Fast path: an all-ASCII key (the overwhelmingly common case) folds")
    w("    // to its ASCII lowercase without touching the table, since every ASCII")
    w("    // letter's fold is its ASCII lowercase.")
    w("    if s.is_ascii() {")
    w("        return s.to_ascii_lowercase();")
    w("    }")
    w("    let mut out = String::with_capacity(s.len());")
    w("    for c in s.chars() {")
    w("        let cp = c as u32;")
    w("        match CASE_FOLD.binary_search_by(|&(k, _)| k.cmp(&cp)) {")
    w("            Ok(i) => out.push_str(CASE_FOLD[i].1),")
    w("            Err(_) => out.push(c),")
    w("        }")
    w("    }")
    w("    out")
    w("}")
    w("")
    w("/// Whether two strings are equal under Unicode full case folding.")
    w("#[must_use]")
    w("pub fn eq_fold(a: &str, b: &str) -> bool {")
    w("    case_fold(a) == case_fold(b)")
    w("}")
    w("")
    w("#[cfg(test)]")
    w("mod tests {")
    w("    use super::*;")
    w("")
    w("    #[test]")
    w("    fn table_sorted_and_unique() {")
    w("        for w in CASE_FOLD.windows(2) {")
    w("            assert!(w[0].0 < w[1].0, \"table must be sorted and unique by code point\");")
    w("        }")
    w("    }")
    w("")
    w("    #[test]")
    w("    fn spot_checks() {")
    w("        // Single-character folds.")
    w("        assert_eq!(case_fold(\"\\u{017f}\"), \"s\"); // long s")
    w("        assert_eq!(case_fold(\"\\u{212a}\"), \"k\"); // Kelvin sign")
    w("        assert_eq!(case_fold(\"A\"), \"a\");")
    w("        // Multi-character expansions.")
    w("        assert_eq!(case_fold(\"\\u{00df}\"), \"ss\"); // sharp s")
    w("        assert_eq!(case_fold(\"\\u{1e9e}\"), \"ss\"); // capital sharp s")
    w("        assert_eq!(case_fold(\"\\u{fb05}\"), \"st\"); // st ligature")
    w("        // Greek final sigma folds to the same as sigma.")
    w("        assert_eq!(case_fold(\"\\u{03c2}\"), case_fold(\"\\u{03c3}\"));")
    w("        assert_eq!(case_fold(\"\\u{03a3}\"), case_fold(\"\\u{03c3}\"));")
    w("        // Cherokee folds to another Cherokee code point (a non-ASCII target).")
    w("        assert_eq!(case_fold(\"\\u{13f8}\"), \"\\u{13f0}\");")
    w("        // Code points that must be absent from the table (fold to self).")
    w("        assert_eq!(case_fold(\"\\u{0131}\"), \"\\u{0131}\"); // dotless i")
    w("        // Dotted I folds to 'i' plus a combining dot, not plain 'i'.")
    w("        assert_eq!(case_fold(\"\\u{0130}\"), \"i\\u{0307}\");")
    w("    }")
    w("")
    w("    #[test]")
    w("    fn ascii_fast_path_matches_table() {")
    w("        // The ASCII fast path must agree with a per-code-point table fold")
    w("        // on every ASCII string.")
    w("        for s in [\"\", \"AWS:SecureTransport\", \"dynamodb:LeadingKeys\",")
    w("                  \"aws:PrincipalTag/Team\", \"MiXeD123_.-/\", \"abc\"] {")
    w("            let table: String = s.chars().map(|c| {")
    w("                let cp = c as u32;")
    w("                match CASE_FOLD.binary_search_by(|&(k, _)| k.cmp(&cp)) {")
    w("                    Ok(i) => CASE_FOLD[i].1.to_owned(),")
    w("                    Err(_) => c.to_string(),")
    w("                }")
    w("            }).collect();")
    w("            assert_eq!(case_fold(s), table, \"fast path diverged on {s:?}\");")
    w("            assert_eq!(case_fold(s), s.to_ascii_lowercase());")
    w("        }")
    w("    }")
    w("}")
    w("")
    source = "\n".join(out)
    # Format through rustfmt so the generated file is rustfmt-clean and
    # regeneration is idempotent with `cargo fmt --check`.
    try:
        r = subprocess.run(
            ["rustfmt", "--edition", "2024", "--emit", "stdout"],
            input=source, capture_output=True, text=True, check=True,
        )
        source = r.stdout
    except (FileNotFoundError, subprocess.CalledProcessError):
        pass
    sys.stdout.write(source)


if __name__ == "__main__":
    main()
