def environment_problems(sources: list[tuple[str, dict]]) -> list[Finding]:
    """A finding for each variable of COMPILER_VARIABLES that a source (a label
    and a mapping) sets: each makes cargo run another program as the compiler,
    which can change its options for one crate."""
    found = []
    for label, env in sources:
        found.append(Finding("examined", label, f"examined {label}"))
        for name in COMPILER_VARIABLES:
            if name in env:
                found.append(
                    Finding(
                        "environment",
                        label,
                        f"{label} sets {name}={env[name]!r}, which makes cargo run another program"
                        " as the compiler; the guard cannot vouch for the options it passes",
                    )
                )
    return found


def cargo_config_files(copy: Path) -> list[Path]:
    """The cargo configuration files a cargo run in `copy` reads: .cargo/config.toml
    and .cargo/config in it and in each directory above it, and config.toml and
    config in CARGO_HOME (~/.cargo when that is unset)."""
    home = Path(os.environ.get("CARGO_HOME") or Path.home() / ".cargo")
    files = [d / ".cargo" / n for d in (copy, *copy.parents) for n in ("config.toml", "config")]
    return list(dict.fromkeys(files + [home / "config.toml", home / "config"]))


def cargo_config_problems(sources: list[tuple[str, list[Path]]]) -> list[Finding]:
    """A finding for each file of a source (a label and files) whose [build]
    table sets one of COMPILER_KEYS, and for each that cannot be read."""
    found = []
    for label, paths in sources:
        found.append(Finding("examined", label, f"examined {label}"))
        for path in paths:
            if not path.is_file():
                continue
            try:
                build = tomllib.loads(path.read_text(encoding="utf-8")).get("build", {})
            except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
                found.append(Finding("cargo configuration", str(path), f"{path}: {error}"))
                continue
            for key in COMPILER_KEYS:
                if isinstance(build, dict) and key in build:
                    found.append(
                        Finding(
                            "cargo configuration",
                            str(path),
                            f"{path}: build.{key} = {build[key]!r} makes cargo run another program"
                            " as the compiler; the guard cannot vouch for the options it passes",
                        )
                    )
    return found


# ---------------------------------------------------------------- zeroize features

# The crates of the wasm32 AES-256-GCM stack. Each wipes its own key material
# only under its own `zeroize` feature, which CORE_MANIFEST turns on for each.
ZEROIZE_CRATES = ("aes", "aes-gcm", "ghash", "polyval")
CORE_MANIFEST = "crates/core/Cargo.toml"


def adapter_graph(tree: Path) -> tuple[list[str], list[Finding]]:
    """The packages of the adapter's wasm32 build as `cargo tree -e normal`
    resolves them in the tree at `tree` (the adapter and its normal
    dependencies on that target, with the features its build compiles), one
    `package|features` line each. A package is written as cargo tree's {p}
    writes it: its name and version, then its source when it is not from
    crates.io, and `(proc-macro)` for a procedural macro."""
    command = ["cargo", "tree", "--color", "never", "--locked", "-p", ADAPTER]
    command += ["--target", TARGET, "-e", "normal", "--prefix", "none", "--format", "{p}|{f}"]
    try:
        run = subprocess.run(command, cwd=tree, capture_output=True, text=True, check=False)
    except FileNotFoundError:
        sys.exit("error: cargo is not on PATH")
    if run.returncode != 0:
        return [], [Finding("zeroize", str(tree), f"{' '.join(command)} failed:\n{run.stderr}")]
    return [line.removesuffix(" (*)") for line in run.stdout.splitlines()], []


def zeroize_problems(label: str, graph: list[str], crates: tuple = ZEROIZE_CRATES) -> list[Finding]:
    """Findings of `crates` in `graph` (adapter_graph's lines): a crate that is
    missing, that is there as more than one package (another version, or the
    same version from another source), or whose package has its `zeroize`
    feature off."""
    packages = {}
    for line in graph:
        package, _, features = line.partition("|")
        name = package.partition(" ")[0]
        if name in crates:
            packages.setdefault(name, {})[package] = set(features.split(","))
    found = [Finding("examined", label, f"examined {label}")]
    for crate in crates:
        where = f"{label}: {crate}"
        present = packages.get(crate, {})
        if not present:
            text = f"is not in the build; update ZEROIZE_CRATES and {CORE_MANIFEST} together"
        elif len(present) > 1:
            text = (
                f"is in the build as {len(present)} packages ({', '.join(present)});"
                f" {CORE_MANIFEST} turns the zeroize feature on only in the package its entry"
                " resolves to, which must be the one aes-gcm's stack uses"
            )
        elif "zeroize" not in next(iter(present.values())):
            text = (
                f"is built without its zeroize feature ({next(iter(present))}), so it leaves"
                f" key material in memory; {CORE_MANIFEST} turns it on for wasm32"
            )
        else:
            continue
        found.append(Finding("zeroize", where, f"{where} {text}"))
    return found


def zeroize_check(copy: Path) -> tuple[list[Finding], list[str]]:
    """zeroize_problems, in one loop, of the adapter's wasm32 build in the copy
    at `copy` and, for ghash, of two controls made from the build's ghash line
    and checked alone: that line without its zeroize feature, and that line
    beside a second package at its version from another source. Returns the
    findings and the build's line of each crate."""
    graph, found = adapter_graph(copy)
    ghash = [line.partition("|") for line in graph if line.startswith("ghash ")][:1]
    without = [f"{p}|{','.join(f for f in fs.split(',') if f != 'zeroize')}" for p, _, fs in ghash]
    second = [f"{p}{source}|{fs}" for p, _, fs in ghash for source in ("", " (/control)")]
    for label, lines, crates in (
        ("the adapter's wasm32 build", graph, ZEROIZE_CRATES),
        ("control: ghash without its zeroize feature", without, ("ghash",)),
        ("control: a second ghash", second, ("ghash",)),
    ):
        found += zeroize_problems(label, lines, crates)
    stack = dict.fromkeys(line for line in graph if line.partition(" ")[0] in ZEROIZE_CRATES)
    return found, list(stack)


