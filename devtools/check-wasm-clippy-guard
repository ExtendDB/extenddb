def setting_probe_problems() -> tuple[list[str], str]:
    """Problems with SETTING_PROBES: a probe the scan does not refuse, or one it
    refuses that it must accept."""
    problems = []
    for index, (kind, text, refuse) in enumerate(SETTING_PROBES):
        if kind == "source":
            found, _ = attribute_problems("crates/probe/src/lib.rs", text, set())
        elif kind == "lints":
            manifest = tomllib.loads(text)
            table = manifest.get("lints") or manifest.get("workspace", {}).get("lints", {})
            found = lint_table_problems("crates/probe/Cargo.toml", table)
        elif kind == "config":
            found = rustflags_problems(".cargo/config.toml", tomllib.loads(text))
        else:
            found = workflow_problems(WORKFLOW_REL, text)
        if refuse and not found:
            problems.append(f"lint-setting probe {index} ({kind}) was not refused: {text!r}")
        elif found and not refuse:
            problems.append(
                f"lint-setting probe {index} ({kind}) was refused, which the scan must"
                f" accept: {text!r}: {found}"
            )
    refused = sum(1 for _, _, refuse in SETTING_PROBES if refuse)
    summary = (
        f"lint-setting probes: {len(SETTING_PROBES) - len(problems)} of {len(SETTING_PROBES)}"
        f" read as expected ({refused} to refuse, {len(SETTING_PROBES) - refused} to accept)"
    )
    return problems, summary


# cargo clippy passes the arguments after `--` to clippy-driver in the variable
# CLIPPY_ARGS, each followed by this separator (clippy 0.1.97); rustc records
# the variable in the dep-info, as `-D__CLIPPY_HACKERY__warnings__CLIPPY_HACKERY__`
# for the clippy step.
CLIPPY_ARGS_SEPARATOR = "__CLIPPY_HACKERY__"


def _driver_env(args: list[str] | None, conf_dir: str | None = str(CONF_DIR)) -> dict:
    """The variables a crate's dep-info records for a clippy-driver run with
    `args` after `--` and CLIPPY_CONF_DIR `conf_dir` (None: not recorded)."""
    env = {} if conf_dir is None else {"CLIPPY_CONF_DIR": conf_dir}
    if args is not None:
        env["CLIPPY_ARGS"] = "".join(arg + CLIPPY_ARGS_SEPARATOR for arg in args)
    return env


def _report(level: str, lint: str) -> dict:
    """A compiler message of `lint` at `level`, in the shape of cargo's JSON."""
    return {
        "level": level,
        "code": {"code": lint, "explanation": None},
        "message": f"a report of {lint}",
        "rendered": f"{level}: a report of {lint}",
        "spans": [{"file_name": "crates/probe/src/lib.rs", "line_start": 1, "is_primary": True}],
    }


