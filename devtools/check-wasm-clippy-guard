def read_config() -> tuple[dict[str, list[str]], list[str]]:
    """The entry paths of each list in clippy.toml, and the problems found."""
    problems = []
    try:
        config = tomllib.loads(CONFIG.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as error:
        return {}, [f"{CONFIG_REL}: cannot be read: {error}"]
    paths = {}
    for key, value in config.items():
        if key not in KINDS:
            problems.append(
                f"{CONFIG_REL}: unexpected key {key!r}; this script checks only {sorted(KINDS)}"
            )
            continue
        if not isinstance(value, list):
            problems.append(f"{CONFIG_REL}: {key} is not a list")
            continue
        paths[key] = []
        for entry in value:
            if (
                not isinstance(entry, dict)
                or set(entry) != {"path", "reason"}
                or not all(isinstance(entry[k], str) and entry[k].strip() for k in entry)
            ):
                problems.append(
                    f"{CONFIG_REL}: {key} entry {entry!r} is not a table of exactly a"
                    " non-empty `path` and `reason`"
                )
                continue
            paths[key].append(entry["path"])
    for key, (kind, probes) in KINDS.items():
        listed = paths.get(key, [])
        if len(listed) != len(set(listed)):
            problems.append(f"{CONFIG_REL}: {key} lists a path more than once")
        for path in listed:
            if path not in probes:
                problems.append(f"{path}: listed in {key} but has no {kind} probe in this script")
        for path in probes:
            if path not in listed:
                problems.append(f"{path}: has a {kind} probe but is not listed in {key}")
    return paths, problems


def cargo_metadata() -> dict:
    try:
        run = subprocess.run(
            ["cargo", "metadata", "--format-version", "1", "--locked", "--filter-platform", TARGET],
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        sys.exit("error: cargo is not on PATH")
    if run.returncode != 0:
        sys.exit(f"error: cargo metadata failed:\n{run.stderr}")
    return json.loads(run.stdout)


def wasm_crates(metadata: dict) -> dict[str, dict]:
    """The workspace packages the adapter's wasm32 build compiles, by name."""
    members = set(metadata["workspace_members"])
    packages = {p["id"]: p for p in metadata["packages"]}
    nodes = {n["id"]: n for n in metadata["resolve"]["nodes"]}
    start = [i for i in members if packages[i]["name"] == ADAPTER]
    if not start:
        sys.exit(f"error: cargo metadata lists no workspace member named {ADAPTER}")
    seen, todo = set(), start
    while todo:
        package = todo.pop()
        if package in seen:
            continue
        seen.add(package)
        # --filter-platform already dropped dependencies of other targets;
        # kind None is a normal dependency.
        todo += [
            d["pkg"]
            for d in nodes[package]["deps"]
            if any(k["kind"] is None for k in d["dep_kinds"])
        ]
    return {packages[i]["name"]: packages[i] | {"node": nodes[i]} for i in seen if i in members}


# ---------------------------------------------------------------- lint settings

_SCAN = re.compile(r'//|/\*|(?<!\w)(?:b|c)?r#*"|(?<!\w)(?:b|c)?"|\'')
_CHAR = re.compile(r"'(?:\\(?:u\{[0-9A-Fa-f]{1,6}\}|x[0-9A-Fa-f]{2}|.)|[^\\'\n])'")


def code_only(text: str) -> str:
    """`text` with comments and the contents of string and character literals
    blanked (line breaks kept), so offsets and line numbers still match."""
    out = []
    i = 0
    n = len(text)

    def blank(a: int, b: int) -> None:
        out.append(re.sub(r"[^\n]", " ", text[a:b]))

    while True:
        match = _SCAN.search(text, i)
        if not match:
            out.append(text[i:])
            break
        start = match.start()
        out.append(text[i:start])
        token = match.group()
        if token == "//":
            end = text.find("\n", start)
            end = n if end < 0 else end
            blank(start, end)
        elif token == "/*":
            depth, end = 1, start + 2
            while end < n and depth:
                if text.startswith("/*", end):
                    depth, end = depth + 1, end + 2
                elif text.startswith("*/", end):
                    depth, end = depth - 1, end + 2
                else:
                    end += 1
            blank(start, end)
        elif token == "'":
            char = _CHAR.match(text, start)
            end = char.end() if char else start + 1  # a lifetime or a label
            out.append(text[start] + re.sub(r"[^\n]", " ", text[start + 1 : end - 1]))
            if char:
                out.append("'")
        elif token.endswith('"') and "r" in token:
            hashes = token.count("#")
            close = text.find('"' + "#" * hashes, match.end())
            close = n if close < 0 else close
            end = min(n, close + 1 + hashes)
            out.append(token)
            blank(match.end(), close)
            out.append(text[close:end])
        else:
            end = match.end()
            while end < n and text[end] != '"':
                end += 2 if text[end] == "\\" else 1
            out.append(token)
            blank(match.end(), end)
            out.append(text[end : end + 1])
            end += 1
        i = end
    return "".join(out)


def _closing(code: str, start: int, opening: str, closing: str) -> int:
    """The index just past the bracket that closes the one at `start`."""
    depth = 0
    for index in range(start, len(code)):
        if code[index] == opening:
            depth += 1
        elif code[index] == closing:
            depth -= 1
            if depth == 0:
                return index + 1
    return len(code)


_ATTRIBUTE = re.compile(r"#\s*!?\s*\[")
_LINT_LIST = re.compile(r"\b(allow|expect)\s*\(")
_NEXT_ATTRIBUTE = re.compile(r"\s*#\s*\[")
_MOD = re.compile(r"\s*(?:pub\s*(?:\([^)]*\))?\s*)?mod\s+([A-Za-z_][A-Za-z0-9_]*)\s*;")


def attribute_problems(rel: str, text: str, used_migration: set) -> tuple[list[str], int]:
    """Problems in the lint attributes of one file, and how many of its
    attributes allow a disallowed lint with a reason. `used_migration` collects
    the migration code-body modules whose allow of clippy::all is accepted."""
    code = code_only(text)
    problems, reasoned = [], 0
    for attribute in _ATTRIBUTE.finditer(code):
        end = _closing(code, attribute.end() - 1, "[", "]")
        body = code[attribute.start() : end]
        line = code.count("\n", 0, attribute.start()) + 1
        for lint_list in _LINT_LIST.finditer(body):
            close = _closing(body, lint_list.end() - 1, "(", ")")
            # The items of the list, as (start, end) offsets into `code`.
            items, depth, start = [], 0, lint_list.end()
            for index in range(lint_list.end(), close - 1):
                if body[index] in "([{":
                    depth += 1
                elif body[index] in ")]}":
                    depth -= 1
                elif body[index] == "," and depth == 0:
                    items.append((attribute.start() + start, attribute.start() + index))
                    start = index + 1
            items.append((attribute.start() + start, attribute.start() + close - 1))
            names = {re.sub(r"\s", "", code[a:b]) for a, b in items} - {""}
            reasons = [reason_value(text, code, a, b) for a, b in items]
            reasons = [r for r in reasons if r is not None]
            has_reason = any(r.strip() for r in reasons)
            level = lint_list.group(1)
            blanket = sorted(names & BLANKET)
            if blanket:
                declared = _declared_module(code, end)
                if is_migration_module(rel, code, attribute.start(), declared, level, names):
                    used_migration.add((rel, declared))
                else:
                    problems.append(
                        f"{rel}:{line}: {level}({', '.join(blanket)}) switches the wasm clippy"
                        " guard off; allow only the lints the code needs (only a catalog"
                        " migration's code-body module, declared as CONTRIBUTING.md"
                        " prescribes, may allow clippy::all)"
                    )
            never = sorted(names & NEVER)
            if never:
                problems.append(
                    f"{rel}:{line}: {level}({', '.join(never)}) switches off the lint that"
                    " reports a std lock guard or a RefCell borrow held across an .await,"
                    " which traps on wasm32 when another task takes it; hold none across an"
                    " .await (no reason makes this setting acceptable)"
                )
            unreasoned = sorted(names & NEED_REASON)
            if unreasoned and not has_reason:
                empty = " is empty or only whitespace" if reasons else " is missing"
                problems.append(
                    f"{rel}:{line}: {level}({', '.join(unreasoned)}): its `reason = \"...\"`"
                    f"{empty}; it must name the callers and why none runs on wasm"
                )
            elif unreasoned:
                reasoned += 1
    return problems, reasoned


_REASON = re.compile(r'\s*reason\s*=\s*(?:(r)(#*))?"')
_ESCAPE = re.compile(r"\\(?:x([0-9A-Fa-f]{2})|u\{([0-9A-Fa-f_]{1,8})\}|\n[ \t\r\n]*|(.))", re.S)
_SIMPLE_ESCAPES = {"n": "\n", "r": "\r", "t": "\t", "\\": "\\", "0": "\0", "'": "'", '"': '"'}


def reason_value(text: str, code: str, start: int, end: int) -> str | None:
    """The text of the string literal in a `reason = "..."` item of a lint list,
    the item being code[start:end], or None when the item is not one. `code` is
    `text` with comments and literal contents blanked, so the literal's quotes
    are found in `code` and its contents read from `text`; escapes are decoded,
    a raw string's contents are taken as written."""
    match = _REASON.match(code, start, end)
    if not match:
        return None
    raw, hashes = match.group(1), match.group(2) or ""
    close = code.find('"' + hashes if raw else '"', match.end(), end)
    if close < 0:
        return None
    contents = text[match.end() : close]
    return contents if raw else _ESCAPE.sub(_unescape, contents)


def _unescape(escape: re.Match) -> str:
    """The character one escape of a Rust string literal stands for; a line
    continuation (a backslash at the end of a line, and the next line's
    indentation) stands for nothing."""
    hex_byte, code_point, simple = escape.groups()
    try:
        if hex_byte:
            return chr(int(hex_byte, 16))
        if code_point:
            return chr(int(code_point.replace("_", ""), 16))
    except ValueError:  # not a character; rustc refuses the literal
        return escape.group()
    if simple is not None:
        return _SIMPLE_ESCAPES.get(simple, escape.group())
    return ""


def is_migration_module(
    rel: str, code: str, start: int, declared: str | None, level: str, names: set
) -> bool:
    """Whether the attribute at `start` is the allow CONTRIBUTING.md prescribes
    for a catalog migration's code-body module: `allow(clippy::all,
    deprecated)` and nothing else, on a `mod mNNNN_<name>;` line of a
    src/migrations/mod.rs that also carries #[rustfmt::skip], with the module's
    file beside it."""
    if level != "allow" or names != MIGRATION_ALLOW or declared is None:
        return False
    path = Path(rel)
    if path.name != "mod.rs" or path.parent.name != "migrations" or path.parent.parent.name != "src":
        return False
    if not MIGRATION_MODULE.fullmatch(declared):
        return False
    if not (ROOT / path.parent / f"{declared}.rs").is_file():
        return False
    # The attributes of the item: from the end of the previous item (or the
    # start of the file) to the `mod` keyword.
    item_start = max(code.rfind(";", 0, start), code.rfind("}", 0, start)) + 1
    mod_at = code.find("mod", start)
    return re.search(r"#\s*\[\s*rustfmt\s*::\s*skip\s*\]", code[item_start:mod_at]) is not None


def _declared_module(code: str, index: int) -> str | None:
    """The module a `mod name;` item after more attributes at `index` declares."""
    while match := _NEXT_ATTRIBUTE.match(code, index):
        index = _closing(code, match.end() - 1, "[", "]")
    match = _MOD.match(code, index)
    return match.group(1) if match else None


def lint_table_problems(manifest: str, table: dict) -> list[str]:
    """Problems in one `[lints]` (or `[workspace.lints]`) table of `manifest`."""
    problems = []
    for tool, lints in table.items():
        if not isinstance(lints, dict):
            continue
        for name, setting in lints.items():
            level = setting.get("level") if isinstance(setting, dict) else setting
            lint = name if tool == "rust" else f"{tool}::{name}"
            if level in ("allow", "expect") and lint in BLANKET | NEED_REASON | NEVER:
                problems.append(
                    f"{manifest}: [lints] sets {lint} to {level!r},"
                    " which switches the wasm clippy guard off"
                )
    return problems


def rustflags_problems(config: str, settings: dict) -> list[str]:
    """Problems in the rustflags of one cargo configuration file `config`."""
    problems = []
    flag_lists = [settings.get("build", {}).get("rustflags")]
    flag_lists += [
        t.get("rustflags") for t in settings.get("target", {}).values() if isinstance(t, dict)
    ]
    for flags in flag_lists:
        if isinstance(flags, str):
            flags = flags.split()
        if any(re.match(r"(-A|--allow|--cap-lints)", str(flag)) for flag in flags or []):
            problems.append(
                f"{config}: rustflags {flags!r} allow lints or cap them, which can"
                " switch the wasm clippy guard off"
            )
    return problems


def manifest_problems(crates: dict[str, dict], metadata: dict) -> list[str]:
    problems = []
    root_manifest = Path(metadata["workspace_root"]) / "Cargo.toml"
    workspace = tomllib.loads(root_manifest.read_text(encoding="utf-8")).get("workspace", {})
    tables = [(root_manifest, workspace.get("lints", {}))]
    for package in crates.values():
        manifest = Path(package["manifest_path"])
        lints = tomllib.loads(manifest.read_text(encoding="utf-8")).get("lints", {})
        tables.append((manifest, lints))
    for manifest, table in tables:
        problems += lint_table_problems(str(manifest.relative_to(ROOT)), table)
    for name in ("config.toml", "config"):
        config = ROOT / ".cargo" / name
        if not config.is_file():
            continue
        settings = tomllib.loads(config.read_text(encoding="utf-8"))
        problems += rustflags_problems(f".cargo/{name}", settings)
    return problems


def lint_setting_problems(crates: dict[str, dict], metadata: dict) -> tuple[list[str], str]:
    problems, used_migration, reasoned, files = [], set(), 0, 0
    for name in sorted(crates):
        source = Path(crates[name]["manifest_path"]).parent / "src"
        for path in sorted(source.rglob("*.rs")):
            rel = path.relative_to(ROOT).as_posix()
            found, count = attribute_problems(rel, path.read_text(encoding="utf-8"), used_migration)
            problems += found
            reasoned += count
            files += 1
    problems += manifest_problems(crates, metadata)
    summary = (
        f"lint settings: {files} source files of {len(crates)} crates read;"
        f" {len(used_migration)} migration code-body modules allow clippy::all;"
        f" {reasoned} allows of a disallowed lint, each with a reason"
    )
    return problems, summary


# ---------------------------------------------------------------- setting probes

_FN = "\nfn f() {}\n"
_AFN = "\nasync fn f() {}\n"
_DM = "clippy::disallowed_methods"
_AHL = "clippy::await_holding_lock"

# Lint settings, each in one of the spellings the scan above reads, that it must
# refuse (True) or accept (False). A "source" probe is read as a source file of
# a crate the wasm build compiles, a "lints" probe as a manifest's [lints]
# table, a "config" probe as .cargo/config.toml, by the functions that read the
# crates' own files.
SETTING_PROBES = [
    ("source", "#[allow(clippy::all)]" + _FN, True),
    ("source", "#![allow(warnings)]\n", True),
    ("source", '#[cfg_attr(target_arch = "wasm32", allow(clippy::style))]' + _FN, True),
    ("source", f"#[allow({_DM})]" + _FN, True),
    ("source", "#[expect(clippy::disallowed_type)]" + _FN, True),
    ("source", f'#[allow({_DM}, reason = "only the server calls it")]' + _FN, False),
    ("source", f'#[allow({_DM}, reason = r#"only the server calls it"#)]' + _FN, False),
    ("source", f'#[allow({_DM}, reason = "")]' + _FN, True),
    ("source", f'#[allow({_DM}, reason = " \\t ")]' + _FN, True),
    ("source", f'#[allow({_DM}, reason = "\\n\\u{{20}}\\\n   ")]' + _FN, True),
    ("source", f'#[allow({_DM}, reason = r#""#)]' + _FN, True),
    ("source", "#[allow(clippy::await_holding_lock)]" + _AFN, True),
    ("source", f'#[allow({_AHL}, reason = "never reached on wasm")]' + _AFN, True),
    ("source", "#![expect(clippy::await_holding_refcell_ref)]\n", True),
    ("source", '#[cfg_attr(test, allow(dead_code, clippy::await_holding_lock))]' + _AFN, True),
    ("source", "#[allow(clippy::suspicious)]" + _AFN, True),
    ("source", "#[deny(clippy::await_holding_lock)]" + _AFN, False),
    ("source", "#[allow(dead_code)]" + _FN, False),
    ("source", '// #[allow(clippy::all)]\nconst S: &str = "#[allow(warnings)]";\n', False),
    ("lints", '[lints.clippy]\nall = "allow"\n', True),
    ("lints", '[lints.clippy]\nawait_holding_lock = "allow"\n', True),
    ("lints", '[lints.clippy]\nawait_holding_refcell_ref = { level = "expect" }\n', True),
    ("lints", '[lints.clippy]\nsuspicious = "allow"\n', True),
    ("lints", '[lints.clippy]\nawait_holding_lock = "deny"\n', False),
    ("config", f'[target.wasm32-unknown-unknown]\nrustflags = ["-A{_AHL}"]\n', True),
    ("config", '[build]\nrustflags = "--cap-lints warn"\n', True),
]


def setting_probe_problems() -> tuple[list[str], str]:
    """Problems with SETTING_PROBES: a probe the scan does not refuse, or one it
    refuses that it must accept."""
    problems = []
    for index, (kind, text, refuse) in enumerate(SETTING_PROBES):
        if kind == "source":
            found, _ = attribute_problems("crates/probe/src/lib.rs", text, set())
        elif kind == "lints":
            found = lint_table_problems("crates/probe/Cargo.toml", tomllib.loads(text)["lints"])
        else:
            found = rustflags_problems(".cargo/config.toml", tomllib.loads(text))
        if refuse and not found:
            problems.append(f"lint-setting probe {index} ({kind}) was not refused: {text!r}")
        elif found and not refuse:
            problems.append(
                f"lint-setting probe {index} ({kind}) was refused, which the scan must"
                f" accept: {text!r}: {found}"
            )
    refused = sum(1 for _, _, refuse in SETTING_PROBES if refuse)
    summary = (
        f"lint-setting probes: {len(SETTING_PROBES) - len(problems)} of {len(SETTING_PROBES)}"
        f" read as expected ({refused} to refuse, {len(SETTING_PROBES) - refused} to accept)"
    )
    return problems, summary


# ---------------------------------------------------------------- probe run


def copy_tree(destination: Path) -> int:
    """Copy the files git tracks or does not ignore, as they are now."""
    try:
        listing = subprocess.run(
            ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
            cwd=ROOT,
            capture_output=True,
            check=False,
        )
    except FileNotFoundError:
        sys.exit("error: git is not on PATH; the probes run in a copy of the files git lists")
    if listing.returncode != 0:
        sys.exit(f"error: git ls-files failed in {ROOT}:\n{listing.stderr.decode()}")
    copied = 0
    for rel in sorted(set(listing.stdout.decode().split("\0")) - {""}):
        source, target = ROOT / rel, destination / rel
        if not os.path.lexists(source):  # deleted in the working tree
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_symlink():
            os.symlink(os.readlink(source), target)
        elif source.is_file():
            # copy2 keeps the modification time, so cargo finds the copied
            # crates as fresh as the caller's.
            shutil.copy2(source, target)
        else:
            continue
        copied += 1
    return copied


def run_clippy(tree: Path, target_dir: str) -> tuple[int, list[dict], str]:
    env = dict(os.environ, CLIPPY_CONF_DIR=str(CONF_DIR), CARGO_TARGET_DIR=target_dir)
    # In its own process group, so that it can be stopped with every compiler
    # it started.
    process = subprocess.Popen(
        CLIPPY,
        cwd=tree,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    try:
        stdout, stderr = process.communicate()
    finally:
        if process.poll() is None:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=30)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
    messages = []
    for line in stdout.splitlines():
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        if record.get("reason") == "compiler-message":
            messages.append(record["message"])
    return process.returncode, messages, stderr


def config_warnings(messages: list[dict], stderr: str) -> list[str]:
    found = set()
    for message in messages:
        in_config = any(
            Path(s["file_name"]).resolve() == CONFIG.resolve() for s in message.get("spans", [])
        )
        if in_config or any(text in message["message"] for text in CONFIG_WARNINGS):
            found.add(message.get("rendered") or message["message"])
    if not found and any(text in stderr for text in CONFIG_WARNINGS):
        found.add(stderr)
    return sorted(found)


def probe_problems(crates: dict[str, dict], metadata: dict) -> tuple[list[str], str]:
    probe = crates.get(PROBE_CRATE)
    if probe is None:
        return [f"PROBE_CRATE {PROBE_CRATE} is not compiled by the wasm build"], ""
    needed = {p.split("::")[0] for _, probes in KINDS.values() for p in probes} - {"std"}
    direct = {
        d["name"] for d in probe["node"]["deps"] if any(k["kind"] is None for k in d["dep_kinds"])
    }
    if needed - direct:
        return [
            f"PROBE_CRATE {PROBE_CRATE} does not depend directly on"
            f" {', '.join(sorted(needed - direct))}, which the probes name"
        ], ""
    crate_root = Path(
        next(t["src_path"] for t in probe["targets"] if {"lib", "rlib"} & set(t["kind"]))
    )
    probe_file = crate_root.parent / f"{PROBE_MODULE}.rs"
    if probe_file.exists():
        return [f"{probe_file.relative_to(ROOT)} exists; the probes need that name"], ""
    rel = probe_file.relative_to(ROOT).as_posix()

    lines = ["// Probes of devtools/check-wasm-clippy-guard (in its copy of the tree only)."]
    spans = []  # (kind, path, first line, last line) of each probe, 1-based, inclusive
    for kind, probes in KINDS.values():
        for path, items in probes.items():
            for item in items:
                lines.append(f"mod probe_{len(spans)} {{")
                first = len(lines) + 1
                lines.append(item)
                spans.append((kind, path, first, len(lines)))
                lines.append("}")

    problems = []
    copy = Path(tempfile.mkdtemp(prefix="wasm-clippy-guard-"))
    try:
        files = copy_tree(copy)
        (copy / rel).write_text("\n".join(lines) + "\n", encoding="utf-8")
        root_rel = crate_root.relative_to(ROOT)
        with open(copy / root_rel, "a", encoding="utf-8") as declaration:
            declaration.write(f"\n#[allow(dead_code, unused, deprecated)]\nmod {PROBE_MODULE};\n")
        code, messages, stderr = run_clippy(copy, metadata["target_directory"])
    finally:
        shutil.rmtree(copy, ignore_errors=True)

    if code == 0:
        problems.append("the clippy step passed with every probe in place")
    problems += [f"warning about {CONFIG_REL}:\n{w}" for w in config_warnings(messages, stderr)]
    refused, other = set(), []
    for message in messages:
        primary = [s for s in message.get("spans", []) if s.get("is_primary")]
        in_probes = [s for s in primary if s["file_name"].endswith(rel)]
        match = REFUSAL.match(message["message"])
        if match and in_probes:
            for span in in_probes:
                for index, (kind, path, first, last) in enumerate(spans):
                    if (kind, path) == match.groups() and first <= span["line_start"] <= last:
                        refused.add(index)
        elif in_probes and message.get("level") == "error":
            other.append(message.get("rendered") or message["message"])
    for index, (kind, path, first, _) in enumerate(spans):
        if index in refused:
            print(f"refused: {path} ({kind}, {rel}:{first})")
        else:
            problems.append(f"{path}: the {kind} probe at {rel}:{first} was not refused")
    if len(refused) < len(spans) and other:
        problems.append("other errors in the probe file:\n" + "\n".join(other))
    if len(refused) < len(spans) and not messages:
        problems.append(f"cargo clippy printed no compiler message; its stderr:\n{stderr}")
    summary = f"{len(refused)} of {len(spans)} probes refused (in a copy of {files} files)"
    return problems, summary


def _stop(signum: int, _frame) -> None:
    raise SystemExit(128 + signum)


def main() -> int:
    # Line-buffered, so the FAIL lines on stderr keep their place among these
    # lines when both streams go to one log.
    sys.stdout.reconfigure(line_buffering=True)
    for stop in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(stop, _stop)
    paths, failures = read_config()
    entries = sum(len(p) for p in paths.values())
    if failures:
        for failure in failures:
            print(f"FAIL: {failure}", file=sys.stderr)
        print(f"{entries} entries in {CONFIG_REL}; no probe run")
        return 1

    metadata = cargo_metadata()
    crates = wasm_crates(metadata)
    print(f"crates the wasm build compiles: {', '.join(sorted(crates))}")
    found, settings = lint_setting_problems(crates, metadata)
    failures += found
    print(settings)
    found, settings = setting_probe_problems()
    failures += found
    print(settings)
    found, probes = probe_problems(crates, metadata)
    failures += found
    for failure in failures:
        print(f"FAIL: {failure}", file=sys.stderr)
    methods = len(paths.get("disallowed-methods", []))
    types = len(paths.get("disallowed-types", []))
    print(
        f"{entries} entries in clippy.toml ({methods} methods, {types}"
        f" type{'' if types == 1 else 's'}); {probes or 'no probe run'}"
    )
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
