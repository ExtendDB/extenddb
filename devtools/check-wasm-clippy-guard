"""Check that the wasm32 clippy step refuses each method in its deny list.

The list is the `disallowed-methods` paths in devtools/wasm-clippy/clippy.toml,
read from that file. For a path in the list that does not resolve, clippy
prints a "does not refer to a reachable function" warning and, under
-D warnings, still exits 0 (clippy 0.1.97), so a misspelt entry would leave
the step green with that method unguarded. This script:

1. fails if an entry in clippy.toml has no probe below, or a probe names a
   path that is not in clippy.toml;
2. runs the step exactly as the WebAssembly workflow does on the unmodified
   tree (after touching the probed file so clippy re-lints it), and fails if
   the step fails or prints an unresolved-path warning;
3. appends every probe to a source file the wasm build compiles, runs the
   step once more, and fails unless the step fails with clippy's
   disallowed-method error naming the probed path inside each probe, and
   prints no unresolved-path warning.

Some probes reach the method through an import or a re-export
(`use tokio::time; time::sleep`, `tokio::spawn`), as code usually does.

The probed file is restored on any exit. Run from anywhere in the
repository; exit status 0 means every entry resolved and every probe was
refused.
"""

import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONF_DIR = ROOT / "devtools" / "wasm-clippy"
CONFIG = CONF_DIR / "clippy.toml"
# A file of the engine, which the adapter compiles for wasm32.
PROBED = ROOT / "crates" / "engine" / "src" / "get_item.rs"
CLIPPY = [
    "cargo",
    "clippy",
    "--locked",
    "--message-format=json",
    "-p",
    "extenddb-wasm-adapter",
    "--lib",
    "--target",
    "wasm32-unknown-unknown",
    "--",
    "-D",
    "warnings",
]
UNRESOLVED = "does not refer to a reachable function"

_DUR = "std::time::Duration::ZERO"
_SET = "set: &mut tokio::task::JoinSet<()>"
_HANDLE = "h: &tokio::runtime::Handle"
_RT = "rt: &tokio::runtime::Runtime"
_CONDVAR = "c: &std::sync::Condvar, m: &std::sync::Mutex<()>"

