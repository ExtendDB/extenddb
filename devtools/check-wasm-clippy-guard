class Finding(NamedTuple):
    """What a check found: its name, where (a `file:line`, a crate, a path or a
    label) and a description. A finding that no control expects is a problem."""

    check: str
    where: str
    text: str


class Control(NamedTuple):
    """A case planted in the copy and the finding it must give: one of `check`
    at `where` whose text holds `expect`. With `check` None it is an accepted
    case: no finding may name `where` (a file) at a line in `lines`."""

    name: str
    check: str | None
    where: str
    expect: str = ""
    lines: range = range(0)


# ---------------------------------------------------------------- clippy.toml


def config_problems(label: str, text: str, probes: dict[str, set[str]]) -> list[Finding]:
    """Findings, at `label`, of a clippy.toml's `text` against the paths with a
    probe (`probes`, by kind): TOML that does not parse, a key other than the
    two lists, a value of one that is not a list, an entry that is not a table
    of exactly a non-empty `path` and `reason`, a path listed twice, an entry
    with no probe, and a probe of a path not listed."""
    try:
        config = tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        return [Finding("entries", label, f"{label} cannot be read: {error}")]
    found = [f"{key} is not one of the two lists" for key in config if key not in KINDS]
    for key, (kind, _) in KINDS.items():
        value = config.get(key, [])
        if not isinstance(value, list):
            found.append(f"{key} is not a list")
            value = []
        paths = []
        for entry in value:
            if isinstance(entry, dict) and set(entry) == {"path", "reason"} and all(
                isinstance(v, str) and v.strip() for v in entry.values()
            ):
                paths.append(entry["path"])
            else:
                found.append(
                    f"{key} entry {entry!r} is not a table of exactly a non-empty `path` and"
                    " `reason`"
                )
        found += [f"{p}: listed in {key} more than once" for p in set(paths) if paths.count(p) > 1]
        found += [f"{p}: listed in {key}, with no {kind} probe" for p in set(paths) - probes[kind]]
        found += [f"{p}: has a {kind} probe, not listed" for p in probes[kind] - set(paths)]
    return [Finding("entries", label, f"{label}: {text}") for text in sorted(found)]


# ---------------------------------------------------------------- cargo


def cargo_metadata(tree: Path, *options: str) -> tuple[dict | None, str]:
    """`cargo metadata` for wasm32 in the tree at `tree`, with `options`: the
    metadata, or None and cargo's error."""
    command = ["cargo", "metadata", "--color", "never", "--format-version", "1", *options]
    try:
        run = subprocess.run(
            command + ["--filter-platform", TARGET], cwd=tree, capture_output=True, text=True
        )
    except FileNotFoundError:
        sys.exit("error: cargo is not on PATH")
    return (json.loads(run.stdout), "") if run.returncode == 0 else (None, run.stderr)


def adapter_build(metadata: dict) -> tuple[list[dict], dict[str, dict]]:
    """The packages the adapter's wasm32 build compiles (the adapter and its
    normal dependencies on that target, as `cargo metadata --filter-platform`
    resolves them), and of them the workspace members, by name."""
    members = set(metadata["workspace_members"])
    packages = {p["id"]: p for p in metadata["packages"]}
    nodes = {n["id"]: n for n in metadata["resolve"]["nodes"]}
    todo = [i for i in members if packages[i]["name"] == ADAPTER]
    if not todo:
        sys.exit(f"error: cargo metadata lists no workspace member named {ADAPTER}")
    seen = set()
    while todo:
        package = todo.pop()
        if package in seen:
            continue
        seen.add(package)
        # kind None is a normal dependency.
        todo += [
            d["pkg"]
            for d in nodes[package]["deps"]
            if any(k["kind"] is None for k in d["dep_kinds"])
        ]
    build = [packages[i] for i in sorted(seen)]
    return build, {p["name"]: p for p in build if p["id"] in members}


def copy_tree(destination: Path) -> int:
    """Copy the files git tracks or does not ignore, as they are now: a
    symbolic link as the link it is, and no file beyond a link (git status
    lists a tracked file there as deleted), so that no copy goes through a
    link."""
    try:
        listing = subprocess.run(
            ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
            cwd=ROOT,
            capture_output=True,
            check=False,
        )
    except FileNotFoundError:
        sys.exit("error: git is not on PATH; the guard runs in a copy of the files git lists")
    if listing.returncode != 0:
        sys.exit(f"error: git ls-files failed in {ROOT}:\n{listing.stderr.decode()}")
    copied = 0
    for rel in sorted(set(listing.stdout.decode().split("\0")) - {""}):
        source, target = ROOT / rel, destination / rel
        beyond_link = any(os.path.islink(ROOT / d) for d in list(Path(rel).parents)[:-1])
        if beyond_link or not os.path.lexists(source):  # or deleted in the working tree
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_symlink():
            os.symlink(os.readlink(source), target)
        elif source.is_file():
            # copy2 keeps the modification time, so cargo finds the copied
            # crates as fresh as the caller's.
            shutil.copy2(source, target)
        else:
            continue
        copied += 1
    return copied


class Run(NamedTuple):
    """One clippy step: its exit status, compiler messages, compiler-artifact
    records and stderr."""

    code: int
    messages: list[dict]
    artifacts: list[dict]
    stderr: str


def run_clippy(tree: Path, target_dir: str, clippy_options: list[str]) -> Run:
    """Run the clippy step in the tree at `tree`, with `clippy_options` after
    its own, and the cargo target directory `target_dir`."""
    env = dict(os.environ, CARGO_TARGET_DIR=target_dir)
    command = CLIPPY + (["--", *clippy_options] if clippy_options else [])
    # In its own process group, so that it can be stopped with every compiler
    # it started.
    pipe = subprocess.PIPE
    process = subprocess.Popen(
        command, cwd=tree, env=env, stdout=pipe, stderr=pipe, text=True, start_new_session=True
    )
    try:
        stdout, stderr = process.communicate()
    finally:
        if process.poll() is None:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=30)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
    messages, artifacts = [], []
    for line in stdout.splitlines():
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        if record.get("reason") == "compiler-message":
            messages.append(record["message"])
        elif record.get("reason") == "compiler-artifact":
            artifacts.append(record)
    return Run(process.returncode, messages, artifacts, stderr)


def dep_info(run: Run, crates: dict, copy: Path, name: str) -> tuple[dict, list[Finding]]:
    """For each of `crates` (packages of the copy's metadata, by name) that the
    run's compiler-artifact records name, the files and the environment
    variables its dep-info lists, read from the dep-info file rustc writes
    next to the metadata file the record names; and an "examined" finding for
    each crate read, which a control expects for every crate and run, so a run
    that lints fewer crates, or whose findings are dropped, fails the
    controls. rustc writes the dep-info of a crate whose lints fail too, but
    cargo names no artifact for that crate."""
    by_manifest = {Path(p["manifest_path"]).resolve(): crate for crate, p in crates.items()}
    read = {}
    for artifact in run.artifacts:
        crate = by_manifest.get(Path(artifact["manifest_path"]).resolve())
        if crate is None or "custom-build" in artifact["target"]["kind"]:
            continue
        for output in map(Path, artifact["filenames"]):
            info = output.with_name(output.name.removeprefix("lib")).with_suffix(".d")
            if info.is_file():
                read[crate] = read_dep_info(info, copy)
                break
    found = [Finding("examined", f"{c} ({name})", f"examined {c} ({name})") for c in read]
    return read, found


def unfinished(run: Run, name: str, read: dict, crates: dict) -> int:
    """Report a clippy run that did not finish (`read` holds the dep-info it
    left, by crate), and return the guard's exit status. Once a crate fails,
    cargo starts no other ("build failed, waiting for other jobs to
    finish"), so the run's reports and dep-info cover only the crates it
    finished: the guard judges nothing else."""
    errors = [m.get("rendered") or m["message"] for m in run.messages if m["level"] == "error"]
    print(
        f"FAIL: the clippy step {name} did not finish in the copy (exit status {run.code}),"
        " so the guard judges nothing else; the crates it did not finish linting:"
        f" {', '.join(sorted(set(crates) - set(read))) or 'none'}. Its errors:\n"
        + ("\n".join(errors) or run.stderr),
        file=sys.stderr,
    )
    return 1


def read_dep_info(info: Path, root: Path) -> tuple[list[Path], dict[str, str]]:
    """The files a rustc dep-info file lists, other than those named
    Cargo.toml, clippy.toml or .clippy.toml (clippy adds the manifest and its
    configuration), and the environment variables it records
    (`# env-dep:NAME=VALUE`), among them the CLIPPY_ARGS and CLIPPY_CONF_DIR
    clippy-driver read. rustc writes a line `<file>:` for each file, with a
    space in the name written `\\ `; a relative name is relative to `root`,
    where cargo ran rustc."""
    files, env = [], {}
    for line in info.read_text(encoding="utf-8").splitlines():
        if line.startswith("# env-dep:"):
            name, _, value = line.removeprefix("# env-dep:").partition("=")
            env[name] = value
        if line.startswith("#") or not line.endswith(":"):
            continue
        path = Path(os.path.normpath(root / line[:-1].replace("\\ ", " ")))
        if path.name not in ("Cargo.toml", "clippy.toml", ".clippy.toml"):
            files.append(path)
    return files, env


def driver_problems(plain: dict, forced: dict, conf_dir: str) -> list[Finding]:
    """Findings of what clippy-driver read for each crate, as its dep-info
    records it in the run without options (`plain`) and the run with
    FORCE_WARN (`forced`), each mapping a crate to its files and variables:
    CLIPPY_CONF_DIR other than `conf_dir`, and CLIPPY_ARGS other than the
    value most crates record in `plain` (the clippy step's own options),
    followed in `forced` by FORCE_WARN. A build script's cargo::rustc-env can
    set either for its crate, an [env] entry with force = true for every
    crate."""
    common = Counter(env.get("CLIPPY_ARGS") for _, env in plain.values()).most_common(1)
    step = common[0][0] if common else None
    found = []
    for name, read, options in (
        ("without options", plain, []),
        ("with --force-warn", forced, FORCE_WARN),
    ):
        expected = step and step + "".join(o + CLIPPY_ARGS_SEPARATOR for o in options)
        for crate, (_, env) in sorted(read.items()):
            for variable, value in (("CLIPPY_ARGS", expected), ("CLIPPY_CONF_DIR", conf_dir)):
                if value is None or env.get(variable) != value:
                    text = (
                        f"{crate}: in the clippy step {name}, clippy-driver read {variable}"
                        f" {env.get(variable)!r}, not {value!r}"
                    )
                    found.append(Finding("dep-info", crate, text))
    return found


def config_warnings(runs: dict[str, Run], config: Path) -> list[Finding]:
    """The warnings about clippy.toml (read at `config`) that the runs printed,
    one finding per path they name."""
    found = {}
    for run in runs.values():
        texts = [
            m.get("rendered") or m["message"]
            for m in run.messages
            if any(Path(s["file_name"]).resolve() == config for s in m.get("spans", []))
            or any(t in m["message"] for t in CONFIG_WARNINGS)
        ]
        if not texts and any(t in run.stderr for t in CONFIG_WARNINGS):
            texts = [run.stderr]
        for text in texts:
            path = re.search(r"`([^`]+)`", text)
            where = path.group(1) if path else CONFIG_REL
            found[where] = Finding("clippy.toml warning", where, f"about {CONFIG_REL}:\n{text}")
    return list(found.values())


# ---------------------------------------------------------------- lint attributes

_SCAN = re.compile(r'//|/\*|(?<!\w)(?:b|c)?r#*"|(?<!\w)(?:b|c)?"|\'')
_CHAR = re.compile(r"'(?:\\(?:u\{[0-9A-Fa-f]{1,6}\}|x[0-9A-Fa-f]{2}|.)|[^\\'\n])'")


def code_only(text: str) -> str:
    """`text` with comments and the contents of string and character literals
    blanked (line breaks kept), so offsets and line numbers still match."""
    out = []
    i = 0
    n = len(text)

    def blank(a: int, b: int) -> None:
        out.append(re.sub(r"[^\n]", " ", text[a:b]))

    while True:
        match = _SCAN.search(text, i)
        if not match:
            out.append(text[i:])
            break
        start = match.start()
        out.append(text[i:start])
        token = match.group()
        if token == "//":
            end = text.find("\n", start)
            end = n if end < 0 else end
            blank(start, end)
        elif token == "/*":
            depth, end = 1, start + 2
            while end < n and depth:
                if text.startswith("/*", end):
                    depth, end = depth + 1, end + 2
                elif text.startswith("*/", end):
                    depth, end = depth - 1, end + 2
                else:
                    end += 1
            blank(start, end)
        elif token == "'":
            char = _CHAR.match(text, start)
            end = char.end() if char else start + 1  # a lifetime or a label
            out.append(text[start] + re.sub(r"[^\n]", " ", text[start + 1 : end - 1]))
            if char:
                out.append("'")
        elif token.endswith('"') and "r" in token:
            hashes = token.count("#")
            close = text.find('"' + "#" * hashes, match.end())
            close = n if close < 0 else close
            end = min(n, close + 1 + hashes)
            out.append(token)
            blank(match.end(), close)
            out.append(text[close:end])
        else:
            end = match.end()
            while end < n and text[end] != '"':
                end += 2 if text[end] == "\\" else 1
            out.append(token)
            blank(match.end(), end)
            out.append(text[end : end + 1])
            end += 1
        i = end
    return "".join(out)


def _closing(code: str, start: int, opening: str, closing: str) -> int:
    """The index just past the bracket that closes the one at `start`."""
    depth = 0
    for index in range(start, len(code)):
        if code[index] == opening:
            depth += 1
        elif code[index] == closing:
            depth -= 1
            if depth == 0:
                return index + 1
    return len(code)


def _items(code: str, start: int, end: int) -> list[tuple[int, int]]:
    """The (start, end) of each comma-separated item of code[start:end]."""
    items, depth, first = [], 0, start
    for index in range(start, end):
        if code[index] in "([{":
            depth += 1
        elif code[index] in ")]}":
            depth -= 1
        elif code[index] == "," and depth == 0:
            items.append((first, index))
            first = index + 1
    return items + [(first, end)]


_REASON = re.compile(r'\s*reason\s*=\s*(?:(r)(#*))?"')
_ESCAPE = re.compile(r"\\(?:x([0-9A-Fa-f]{2})|u\{([0-9A-Fa-f_]{1,8})\}|\n[ \t\r\n]*|(.))", re.S)
_SIMPLE_ESCAPES = {"n": "\n", "r": "\r", "t": "\t", "\\": "\\", "0": "\0", "'": "'", '"': '"'}


def reason_value(text: str, code: str, start: int, end: int) -> str | None:
    """The text of the string literal in a `reason = "..."` item of a lint list,
    the item being code[start:end], or None when the item is not one. `code` is
    `text` with comments and literal contents blanked, so the literal's quotes
    are found in `code` and its contents read from `text` (which holds the
    file's bytes, one character each) as UTF-8; escapes are decoded, a raw
    string's contents are taken as written."""
    match = _REASON.match(code, start, end)
    if not match:
        return None
    raw, hashes = match.group(1), match.group(2) or ""
    close = code.find('"' + hashes if raw else '"', match.end(), end)
    if close < 0:
        return None
    contents = text[match.end() : close].encode("latin-1").decode("utf-8", "replace")
    return contents if raw else _ESCAPE.sub(_unescape, contents)


def _unescape(escape: re.Match) -> str:
    """The character one escape of a Rust string literal stands for; a line
    continuation (a backslash at the end of a line, and the next line's
    indentation) stands for nothing."""
    hex_byte, code_point, simple = escape.groups()
    try:
        if hex_byte:
            return chr(int(hex_byte, 16))
        if code_point:
            return chr(int(code_point.replace("_", ""), 16))
    except ValueError:  # not a character; rustc refuses the literal
        return escape.group()
    if simple is not None:
        return _SIMPLE_ESCAPES.get(simple, escape.group())
    return ""


_ATTRIBUTE = re.compile(r"#\s*(!?)\s*\[")
_NEXT_ATTRIBUTE = re.compile(r"\s*#\s*\[")
_LEVEL = re.compile(r"\s*(allow|expect|cfg_attr)\s*\(")
_VISIBILITY = r"(?:pub\s*(?:\([^()]*\))?\s*)?"
_FN = re.compile(
    _VISIBILITY + r"(?:(?:const|async|unsafe|safe|default|extern\s*(?:\"[^\"]*\")?)\s*)*fn\s+\w"
)
_ITEM = re.compile(
    _VISIBILITY + r"(?:(?:unsafe|auto|default)\s+)*"
    r"(mod|impl|trait|struct|enum|union|type|use|extern|macro_rules|const|static)\b"
)
_ITEM_NAMES = {
    "mod": "a module",
    "impl": "an impl block",
    "enum": "an enum",
    "extern": "an extern item",
    "use": "a use item",
    "type": "a type alias",
    "macro_rules": "a macro definition",
}
# An item inside a function or a statement. rustc applies the allow on the
# function or statement to it too, but its code is not that function's: an
# impl there, for one, adds methods that code elsewhere calls.
_NESTED_ITEM = re.compile(
    r"\bfn\s+\w|\bimpl\b|\btrait\s+\w|\bmod\s+\w"
    r"|(?<![\w*'])(?:const\s+\w+|static\s+(?:mut\s+)?\w+)\s*:"
)
_BLOCK_LIKE = re.compile(r"(?:if|match|loop|while|for|unsafe|async|const|move)\b|[{|]|'\w+\s*:")
_MACRO_CALL = re.compile(r"(?:::)?\w+(?:\s*::\s*\w+)*\s*!\s*[(\[{]")
_SPACE = re.compile(r"\s*")


def _item_extent(code: str, index: int) -> tuple[int | None, int] | None:
    """For the item whose header starts at `index`: the index of the `{` that
    opens its body and the index just past the `}` that closes it, or None and
    the index just past the `;` of a bodiless item. The body is the first `{`
    outside the header's angle brackets; parentheses and brackets are skipped
    whole, and a `{` inside angle brackets opens a const block. None when a
    bracket of the enclosing code closes first."""
    angles = 0
    while index < len(code):
        char = code[index]
        if char in "([":
            index = _closing(code, index, char, ")" if char == "(" else "]")
            continue
        if char == "<":
            angles += 1
        elif char == ">" and code[index - 1] != "-":
            angles -= 1
            if angles < 0:
                return None
        elif char == "{":
            end = _closing(code, index, "{", "}")
            if angles == 0:
                return index, end
            index = end
            continue
        elif char == ";" and angles == 0:
            return None, index + 1
        elif char in ")]};":
            return None
        index += 1
    return None


def _statement_end(code: str, index: int, separators: bool = True) -> int | None:
    """The index just past the `;` that ends, at depth 0, the code from
    `index`. None when a bracket of the enclosing code closes first, or, with
    `separators`, when a `,` or a `=>` comes first at depth 0, as after a match
    arm, a field or a parameter. A `<` after `::` (a turbofish) opens a depth
    as a bracket does."""
    open_brackets = []
    while index < len(code):
        char = code[index]
        if code.startswith("::<", index):
            open_brackets.append("<")
            index += 3
            continue
        if char in "([{":
            open_brackets.append(char)
        elif char == ">" and open_brackets[-1:] == ["<"] and code[index - 1] not in "-=":
            open_brackets.pop()
        elif char in ")]}":
            while open_brackets[-1:] == ["<"]:
                open_brackets.pop()
            if not open_brackets:
                return None
            open_brackets.pop()
        elif not open_brackets and char == ";":
            return index + 1
        elif not open_brackets and separators and (char == "," or code.startswith("=>", index)):
            return None
        index += 1
    return None


def _without_items(code: str, start: int, end: int) -> list[tuple[int, int]]:
    """code[start:end] as (start, end) spans, without the items in it."""
    spans, index = [], start
    for item in _NESTED_ITEM.finditer(code, start, end):
        if item.start() < index:
            continue
        if item.group().startswith(("const", "static")):
            stop = _statement_end(code, item.start(), separators=False)
        else:
            extent = _item_extent(code, item.start())
            stop = extent[1] if extent else None
        spans.append((index, item.start()))
        index = end if stop is None else min(stop, end)
    return spans + [(index, end)]


def _bare_macro_call(code: str, call: re.Match) -> bool:
    """Whether the macro invocation `call` matched is all of its statement:
    delimited by braces, or followed by `;`."""
    opening = code[call.end() - 1]
    if opening == "{":
        return True
    close = _closing(code, call.end() - 1, opening, ")" if opening == "(" else "]")
    return code[close:].lstrip()[:1] in (";", "")


def _previous(code: str, index: int) -> str:
    """The last character before `index` that is not whitespace, or ""."""
    while index > 0 and code[index - 1].isspace():
        index -= 1
    return code[index - 1] if index else ""


class Attributes(NamedTuple):
    """What lint_attributes found in one file: the byte spans the accepted
    allows cover, how many of those allows are on functions and on statements,
    and findings for the others."""

    covered: list[tuple[int, int]]
    on_functions: int
    on_statements: int
    findings: list[Finding]


def lint_attributes(rel: str, text: str) -> Attributes:
    """The allows and expects of the disallowed lints in one file, `text`
    holding its bytes one character each. An attribute names one when its lint
    list holds clippy::disallowed_methods or clippy::disallowed_types in that
    spelling (whitespace aside). It is accepted when it is an outer attribute
    with a `reason` that holds more than whitespace and sits on a `fn` item, or
    after a `{`, `;` or `}` on a statement: a `let`, or an expression ending in
    `;` that is not a macro invocation and does not start with a block. It
    covers that item or statement without the items written inside it. Any
    other attribute that names one, in cfg_attr too, is a finding."""
    code = code_only(text)
    covered, counts, found = [], Counter(), []
    run_start, run_end = 0, None
    for attribute in _ATTRIBUTE.finditer(code):
        end = _closing(code, attribute.end() - 1, "[", "]")
        if run_end is None or code[run_end : attribute.start()].strip():
            run_start = attribute.start()
        run_end = end
        level = _LEVEL.match(code, attribute.end())
        if not level:
            continue
        close = _closing(code, level.end() - 1, "(", ")")
        if level.group(1) == "cfg_attr":
            named = sorted(_named_lints(code, level.end(), close - 1))
            why = "is inside cfg_attr, which applies it only where its condition holds"
        else:
            names, reasons = set(), []
            for start, stop in _items(code, level.end(), close - 1):
                reason = reason_value(text, code, start, stop)
                if reason is None:
                    names.add(re.sub(r"\s", "", code[start:stop]))
                else:
                    reasons.append(reason)
            named = sorted(names & set(DISALLOWED))
            why, span = _placement(code, attribute, end, run_start, reasons)
        if not named:
            continue
        if why:
            where = f"{rel}:{code.count(chr(10), 0, attribute.start()) + 1}"
            found.append(
                Finding(
                    "allow",
                    where,
                    f"{where}: an allow or expect of {', '.join(named)} {why}; an accepted one"
                    " is an outer #[allow] or #[expect] with a reason, on the function or the"
                    " statement that holds the call",
                )
            )
            continue
        kind, first, last, inner_start, inner_end = span
        covered += [(first, inner_start)] + _without_items(code, inner_start, inner_end)
        covered.append((inner_end, last))
        counts[kind] += 1
    return Attributes(covered, counts["fn"], counts["statement"], found)


def _placement(code: str, attribute: re.Match, end: int, run_start: int, reasons: list[str]):
    """Why an allow or expect of a disallowed lint (the attribute matched at
    `attribute`, ending at `end`, in a run of attributes from `run_start`) is
    not accepted, or None and the span it covers: (kind, start, end, and the
    start and end of the part in which the items are left out)."""
    index = end
    while following := _NEXT_ATTRIBUTE.match(code, index):
        index = _closing(code, following.end() - 1, "[", "]")
    index = _SPACE.match(code, index).end()
    if attribute.group(1):
        return "is an inner attribute, which covers all of the module or function it is in", None
    if not any(reason.strip() for reason in reasons):
        return "has no `reason`, or one that holds only whitespace", None
    if _FN.match(code, index):
        extent = _item_extent(code, index)
        if extent is None:
            return "is on a function whose end the guard cannot find", None
        body, stop = extent
        if body is None:
            return None, ("fn", run_start, stop, stop, stop)
        return None, ("fn", run_start, stop, body + 1, stop - 1)
    if item := _ITEM.match(code, index):
        return f"is on {_ITEM_NAMES.get(item.group(1), 'a ' + item.group(1))}", None
    if _previous(code, run_start) not in ("{", ";", "}"):
        return "is not on a function or a statement", None
    if _BLOCK_LIKE.match(code, index):
        return "is on a statement that starts with a block", None
    if (call := _MACRO_CALL.match(code, index)) and _bare_macro_call(code, call):
        return "is on a macro invocation, which can expand to items it would cover", None
    stop = _statement_end(code, index, separators=not re.match(r"let\b", code[index : index + 4]))
    if stop is None:
        return "is not on a function or a statement", None
    return None, ("statement", run_start, stop, index, stop)


def _named_lints(code: str, start: int, end: int) -> set[str]:
    """The disallowed lints that an attribute of the list code[start:end]
    (cfg_attr's predicate and attributes) allows or expects, at any depth."""
    named = set()
    for item_start, item_end in _items(code, start, end):
        level = _LEVEL.match(code, item_start, item_end)
        if not level:
            continue
        close = _closing(code, level.end() - 1, "(", ")")
        if level.group(1) == "cfg_attr":
            named |= _named_lints(code, level.end(), close - 1)
        else:
            items = _items(code, level.end(), close - 1)
            named |= {re.sub(r"\s", "", code[a:b]) for a, b in items} & set(DISALLOWED)
    return named


# ---------------------------------------------------------------- reports


class Report(NamedTuple):
    """A report of one of the four lints, at its primary span."""

    lint: str
    path: Path
    line: int
    start: int
    end: int
    message: str
    level: str


def reports(run: Run, copy: Path) -> list[Report]:
    found = []
    for message in run.messages:
        lint = (message.get("code") or {}).get("code")
        spans = [s for s in message.get("spans", []) if s.get("is_primary")]
        if lint in DISALLOWED + AWAIT and spans:
            span = spans[0]
            found.append(
                Report(
                    lint,
                    Path(os.path.normpath(copy / span["file_name"])),
                    span["line_start"],
                    span["byte_start"],
                    span["byte_end"],
                    message["message"],
                    message["level"],
                )
            )
    return found


def call_problems(
    forced: list[Report],
    plain: list[Report],
    covered: dict[Path, list[tuple[int, int]]],
    copy: Path,
    probe_file: Path,
) -> list[Finding]:
    """Findings of the reports of the run with --force-warn (`forced`), which
    holds every disallowed call clippy lints, against the run without options
    (`plain`) and the spans the accepted allows cover: an await-holding
    report; a call no accepted allow covers as written; and a call one covers
    that the clippy step reports all the same. The probes are left to
    probe_problems."""
    levels = {r[:6]: r.level for r in plain}
    found = []
    for report in forced:
        if report.path == probe_file:
            continue
        rel = report.path.relative_to(copy) if report.path.is_relative_to(copy) else report.path
        where = f"{Path(rel).as_posix()}:{report.line}"
        what = f"{where}: {report.message} ({report.lint})"
        level = levels.get(report[:6])
        if report.lint in AWAIT:
            text = (
                f"{what}: a std lock guard or a RefCell borrow held across an .await traps on"
                " wasm32 when another task takes it; no allow makes it acceptable"
            )
            found.append(Finding("await", where, text))
        elif not any(a <= report.start < b for a, b in covered.get(report.path, ())):
            if level is None:
                step = (
                    "the clippy step does not report it, so a setting other than an accepted"
                    " allow switches the lint off there (an allow of a lint group or of"
                    " warnings, an allow a macro builds or an allow in another spelling, such"
                    " as a raw identifier or a former name, a [lints] table, or an allow on"
                    " the code that holds the call's function)"
                )
            elif level == "error":
                step = "the clippy step reports it as an error"
            else:
                step = (
                    f"the clippy step reports it as a {level}, so a setting keeps the lint"
                    " below error there (a warn of warnings, --force-warn or --cap-lints)"
                )
            text = f"{what}: no accepted allow covers it as written, and {step}"
            found.append(Finding("call", where, text))
        elif level is not None:
            text = (
                f"{what}: an accepted allow covers it as written, but the clippy step reports"
                f" it as a {level}: a setting between the allow and the call sets the lint again"
            )
            found.append(Finding("step", where, text))
    return found


def probe_problems(forced: list[Report], probe_file: Path, spans: list[tuple]) -> list[Finding]:
    """A finding for each probe (`spans`: the kind, the path and the line of
    each) that the run with --force-warn did not report, on its line, as a
    disallowed method or type of its path."""
    reported = {
        (*match.groups(), report.line)
        for report in forced
        if report.path == probe_file and (match := REFUSAL.match(report.message))
    }
    return [
        Finding("probe", path, f"{path}: the {kind} probe at line {line} was not reported")
        for kind, path, line in spans
        if (kind, path, line) not in reported
    ]


