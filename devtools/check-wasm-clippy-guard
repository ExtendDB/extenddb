def _inside(copy: Path, rel: str) -> list[Finding]:
    """A finding when the copy's path `rel`, or a directory on the way to it, is
    a symbolic link out of the copy or into a loop (for which resolve raises
    RuntimeError in Python 3.11 and 3.12): a write there would change a file
    outside the copy, the caller's working tree among them."""
    try:
        if (copy / rel).resolve().is_relative_to(copy.resolve()):
            return []
    except (OSError, RuntimeError):
        pass
    text = f"{rel} leads out of the copy or into a loop through a symbolic link"
    return [Finding("plant", rel, f"{text}; the guard writes nothing to it")]


def _write(copy: Path, rel: str, text: str, mode: str = "x") -> list[Finding]:
    """Write `text` to the copy's file `rel` (mode "x": a new file, "a": an
    append, "w": a replacement), or give a finding that says why it cannot."""
    if found := _inside(copy, rel):
        return found
    try:
        (copy / rel).parent.mkdir(parents=True, exist_ok=True)
        with open(copy / rel, mode, encoding="utf-8") as file:
            file.write(text)
    except (OSError, UnicodeError) as error:
        return [Finding("plant", rel, f"{rel} cannot be written: {error}")]
    return []


def toml_string(text: str) -> str:
    """`text` as a TOML basic string: JSON's escapes are TOML's, and TOML also
    needs DEL escaped. A lone surrogate stays as it is, and writing it fails."""
    return json.dumps(text, ensure_ascii=False).replace("\x7f", "\\u007f")


def probe_dependencies(
    paths: list[str], build: list[dict], adapter: str, members: set[str]
) -> tuple[list[str], list[Finding]]:
    """The [dependencies] lines of the guard's crate: for each crate that a
    path of `paths` starts with, other than std, core and alloc, the one
    package of `build` (the adapter's wasm32 build) whose library (a lib, rlib
    or dylib target) has that name, `-` read as `_`; a workspace member (its
    id in `members`) by its directory, any other package by its exact version,
    each without default features, so that the crate adds no package and asks
    for no feature. A finding names each path whose crate no package or more
    than one has, or is the adapter's (`adapter`, its id), which depends on
    the guard's crate."""
    lines, found = [], []
    for crate in sorted({p.partition("::")[0] for p in paths} - {"std", "core", "alloc"}):
        named = [
            p
            for p in build
            for t in p["targets"]
            if {"lib", "rlib", "dylib"} & set(t["kind"]) and t["name"].replace("-", "_") == crate
        ]
        if len(named) == 1 and named[0]["id"] != adapter:
            package = named[0]
            if package["id"] in members:
                directory = os.path.relpath(Path(package["manifest_path"]).parent, ROOT / GUARD)
                source = f"path = {toml_string(directory)}"
            else:
                source = f"version = {toml_string('=' + package['version'])}"
            name = toml_string(package["name"])
            lines.append(f"{crate} = {{ package = {name}, {source}, default-features = false }}")
            continue
        packages = ", ".join(f"{p['name']} v{p['version']}" for p in named) or "none"
        why = (
            f"its probe needs the library {crate} of one package of the adapter's wasm32 build"
            f" other than the adapter, which depends on the guard's crate; it has {packages}"
        )
        found += [Finding("plant", p, f"{p}: {why}") for p in paths if p.startswith(crate + "::")]
    return lines, found


def lock_problems(label: str, *locks: str) -> list[Finding]:
    """A finding, at `label`, for each package (by name, version and source)
    whose entry is not the same in the two Cargo.lock texts `locks`, the
    guard's crate and the dependencies on it left out."""
    tree, copy = (
        {
            (p["name"], p["version"], p.get("source")): p
            | {"dependencies": [d for d in p.get("dependencies", []) if d != GUARD]}
            for p in tomllib.loads(text).get("package", [])
            if p["name"] != GUARD
        }
        for text in locks
    )
    found = []
    for key in sorted(tree.keys() | copy.keys(), key=str):
        if tree.get(key) != copy.get(key):
            state = "added" if key not in tree else "dropped" if key not in copy else "changed"
            text = f"{label}: {key[0]} {key[1]} is {state} by the guard's crate"
            found.append(Finding("plant", label, text))
    return found


def crate_files(dependencies: list[str]) -> tuple[dict[str, str], list[tuple[str, str, int]]]:
    """The files of the guard's crate, by their paths in the copy, and the
    kind, path and line of each probe in its probe file, which holds each
    probe item, and CONTROL_PROBE, in a module of its own."""
    lines, spans = [], []
    probes = [(kind, *entry) for kind, table in KINDS.values() for entry in table.items()]
    for kind, path, items in probes + [(*CONTROL_PROBE[:2], [CONTROL_PROBE[2]])]:
        for item in items:
            lines += [f"mod probe_{len(spans)} {{", item, "}"]
            spans.append((kind, path, len(lines) - 1))
    files = {
        "Cargo.toml": MANIFEST + "".join(f"{line}\n" for line in dependencies),
        "build.rs": BUILD_SCRIPT,
        "src/lib.rs": LIB_ROOT,
        "src/controls.rs": CONTROLS,
        "src/controls/allowed_module.rs": "",
        "outside_src.rs": OTHER_FILE_CONTROLS.format(name="path"),
        "src/controls.inc": OTHER_FILE_CONTROLS.format(name="include"),
        **MIGRATION_CONTROLS,
        "src/release.rs": RELEASE_CONTROL,
        "src/probes.rs": "\n".join(lines) + "\n",
    }
    files = {f"{GUARD}/{rel}": text for rel, text in files.items()}
    return files | {rel: text for rel, (text, _) in CONTROL_CARGO_CONFIGS.items()}, spans


def plant(copy: Path, metadata: dict, adapter: dict, files: dict[str, str]) -> list[Finding]:
    """Add the guard's crate (`files`) to the copy, as a dependency of the
    adapter (its package in the tree's `metadata`), and CONTROL_ENTRY to the
    top of the copy's disallowed-methods list; a finding for each part that
    cannot be made."""
    taken = {p["name"] for p in metadata["packages"]}
    taken |= {d.get("rename") for d in adapter["dependencies"]}
    tree_has = {
        f"{GUARD}, where the guard adds its crate": os.path.lexists(ROOT / GUARD),
        f"a package or a dependency named {GUARD}": GUARD in taken,
    }
    found = [Finding("plant", GUARD, f"the tree has {what}") for what in tree_has if tree_has[what]]
    for rel, text in () if found else files.items():
        found += _write(copy, rel, text)
    manifest = os.path.relpath(adapter["manifest_path"], ROOT)
    path = toml_string(os.path.relpath(GUARD, os.path.dirname(manifest)))
    found += _write(copy, manifest, f"\n[dependencies.{GUARD}]\npath = {path}\n", "a")
    try:
        config = (copy / CONFIG_REL).read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        return found + [Finding("plant", CONFIG_REL, f"{CONFIG_REL} cannot be read: {error}")]
    entry = f'    {{ path = "{CONTROL_ENTRY}", reason = "a control" }},\n'
    text, count = re.subn(
        r"^disallowed-methods = \[\n", lambda m: m.group() + entry, config, count=1, flags=re.M
    )
    if count != 1 or CONTROL_ENTRY in config:
        why = f"has no `disallowed-methods = [` line, or names {CONTROL_ENTRY}"
        return found + [Finding("plant", CONFIG_REL, f"{CONFIG_REL} {why}")]
    return found + _write(copy, CONFIG_REL, text, "w")


def all_controls(files: dict[str, str], copy: Path, crates: dict) -> list[Control]:
    """The controls that the `//@` comments of `files` (path -> text) mark, and
    those of the checks that no planted file reaches."""
    marked = []
    for rel, text in files.items():
        opened = {}
        for number, line in enumerate(text.splitlines(), 1):
            for name, mark in _MARK.findall(line):
                if mark == "accepted":
                    opened[name] = number
                elif mark == "end":
                    lines = range(opened.pop(name), number + 1)
                    marked.append(Control(name, None, rel, lines=lines))
                else:
                    marked.append(Control(name, mark, f"{rel}:{number}"))
    zeroize = ("ghash without its zeroize feature", "a second ghash", "no ghash")
    return marked + [
        Control("unlisted probe", "entries", CONFIG_REL, f"{CONTROL_PROBE[1]}: has a method"),
        Control("unlisted probe", "probe", CONTROL_PROBE[1]),
        Control("unresolved entry", "entries", CONFIG_REL, f"{CONTROL_ENTRY}: listed in"),
        Control("unresolved entry", "clippy.toml warning", CONTROL_ENTRY),
        *(
            Control("clippy.toml", "entries", f"control: {label}", words)
            for label, (_, expected) in CONFIG_CONTROLS.items()
            for words in expected
        ),
        *(Control("dependency", "plant", path, words) for path, words in CONTROL_PATHS.items()),
        Control("lock", "plant", "control: a lock", "wasm-clippy-guard-control 0.0.0 is added"),
        Control("build script", "dep-info", GUARD, "CLIPPY_ARGS"),
        Control("build script", "dep-info", GUARD, "CLIPPY_CONF_DIR"),
        Control("environment", "examined", "the environment"),
        Control("environment", "examined", "a control environment"),
        Control("environment", "environment", "a control environment", "RUSTC_WRAPPER"),
        Control("cargo configuration", "examined", "the copy's cargo configuration"),
        Control("cargo configuration", "examined", "a control configuration"),
        *(
            Control("cargo configuration", "cargo configuration", str(copy / rel), words)
            for rel, (_, words) in CONTROL_CARGO_CONFIGS.items()
        ),
        Control("zeroize", "examined", "the adapter's wasm32 build"),
        *(Control("zeroize", "examined", f"control: {label}") for label in zeroize),
        Control("zeroize", "zeroize", f"control: {zeroize[0]}: ghash", "without its zeroize"),
        Control("zeroize", "zeroize", f"control: {zeroize[1]}: ghash", " packages ("),
        Control("zeroize", "zeroize", f"control: {zeroize[2]}: ghash", "is not in the build"),
        *(
            Control("dep-info", "examined", f"{crate} ({run})")
            for crate in sorted(crates)
            for run in ("without options", "with --force-warn")
        ),
    ]


def match_controls(findings: list[Finding], controls: list[Control]) -> tuple[list, list]:
    """The controls that did not behave as planted, and the findings no control
    expects (the problems)."""
    failures, expected = [], set()
    for control in controls:
        if control.check is None:
            for finding in findings:
                file, _, line = finding.where.rpartition(":")
                if file == control.where and line.isdigit() and int(line) in control.lines:
                    failures.append(f"control {control.name} must be accepted: {finding.text}")
                    expected.add(finding)
            continue
        hits = [
            f
            for f in findings
            if (f.check, f.where) == (control.check, control.where) and control.expect in f.text
        ]
        if not hits:
            failures.append(
                f"control {control.name}: the {control.check} check reported nothing at"
                f" {control.where}"
            )
        expected.update(hits)
    return failures, [f for f in findings if f not in expected]


def _stop(signum: int, _frame) -> None:
    raise SystemExit(128 + signum)


def check(metadata: dict, copy: Path) -> int:
    count = copy_tree(copy)
    build, members = adapter_build(metadata)
    ids = set(metadata["workspace_members"])
    paths = [*METHOD_PROBES, *TYPE_PROBES]
    dependencies, found = probe_dependencies(paths, build, members[ADAPTER]["id"], ids)
    files, spans = crate_files(dependencies)
    found += plant(copy, metadata, members[ADAPTER], files) + _inside(copy, "Cargo.lock")
    copied, error = (None, "") if found else cargo_metadata(copy, "--offline")
    if copied:
        locks = [(tree / "Cargo.lock").read_text(encoding="utf-8") for tree in (ROOT, copy)]
        found += lock_problems("the copy's Cargo.lock", *locks)
    elif not found:
        found.append(Finding("plant", "Cargo.lock", f"cargo metadata --offline failed:\n{error}"))
    for text in dict.fromkeys(f.text for f in found):
        print(f"FAIL: {text}", file=sys.stderr)
    if found:
        return 1
    crates = adapter_build(copied)[1]
    planted = all_controls(files, copy, crates)
    target_dir = metadata["target_directory"]
    # Each dep-info is read before the next run, which writes the same files.
    plain = run_clippy(copy, target_dir, [])
    read_plain, findings = dep_info(plain, crates, copy, "without options")
    if plain.code != 0:
        return unfinished(plain, "without options", read_plain, crates)
    with open(copy / GUARD / "src" / "lib.rs", "a", encoding="utf-8") as file:
        file.write(LATE_MODULES)
    forced = run_clippy(copy, target_dir, FORCE_WARN)
    read_forced, found = dep_info(forced, crates, copy, "with --force-warn")
    findings += found
    if forced.code != 0:
        return unfinished(forced, "with --force-warn", read_forced, crates)
    findings += driver_problems(read_plain, read_forced, str(copy / CONF_REL))
    findings += config_warnings({"plain": plain, "forced": forced}, (copy / CONFIG_REL).resolve())
    probes = {kind: set(table) for kind, table in KINDS.values()}
    probes[CONTROL_PROBE[0]].add(CONTROL_PROBE[1])
    findings += config_problems(CONFIG_REL, (copy / CONFIG_REL).read_text(encoding="utf-8"), probes)
    for label, (text, _) in CONFIG_CONTROLS.items():
        sleep = {"method": {"std::thread::sleep"}, "type": set()}
        findings += config_problems(f"control: {label}", text, sleep)
    findings += probe_dependencies([*CONTROL_PATHS], CONTROL_BUILD, f"{ADAPTER} 1.0.0", set())[1]
    findings += lock_problems("control: a lock", locks[0], locks[1] + CONTROL_LOCK)

    guard = copy / GUARD
    covered, allows, read = {}, Counter(), 0
    for path in sorted({p for listed, _ in read_forced.values() for p in listed}):
        if not path.is_relative_to(copy) or not path.is_file():
            continue
        rel = path.relative_to(copy).as_posix()
        attributes = lint_attributes(rel, path.read_bytes().decode("latin-1"))
        covered[path] = attributes.covered
        findings += attributes.findings
        if not path.is_relative_to(guard):
            allows["fn"] += attributes.on_functions
            allows["statement"] += attributes.on_statements
            read += 1
    forced_reports = reports(forced, copy)
    probe_path = guard / "src" / "probes.rs"
    findings += call_problems(forced_reports, reports(plain, copy), covered, copy, probe_path)
    findings += probe_problems(forced_reports, probe_path, spans)
    findings += environment_problems(
        [("the environment", os.environ), ("a control environment", CONTROL_ENVIRONMENT)]
    )
    findings += cargo_config_problems(
        [
            ("the copy's cargo configuration", cargo_config_files(copy)),
            ("a control configuration", [copy / rel for rel in CONTROL_CARGO_CONFIGS]),
        ]
    )
    found, stack = zeroize_check(copy)
    findings += found

    failures, problems = match_controls(findings, planted)
    for text in [problem.text for problem in problems] + failures:
        print(f"FAIL: {text}", file=sys.stderr)
    calls = sum(not r.path.is_relative_to(guard) for r in forced_reports)
    unreported = sum(1 for f in findings if f.check == "probe" and f.where != CONTROL_PROBE[1])
    print(
        f"the tree: {calls} reports with --force-warn, {sum(allows.values())} accepted"
        f" allows ({allows['fn']} on functions, {allows['statement']} on statements), in {read}"
        f" files of its {len(crates) - 1} crates (a copy of {count} files)"
    )
    print(f"probes: {len(spans) - 1 - unreported} of {len(spans) - 1} reported with --force-warn")
    print(f"controls: {len(planted)}, {len(failures)} not as planted")
    print(f"zeroize: {', '.join(stack)}")
    return 1 if failures or problems else 0


def main() -> int:
    # Line-buffered, so the FAIL lines on stderr keep their place among these
    # lines when both streams go to one log.
    sys.stdout.reconfigure(line_buffering=True)
    for stop in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(stop, _stop)
    # The workflow's toolchain action exports CARGO_TERM_COLOR=always to the
    # steps after it, and under it cargo tree writes escape codes into its
    # lines. Set for every command the guard starts, it makes a read that the
    # setting changes fail on every machine, not only in CI.
    os.environ["CARGO_TERM_COLOR"] = "always"
    metadata, error = cargo_metadata(ROOT, "--locked")
    if metadata is None:
        sys.exit(f"error: cargo metadata failed:\n{error}")
    print(f"crates the wasm build compiles: {', '.join(sorted(adapter_build(metadata)[1]))}")
    copy = Path(tempfile.mkdtemp(prefix="wasm-clippy-guard-"))
    try:
        status = check(metadata, copy)
    finally:
        shutil.rmtree(copy, ignore_errors=True)
    return 0 if status == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
