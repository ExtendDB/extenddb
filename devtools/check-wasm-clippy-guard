def read_config() -> tuple[dict[str, list[str]], list[str]]:
    """The entry paths of each list in clippy.toml, and the problems found."""
    problems = []
    try:
        config = tomllib.loads(CONFIG.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as error:
        return {}, [f"{CONFIG_REL}: cannot be read: {error}"]
    paths = {}
    for key, value in config.items():
        if key not in KINDS:
            problems.append(
                f"{CONFIG_REL}: unexpected key {key!r}; this script checks only {sorted(KINDS)}"
            )
            continue
        if not isinstance(value, list):
            problems.append(f"{CONFIG_REL}: {key} is not a list")
            continue
        paths[key] = []
        for entry in value:
            if (
                not isinstance(entry, dict)
                or set(entry) != {"path", "reason"}
                or not all(isinstance(entry[k], str) and entry[k].strip() for k in entry)
            ):
                problems.append(
                    f"{CONFIG_REL}: {key} entry {entry!r} is not a table of exactly a"
                    " non-empty `path` and `reason`"
                )
                continue
            paths[key].append(entry["path"])
    for key, (kind, probes) in KINDS.items():
        listed = paths.get(key, [])
        if len(listed) != len(set(listed)):
            problems.append(f"{CONFIG_REL}: {key} lists a path more than once")
        for path in listed:
            if path not in probes:
                problems.append(f"{path}: listed in {key} but has no {kind} probe in this script")
        for path in probes:
            if path not in listed:
                problems.append(f"{path}: has a {kind} probe but is not listed in {key}")
    return paths, problems


def cargo_metadata() -> dict:
    try:
        run = subprocess.run(
            ["cargo", "metadata", "--format-version", "1", "--locked", "--filter-platform", TARGET],
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        sys.exit("error: cargo is not on PATH")
    if run.returncode != 0:
        sys.exit(f"error: cargo metadata failed:\n{run.stderr}")
    return json.loads(run.stdout)


def wasm_crates(metadata: dict) -> dict[str, dict]:
    """The workspace packages the adapter's wasm32 build compiles, by name."""
    members = set(metadata["workspace_members"])
    packages = {p["id"]: p for p in metadata["packages"]}
    nodes = {n["id"]: n for n in metadata["resolve"]["nodes"]}
    start = [i for i in members if packages[i]["name"] == ADAPTER]
    if not start:
        sys.exit(f"error: cargo metadata lists no workspace member named {ADAPTER}")
    seen, todo = set(), start
    while todo:
        package = todo.pop()
        if package in seen:
            continue
        seen.add(package)
        # --filter-platform already dropped dependencies of other targets;
        # kind None is a normal dependency.
        todo += [
            d["pkg"]
            for d in nodes[package]["deps"]
            if any(k["kind"] is None for k in d["dep_kinds"])
        ]
    return {packages[i]["name"]: packages[i] | {"node": nodes[i]} for i in seen if i in members}


# ---------------------------------------------------------------- lint settings

_SCAN = re.compile(r'//|/\*|(?<!\w)(?:b|c)?r#*"|(?<!\w)(?:b|c)?"|\'')
_CHAR = re.compile(r"'(?:\\(?:u\{[0-9A-Fa-f]{1,6}\}|x[0-9A-Fa-f]{2}|.)|[^\\'\n])'")


def code_only(text: str) -> str:
    """`text` with comments and the contents of string and character literals
    blanked (line breaks kept), so offsets and line numbers still match."""
    out = []
    i = 0
    n = len(text)

    def blank(a: int, b: int) -> None:
        out.append(re.sub(r"[^\n]", " ", text[a:b]))

    while True:
        match = _SCAN.search(text, i)
        if not match:
            out.append(text[i:])
            break
        start = match.start()
        out.append(text[i:start])
        token = match.group()
        if token == "//":
            end = text.find("\n", start)
            end = n if end < 0 else end
            blank(start, end)
        elif token == "/*":
            depth, end = 1, start + 2
            while end < n and depth:
                if text.startswith("/*", end):
                    depth, end = depth + 1, end + 2
                elif text.startswith("*/", end):
                    depth, end = depth - 1, end + 2
                else:
                    end += 1
            blank(start, end)
        elif token == "'":
            char = _CHAR.match(text, start)
            end = char.end() if char else start + 1  # a lifetime or a label
            out.append(text[start] + re.sub(r"[^\n]", " ", text[start + 1 : end - 1]))
            if char:
                out.append("'")
        elif token.endswith('"') and "r" in token:
            hashes = token.count("#")
            close = text.find('"' + "#" * hashes, match.end())
            close = n if close < 0 else close
            end = min(n, close + 1 + hashes)
            out.append(token)
            blank(match.end(), close)
            out.append(text[close:end])
        else:
            end = match.end()
            while end < n and text[end] != '"':
                end += 2 if text[end] == "\\" else 1
            out.append(token)
            blank(match.end(), end)
            out.append(text[end : end + 1])
            end += 1
        i = end
    return "".join(out)


def _closing(code: str, start: int, opening: str, closing: str) -> int:
    """The index just past the bracket that closes the one at `start`."""
    depth = 0
    for index in range(start, len(code)):
        if code[index] == opening:
            depth += 1
        elif code[index] == closing:
            depth -= 1
            if depth == 0:
                return index + 1
    return len(code)


_ATTRIBUTE = re.compile(r"#\s*!?\s*\[")
_LINT_LIST = re.compile(r"\b(allow|expect|warn)\s*\(")
_NEXT_ATTRIBUTE = re.compile(r"\s*#\s*\[")
_MOD = re.compile(r"\s*(?:pub\s*(?:\([^)]*\))?\s*)?mod\s+([A-Za-z_][A-Za-z0-9_]*)\s*;")
_RAW = re.compile(r"(?:^|(?<=::))r#")


def lint_name(item: str) -> str:
    """An item of a lint list as rustc reads the lint's name: without
    whitespace, and with a raw identifier (`r#all`) read as the plain one."""
    return _RAW.sub("", re.sub(r"\s", "", item))


def attribute_problems(rel: str, text: str, used_migration: set) -> tuple[list[str], int]:
    """Problems in the lint attributes of one file, and how many of its
    attributes allow a disallowed lint with a reason. `used_migration` collects
    the migration code-body modules whose allow of clippy::all is accepted."""
    code = code_only(text)
    problems, reasoned = [], 0
    for attribute in _ATTRIBUTE.finditer(code):
        end = _closing(code, attribute.end() - 1, "[", "]")
        body = code[attribute.start() : end]
        line = code.count("\n", 0, attribute.start()) + 1
        for lint_list in _LINT_LIST.finditer(body):
            close = _closing(body, lint_list.end() - 1, "(", ")")
            # The items of the list, as (start, end) offsets into `code`.
            items, depth, start = [], 0, lint_list.end()
            for index in range(lint_list.end(), close - 1):
                if body[index] in "([{":
                    depth += 1
                elif body[index] in ")]}":
                    depth -= 1
                elif body[index] == "," and depth == 0:
                    items.append((attribute.start() + start, attribute.start() + index))
                    start = index + 1
            items.append((attribute.start() + start, attribute.start() + close - 1))
            names = {lint_name(code[a:b]) for a, b in items} - {""}
            reasons = [reason_value(text, code, a, b) for a, b in items]
            reasons = [r for r in reasons if r is not None]
            has_reason = any(r.strip() for r in reasons)
            level = lint_list.group(1)
            blanket = sorted(names & BLANKET)
            if blanket:
                declared = _declared_module(code, end)
                if is_migration_module(rel, code, attribute.start(), declared, level, names):
                    used_migration.add((rel, declared))
                else:
                    problems.append(
                        f"{rel}:{line}: {level}({', '.join(blanket)}) sets lints the wasm"
                        " clippy guard needs below deny for the code it covers; name only"
                        " the lints the code needs (only a catalog migration's code-body"
                        " module, declared as CONTRIBUTING.md prescribes, may allow"
                        " clippy::all)"
                    )
            never = sorted(names & NEVER)
            if never:
                problems.append(
                    f"{rel}:{line}: {level}({', '.join(never)}) sets below deny the lint that"
                    " reports a std lock guard or a RefCell borrow held across an .await,"
                    " which traps on wasm32 when another task takes it; hold none across an"
                    " .await (no reason makes this setting acceptable)"
                )
            disallowed = sorted(names & NEED_REASON)
            if disallowed and level == "warn":
                problems.append(
                    f"{rel}:{line}: warn({', '.join(disallowed)}) sets a disallowed lint"
                    " below deny; only an allow or expect with a reason may, on a call that"
                    " never runs on wasm"
                )
            elif disallowed and not has_reason:
                empty = " is empty or only whitespace" if reasons else " is missing"
                problems.append(
                    f"{rel}:{line}: {level}({', '.join(disallowed)}): its `reason = \"...\"`"
                    f"{empty}; it must name the callers and why none runs on wasm"
                )
            elif disallowed:
                inner = "!" in code[attribute.start() : attribute.end()]
                covered = None if inner else _covered_item(code, end)
                if inner or covered:
                    where = (
                        "an inner attribute, which covers all of the module, crate or function"
                        " it is in"
                        if inner
                        else f"on {covered}, which covers every function in it"
                    )
                    problems.append(
                        f"{rel}:{line}: {level}({', '.join(disallowed)}) is {where}; put it, as"
                        " an outer attribute, on the function or the one statement that never"
                        " runs on wasm"
                    )
                else:
                    reasoned += 1
    return problems, reasoned


# An item that an outer attribute covers as a whole, with every function in it:
# a module, an impl block or a trait.
_COVERING_ITEM = re.compile(
    r"\s*(?:pub\s*(?:\([^)]*\))?\s*)?(?:(?:unsafe|auto|default)\s+)*(mod|impl|trait)\b"
)
_COVERING_NAMES = {"mod": "a module", "impl": "an impl block", "trait": "a trait"}


def _covered_item(code: str, index: int) -> str | None:
    """What an outer attribute ending at `index` is on, after any further
    attributes, when that is a module, an impl block or a trait; None when it
    is another item, a statement or an expression."""
    while match := _NEXT_ATTRIBUTE.match(code, index):
        index = _closing(code, match.end() - 1, "[", "]")
    match = _COVERING_ITEM.match(code, index)
    return _COVERING_NAMES[match.group(1)] if match else None


_REASON = re.compile(r'\s*reason\s*=\s*(?:(r)(#*))?"')
_ESCAPE = re.compile(r"\\(?:x([0-9A-Fa-f]{2})|u\{([0-9A-Fa-f_]{1,8})\}|\n[ \t\r\n]*|(.))", re.S)
_SIMPLE_ESCAPES = {"n": "\n", "r": "\r", "t": "\t", "\\": "\\", "0": "\0", "'": "'", '"': '"'}


def reason_value(text: str, code: str, start: int, end: int) -> str | None:
    """The text of the string literal in a `reason = "..."` item of a lint list,
    the item being code[start:end], or None when the item is not one. `code` is
    `text` with comments and literal contents blanked, so the literal's quotes
    are found in `code` and its contents read from `text`; escapes are decoded,
    a raw string's contents are taken as written."""
    match = _REASON.match(code, start, end)
    if not match:
        return None
    raw, hashes = match.group(1), match.group(2) or ""
    close = code.find('"' + hashes if raw else '"', match.end(), end)
    if close < 0:
        return None
    contents = text[match.end() : close]
    return contents if raw else _ESCAPE.sub(_unescape, contents)


def _unescape(escape: re.Match) -> str:
    """The character one escape of a Rust string literal stands for; a line
    continuation (a backslash at the end of a line, and the next line's
    indentation) stands for nothing."""
    hex_byte, code_point, simple = escape.groups()
    try:
        if hex_byte:
            return chr(int(hex_byte, 16))
        if code_point:
            return chr(int(code_point.replace("_", ""), 16))
    except ValueError:  # not a character; rustc refuses the literal
        return escape.group()
    if simple is not None:
        return _SIMPLE_ESCAPES.get(simple, escape.group())
    return ""


def is_migration_module(
    rel: str, code: str, start: int, declared: str | None, level: str, names: set
) -> bool:
    """Whether the attribute at `start` is the allow CONTRIBUTING.md prescribes
    for a catalog migration's code-body module: `allow(clippy::all,
    deprecated)` and nothing else, on a `mod mNNNN_<name>;` line of a
    src/migrations/mod.rs that also carries #[rustfmt::skip], with the module's
    file beside it."""
    if level != "allow" or names != MIGRATION_ALLOW or declared is None:
        return False
    path = Path(rel)
    if path.name != "mod.rs" or path.parent.name != "migrations" or path.parent.parent.name != "src":
        return False
    if not MIGRATION_MODULE.fullmatch(declared):
        return False
    if not (ROOT / path.parent / f"{declared}.rs").is_file():
        return False
    # The attributes of the item: from the end of the previous item (or the
    # start of the file) to the `mod` keyword.
    item_start = max(code.rfind(";", 0, start), code.rfind("}", 0, start)) + 1
    mod_at = code.find("mod", start)
    return re.search(r"#\s*\[\s*rustfmt\s*::\s*skip\s*\]", code[item_start:mod_at]) is not None


def _declared_module(code: str, index: int) -> str | None:
    """The module a `mod name;` item after more attributes at `index` declares."""
    while match := _NEXT_ATTRIBUTE.match(code, index):
        index = _closing(code, match.end() - 1, "[", "]")
    match = _MOD.match(code, index)
    return match.group(1) if match else None


def lint_table_problems(manifest: str, table: dict) -> list[str]:
    """Problems in one `[lints]` (or `[workspace.lints]`) table of `manifest`.
    Cargo passes a key spelt with hyphens to rustc, which reads them as
    underscores, so the keys are compared that way."""
    problems = []
    for tool, lints in table.items():
        if not isinstance(lints, dict):
            continue
        for name, setting in lints.items():
            level = setting.get("level") if isinstance(setting, dict) else setting
            name = name.replace("-", "_")
            lint = name if tool == "rust" else f"{tool.replace('-', '_')}::{name}"
            if level not in ("deny", "forbid") and lint in BLANKET | NEED_REASON | NEVER:
                problems.append(
                    f"{manifest}: [lints] sets {lint} to {level!r}, below deny, which the"
                    " wasm clippy guard refuses for the lints it needs"
                )
    return problems


# A rustc flag that sets a lint level below deny or caps lint levels, in each
# spelling (the value after it, attached to it, or after `=`), and the flags
# that can carry one: a -Z option (-Z crate-attr adds a crate-level attribute,
# where the compiler accepts -Z options) and an @-file of further arguments.
_LOWERING_FLAG = re.compile(r"-[AWZ]|--(?:allow|warn|force-warn|cap-lints)(?:=|$)|@")
# Cargo configuration keys that run another program as the compiler, which can
# pass it any flag.
_COMPILER_KEYS = ("rustc", "rustc-wrapper", "rustc-workspace-wrapper")


def _rustflags_settings(settings: dict, keys: tuple = ()):
    """Each `rustflags` setting of a cargo configuration, in any table, with
    its dotted key."""
    for key, value in settings.items():
        if key == "rustflags":
            yield ".".join(keys + (key,)), value
        elif isinstance(value, dict):
            yield from _rustflags_settings(value, keys + (key,))


def rustflags_problems(config: str, settings: dict) -> list[str]:
    """Problems in the rustflags, in any table, and the compiler settings of one
    cargo configuration file `config`."""
    problems = []
    for key, flags in _rustflags_settings(settings):
        if isinstance(flags, str):
            flags = flags.split()
        lowering = [f for f in flags if isinstance(f, str) and _LOWERING_FLAG.match(f)]
        if lowering:
            problems.append(
                f"{config}: {key} holds {lowering!r}, which can set lint levels below deny"
                " or cap them, and the wasm clippy guard refuses"
            )
    build = settings.get("build", {})
    for key in _COMPILER_KEYS:
        if isinstance(build, dict) and key in build:
            problems.append(
                f"{config}: build.{key} = {build[key]!r} runs another program as the"
                " compiler, which can pass it any lint flag; the wasm clippy guard refuses it"
            )
    return problems


# Workflow variables that set the wasm build's rustc flags (RUSTFLAGS,
# CARGO_ENCODED_RUSTFLAGS, CARGO_BUILD_RUSTFLAGS, CARGO_TARGET_<TRIPLE>_RUSTFLAGS)
# or its compiler or compiler wrapper.
_WORKFLOW_VARIABLE = re.compile(
    r"\b(?:[A-Z0-9_]*RUSTFLAGS|RUSTC|RUSTC_WRAPPER|RUSTC_WORKSPACE_WRAPPER"
    r"|CARGO_BUILD_RUSTC|CARGO_BUILD_RUSTC_WRAPPER|CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER)\b"
)


def _without_comment(line: str) -> str:
    """`line` up to a `#` that starts a YAML or shell comment: one at the start
    of the line or after whitespace, outside quotes."""
    quote = None
    for index, char in enumerate(line):
        if quote:
            quote = None if char == quote else quote
        elif char in "'\"":
            quote = char
        elif char == "#" and (index == 0 or line[index - 1].isspace()):
            return line[:index]
    return line


def workflow_problems(workflow: str, text: str) -> list[str]:
    """Problems in the lines `text` of the workflow file `workflow`: a line that,
    outside its comment, names a variable that sets rustc flags or the compiler.
    The file is read as text, so a step's env, a run script and a write to
    $GITHUB_ENV are all seen."""
    problems = []
    for number, line in enumerate(text.splitlines(), 1):
        for name in _WORKFLOW_VARIABLE.findall(_without_comment(line)):
            problems.append(
                f"{workflow}:{number}: names {name}, which sets the flags or the compiler"
                " of the steps it reaches and can lower the lints the wasm clippy guard"
                " needs; the guard refuses it in this workflow"
            )
    return problems


def manifest_problems(crates: dict[str, dict], metadata: dict) -> list[str]:
    problems = []
    root_manifest = Path(metadata["workspace_root"]) / "Cargo.toml"
    workspace = tomllib.loads(root_manifest.read_text(encoding="utf-8")).get("workspace", {})
    tables = [(root_manifest, workspace.get("lints", {}))]
    for package in crates.values():
        manifest = Path(package["manifest_path"])
        lints = tomllib.loads(manifest.read_text(encoding="utf-8")).get("lints", {})
        tables.append((manifest, lints))
    for manifest, table in tables:
        problems += lint_table_problems(str(manifest.relative_to(ROOT)), table)
    for name in ("config.toml", "config"):
        config = ROOT / ".cargo" / name
        if not config.is_file():
            continue
        settings = tomllib.loads(config.read_text(encoding="utf-8"))
        problems += rustflags_problems(f".cargo/{name}", settings)
    try:
        workflow = (ROOT / WORKFLOW_REL).read_text(encoding="utf-8")
    except OSError as error:
        return problems + [f"{WORKFLOW_REL}: cannot be read: {error}"]
    return problems + workflow_problems(WORKFLOW_REL, workflow)


class Compiled(NamedTuple):
    """What compiled_files found: the files and the environment variables that
    each crate's dep-info lists, the clippy step's compiler messages, and the
    problems."""

    files: dict[str, list[Path]]
    envs: dict[str, dict[str, str]]
    messages: list[dict]
    problems: list[str]


def compiled_files(crates: dict[str, dict], root: Path, target_dir: str) -> Compiled:
    """The files rustc reads to compile each of `crates`, and the problems
    found. It runs the clippy step in the tree at `root` (the working tree or a
    copy of it) and reads, for each crate, the dep-info file that rustc writes
    next to the metadata file cargo's compiler-artifact record names: every
    source file of the crate wherever it is (a module that #[path] names
    included), every file include!, include_str! or include_bytes! reads, and
    the Cargo.toml and the clippy configuration that clippy adds, which are
    left out. rustc writes the dep-info of a crate whose lints then fail as
    well, but cargo names no artifact for that crate, so it is not read. A
    crate with no dep-info read is a problem, and so is a listed file that
    does not exist."""
    code, messages, artifacts, stderr = run_clippy(root, target_dir)
    root = root.resolve()
    by_manifest = {
        Path(package["manifest_path"]).relative_to(ROOT): name for name, package in crates.items()
    }
    files, envs, problems = {}, {}, []
    for artifact in artifacts:
        manifest = Path(artifact["manifest_path"]).resolve()
        if not manifest.is_relative_to(root) or "custom-build" in artifact["target"]["kind"]:
            continue
        name = by_manifest.get(manifest.relative_to(root))
        for output in map(Path, artifact["filenames"] if name else []):
            dep_info = output.with_name(output.name.removeprefix("lib")).with_suffix(".d")
            if dep_info.is_file():
                files[name], envs[name] = read_dep_info(dep_info, root)
                break
    for name in sorted(set(crates) - set(files)):
        problems.append(
            f"{name}: the clippy step in {root} left no dep-info for it, so the files it"
            " compiles were not read"
        )
    if code != 0:
        errors = [m.get("rendered") or m["message"] for m in messages if m["level"] == "error"]
        problems.append(
            f"the clippy step failed in {root} (exit status {code}):\n"
            + ("\n".join(errors) or stderr)
        )
    for name, paths in sorted(files.items()):
        missing = [path for path in paths if not path.is_file()]
        problems += [f"{path}: in the dep-info of {name}, but missing" for path in missing]
    return Compiled(files, envs, messages, problems)


def read_dep_info(dep_info: Path, root: Path) -> tuple[list[Path], dict[str, str]]:
    """The files a rustc dep-info file lists, other than the Cargo.toml and
    the clippy configuration that clippy adds to it, and the environment
    variables it records (`# env-dep:NAME=VALUE`): those the compilation
    tracks, which include each that the crate reads with env! or option_env!
    and the CLIPPY_ARGS and CLIPPY_CONF_DIR that clippy-driver reads. rustc
    writes a line `<file>:` for each file, with a space in the name written
    `\\ `; a relative name is relative to `root`, where cargo ran rustc."""
    found, env = [], {}
    for line in dep_info.read_text(encoding="utf-8").splitlines():
        if line.startswith("# env-dep:"):
            name, _, value = line.removeprefix("# env-dep:").partition("=")
            env[name] = value
        if line.startswith("#") or not line.endswith(":"):
            continue
        path = Path(os.path.normpath(root / line[:-1].replace("\\ ", " ")))
        if path.name not in ("Cargo.toml", "clippy.toml", ".clippy.toml"):
            found.append(path)
    return found, env


def driver_problems(envs: dict[str, dict[str, str]], messages: list[dict]) -> list[str]:
    """Problems in what clippy-driver ran with for each crate of the clippy
    step, as `envs` (the variables each crate's dep-info records) holds it, and
    in the step's reports `messages`: CLIPPY_ARGS that is not recorded, holds
    a flag that sets a lint level below deny or caps lint levels, or does not
    deny warnings; CLIPPY_CONF_DIR that is not recorded or names another
    directory than devtools/wasm-clippy; and a report of a disallowed or
    await-holding lint at a level other than error, which lets the step pass."""
    problems = []
    for name, env in sorted(envs.items()):
        if "CLIPPY_ARGS" not in env:
            problems.append(f"{name}: its dep-info records no CLIPPY_ARGS for clippy-driver")
        else:
            args = [arg for arg in env["CLIPPY_ARGS"].split(CLIPPY_ARGS_SEPARATOR) if arg]
            lowering = [arg for arg in args if _LOWERING_FLAG.match(arg)]
            if lowering or not _denies_warnings(args):
                problems.append(
                    f"{name}: clippy-driver ran with CLIPPY_ARGS {args!r}, which"
                    f" {f'holds {lowering!r}' if lowering else 'does not deny warnings'};"
                    " a build script's cargo::rustc-env, or an [env] entry with force = true"
                    " in the cargo configuration, can set it for a crate"
                )
        conf = env.get("CLIPPY_CONF_DIR")
        if not conf or Path(conf).resolve() != CONF_DIR.resolve():
            problems.append(
                f"{name}: clippy-driver read CLIPPY_CONF_DIR {conf!r}, not {CONF_DIR}, so the"
                f" lists of {CONFIG_REL} did not apply to it; a build script's"
                " cargo::rustc-env, or an [env] entry with force = true, can set it"
            )
    for message in messages:
        lint = (message.get("code") or {}).get("code")
        if lint in GUARD_LINTS and message.get("level") != "error":
            spans = [s for s in message.get("spans", []) if s.get("is_primary")]
            where = f"{spans[0]['file_name']}:{spans[0]['line_start']}: " if spans else ""
            problems.append(
                f"{where}clippy reports {lint} as a {message.get('level')}, which lets the"
                f" clippy step pass; a setting lowers the lint there: {message['message']}"
            )
    return problems


# The lints whose reports the clippy step must give as errors.
GUARD_LINTS = NEED_REASON | NEVER


def _denies_warnings(args: list[str]) -> bool:
    """Whether the rustc arguments `args` deny or forbid warnings."""
    for arg, following in zip(args, args[1:] + [None]):
        if arg in ("-D", "--deny", "-F", "--forbid") and following == "warnings":
            return True
        if arg in ("-Dwarnings", "-Fwarnings", "--deny=warnings", "--forbid=warnings"):
            return True
    return False


def lint_setting_problems(crates: dict[str, dict], metadata: dict) -> tuple[list[str], str]:
    used_migration, reasoned, read = set(), 0, set()
    compiled = compiled_files(crates, ROOT, metadata["target_directory"])
    files, problems = compiled.files, compiled.problems
    problems += driver_problems(compiled.envs, compiled.messages)
    for name in sorted(files):
        for path in files[name]:
            if path in read or not path.is_file():
                continue
            read.add(path)
            rel = path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else str(path)
            # A file include_str! or include_bytes! reads is read as Rust source
            # too: the dep-info does not say which macro read a file, and
            # include! takes a file of any name.
            text = path.read_bytes().decode("utf-8", errors="replace")
            found, reasons = attribute_problems(rel, text, used_migration)
            problems += found
            reasoned += reasons
    problems += manifest_problems(crates, metadata)
    summary = (
        f"lint settings: {len(read)} files of {len(crates)} crates read (from their"
        f" dep-info); {len(used_migration)} migration code-body modules allow clippy::all;"
        f" {reasoned} allows of a disallowed lint, each with a reason"
    )
    return problems, summary


