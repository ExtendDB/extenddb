def _plant(
    copy: Path, path: Path, text: str, append: bool = False, write: bool = True
) -> list[Finding]:
    """Write `text` to a new file of the copy at `path` (a path of the working
    tree), or append it to the copy's file there; with `write` false, only find
    whether that can be done. It cannot when the working tree already uses the
    new file's name, when the file appended to holds what `text` adds (_held),
    or when a write would follow a symbolic link out of the copy (_leaves_copy):
    then nothing is written, and the finding says why."""
    rel = Path(os.path.relpath(path, ROOT))
    if found := _leaves_copy(copy, rel):
        return found
    if not append and os.path.lexists(path):
        return [Finding("plant", rel.as_posix(), f"{rel} exists; the guard plants a file there")]
    if append and (held := _held(copy, rel, text)):
        return [Finding("plant", rel.as_posix(), f"{rel} {held}; the guard writes nothing to it")]
    if write:
        (copy / rel).parent.mkdir(parents=True, exist_ok=True)
        with open(copy / rel, "a" if append else "w", encoding="utf-8") as file:
            file.write(text)
    return []


def _leaves_copy(copy: Path, rel: Path) -> list[Finding]:
    """A finding when the copy's path `rel`, or a directory on the way to it,
    is a symbolic link that leads out of the copy. copy_tree copies a link as
    the link it is, so a write there would change a file outside the copy,
    the caller's working tree among them."""
    if (copy / rel).resolve().is_relative_to(copy.resolve()):
        return []
    where = Path(rel).as_posix()
    text = f"{where} leads out of the copy through a symbolic link; the guard writes nothing to it"
    return [Finding("plant", where, text)]


def _held(copy: Path, rel: Path, text: str) -> str | None:
    """What the copy's Rust file `rel` already holds of what appending `text`
    adds, or None: for a module that a `mod <name>;` line of `text` declares,
    a use of its name in the file's code, or a <name>.rs or <name>/mod.rs
    beside the file in the working tree."""
    current = (copy / rel).read_text(encoding="utf-8")
    code = code_only(current)
    for name in re.findall(r"^mod (\w+);$", text, re.M):
        if use := re.search(rf"\b{name}\b", code):
            line = code.count("\n", 0, use.start()) + 1
            held = current.splitlines()[line - 1].strip()
            return f"uses `{name}` at line {line} ({held}), the name of a module the guard adds"
        for file in (rel.parent / f"{name}.rs", rel.parent / name / "mod.rs"):
            if os.path.lexists(ROOT / file):
                return f"has {file.as_posix()} beside it, a file of a module the guard adds"
    return None


def _own_crate_plants(name: str, package: dict) -> dict[str, list[tuple[Path, str, bool]]]:
    """The plants (path, text, append) in the crate `name` of each control that
    goes into a crate of its own, which can take it when the list is not empty
    and _plant can make each of them: no plant of BUILD_SCRIPT goes into
    PROBE_CRATE or into a crate with a build script."""
    root, manifest = lib_root(package), Path(package["manifest_path"])
    unfit = name == PROBE_CRATE or any("custom-build" in t["kind"] for t in package["targets"])
    return {
        "BUILD_SCRIPT": [] if unfit else [(manifest.parent / "build.rs", BUILD_SCRIPT, False)],
        "MIGRATIONS_CONTROLS": [
            *((root.parent / "migrations" / n, t, False) for n, t in MIGRATIONS_CONTROLS.items()),
            (root, "\n#[allow(dead_code)]\nmod migrations;\n", True),
        ],
    }


def plant_controls(copy: Path, crates: dict[str, dict]) -> tuple[list[Control], set, list[Finding]]:
    """Plant the controls in the copy at `copy`. Returns them, the files that
    hold them, and a finding for each that cannot be planted."""
    probe_root = lib_root(crates[PROBE_CRATE])
    sources = {
        probe_root.parent / f"{CONTROL_MODULE}.rs": CONTROLS,
        probe_root.parent.parent / CONTROL_MODULE / "outside_src.rs": OTHER_FILE_CONTROLS.format(
            name="path"
        ),
        probe_root.parent / f"{CONTROL_MODULE}.inc": OTHER_FILE_CONTROLS.format(name="include"),
        probe_root.parent / f"{RELEASE_MODULE}.rs": RELEASE_CONTROL,
        ROOT / CONTROL_CARGO_CONFIG: '[build]\nrustc-wrapper = "wasm-clippy-guard-control"\n',
    }
    appends = [(probe_root, f"\n#[allow(dead_code)]\nmod {CONTROL_MODULE};\n")]
    found, hosts = [], {}
    # The controls that go into a crate of their own (the docstring's item 6).
    for control in ("BUILD_SCRIPT", "MIGRATIONS_CONTROLS"):
        unfit = []
        for name, package in sorted(crates.items()):
            plants = _own_crate_plants(name, package)[control]
            clashes = [f.text for plant in plants for f in _plant(copy, *plant, write=False)]
            if plants and not clashes:
                hosts[control] = name
                for path, text, append in plants:
                    if append:
                        appends.append((path, text))
                    else:
                        sources[path] = text
                break
            unfit += clashes[:1] or [f"{name} is {PROBE_CRATE} or has a build script"]
        else:
            why = "".join(f"\n  {reason}" for reason in unfit)
            found.append(Finding("plant", control, f"no crate of the build takes {control}:{why}"))
    found += [f for path, text in sources.items() for f in _plant(copy, path, text)]
    for path, text in appends:
        found += _plant(copy, path, text, append=True)
    config = copy / CONFIG_REL
    current = config.read_text(encoding="utf-8")
    text, count = re.subn(
        r"^disallowed-methods = \[\n",
        lambda m: f'{m.group()}    {{ path = "{CONTROL_ENTRY}", reason = "a control" }},\n',
        current,
        count=1,
        flags=re.M,
    )
    if leaves := _leaves_copy(copy, Path(CONFIG_REL)):
        found += leaves
    elif CONTROL_ENTRY in current:
        found.append(Finding("plant", CONFIG_REL, f"{CONFIG_REL} names {CONTROL_ENTRY} already"))
    elif count != 1:
        found.append(Finding("plant", CONFIG_REL, f"{CONFIG_REL}: no `disallowed-methods = [`"))
    else:
        config.write_text(text, encoding="utf-8")

    controls = []
    for path, text in sources.items():
        rel, opened = Path(os.path.relpath(path, ROOT)).as_posix(), {}
        for number, line in enumerate(text.splitlines(), 1):
            for name, mark in _MARK.findall(line):
                if mark == "accepted":
                    opened[name] = number
                elif mark == "end":
                    lines = range(opened.pop(name), number + 1)
                    controls.append(Control(name, None, rel, lines=lines))
                else:
                    controls.append(Control(name, mark, f"{rel}:{number}"))
    control_config = str(copy / CONTROL_CARGO_CONFIG)
    controls += [
        Control("unlisted probe", "entries", CONTROL_PROBE[1], "not listed"),
        Control("unlisted probe", "probe", CONTROL_PROBE[1]),
        Control("unresolved entry", "entries", CONTROL_ENTRY, "no method probe"),
        Control("unresolved entry", "clippy.toml warning", CONTROL_ENTRY),
        Control("build script", "dep-info", hosts.get("BUILD_SCRIPT", ""), "CLIPPY_ARGS"),
        Control("build script", "dep-info", hosts.get("BUILD_SCRIPT", ""), "CLIPPY_CONF_DIR"),
        Control("environment", "examined", "the environment"),
        Control("environment", "examined", "a control environment"),
        Control("environment", "environment", "a control environment", "RUSTC_WRAPPER"),
        Control("cargo configuration", "examined", "the copy's cargo configuration"),
        Control("cargo configuration", "examined", "a control configuration"),
        Control("cargo configuration", "cargo configuration", control_config, "rustc-wrapper"),
        Control("zeroize", "examined", "the adapter's wasm32 build"),
        Control("zeroize", "examined", "control: ghash without its zeroize feature"),
        Control("zeroize", "examined", "control: a second ghash"),
        Control("zeroize", "zeroize", "control: ghash without its zeroize feature: ghash", "built"),
        Control("zeroize", "zeroize", "control: a second ghash: ghash", " packages ("),
    ]
    controls += [
        Control("dep-info", "examined", f"{crate} ({run})")
        for crate in sorted(crates)
        for run in ("without options", "with --force-warn")
    ]
    return controls, {Path(os.path.relpath(p, ROOT)).as_posix() for p in sources}, found


def plant_probes(copy: Path, crates: dict[str, dict]) -> tuple[Path, list[tuple], list[Finding]]:
    """Add every probe, and CONTROL_PROBE, to a new module of PROBE_CRATE in the
    copy, and declare the module of RELEASE_CONTROL. Returns the probes' file,
    the kind, path and line of each probe, and findings."""
    root = lib_root(crates[PROBE_CRATE])
    probes = [(kind, *entry) for kind, table in KINDS.values() for entry in table.items()]
    lines = ["// Probes of devtools/check-wasm-clippy-guard, in its copy of the tree only."]
    spans = []
    for kind, path, items in probes + [(*CONTROL_PROBE[:2], [CONTROL_PROBE[2]])]:
        for item in items:
            lines += [f"mod probe_{len(spans)} {{", item, "}"]
            spans.append((kind, path, len(lines) - 1))
    found = _plant(copy, root.parent / f"{PROBE_MODULE}.rs", "\n".join(lines) + "\n")
    # warnings: no lint the run does not force to warn may fail it.
    found += _plant(copy, root, f"\n#[allow(warnings)]\nmod {PROBE_MODULE};\n", append=True)
    found += _plant(copy, root, f"\n#[allow(dead_code)]\nmod {RELEASE_MODULE};\n", append=True)
    return copy / Path(os.path.relpath(root.parent, ROOT)) / f"{PROBE_MODULE}.rs", spans, found


def match_controls(findings: list[Finding], controls: list[Control]) -> tuple[list, list]:
    """The controls that did not behave as planted, and the findings no control
    expects (the problems)."""
    failures, expected = [], set()
    for control in controls:
        if control.check is None:
            for finding in findings:
                file, _, line = finding.where.rpartition(":")
                if file == control.where and line.isdigit() and int(line) in control.lines:
                    failures.append(f"control {control.name} must be accepted: {finding.text}")
                    expected.add(finding)
            continue
        hits = [
            f
            for f in findings
            if (f.check, f.where) == (control.check, control.where) and control.expect in f.text
        ]
        if not hits:
            failures.append(
                f"control {control.name}: the {control.check} check reported nothing at"
                f" {control.where}"
            )
        expected.update(hits)
    return failures, [f for f in findings if f not in expected]


def _stop(signum: int, _frame) -> None:
    raise SystemExit(128 + signum)


def check(crates: dict[str, dict], target_dir: str, copy: Path) -> int:
    files = copy_tree(copy)
    controls, planted, findings = plant_controls(copy, crates)
    # Each dep-info is read before the next run, which writes the same files.
    plain = run_clippy(copy, target_dir, [])
    read_plain, found = dep_info(plain, crates, copy, "without options")
    findings += found
    if plain.code != 0:
        return unfinished(plain, "without options", read_plain, crates, findings)
    probe_file, spans, found = plant_probes(copy, crates)
    findings += found
    forced = run_clippy(copy, target_dir, FORCE_WARN)
    read_forced, found = dep_info(forced, crates, copy, "with --force-warn")
    findings += found
    if forced.code != 0:
        return unfinished(forced, "with --force-warn", read_forced, crates, findings)
    findings += driver_problems(read_plain, read_forced, str(copy / CONF_REL))
    findings += config_warnings({"plain": plain, "forced": forced}, (copy / CONFIG_REL).resolve())
    probes = {kind: dict(table) for kind, table in KINDS.values()}
    probes[CONTROL_PROBE[0]][CONTROL_PROBE[1]] = [CONTROL_PROBE[2]]
    findings += config_problems((copy / CONFIG_REL).read_text(encoding="utf-8"), probes)

    # The files, one for each crate, in which an allow on a migration's `mod`
    # line is accepted.
    migrations = {
        Path(os.path.relpath(lib_root(p).parent / "migrations" / "mod.rs", ROOT)).as_posix()
        for p in crates.values()
    }
    covered, allows, modules = {}, Counter(), []
    for path in sorted({p for paths, _ in read_forced.values() for p in paths}):
        if not path.is_relative_to(copy) or not path.is_file():
            continue
        rel = path.relative_to(copy).as_posix()
        attributes = lint_attributes(rel, path.read_bytes().decode("latin-1"), rel in migrations)
        covered[path] = attributes.covered
        findings += attributes.findings
        modules += [copy / module for module in attributes.modules]
        if rel not in planted:
            allows["fn"] += attributes.on_functions
            allows["statement"] += attributes.on_statements
            allows["module"] += len(attributes.modules)
    for module in modules:
        if module in covered:
            covered[module].append((0, sys.maxsize))
    forced_reports = reports(forced, copy)
    findings += call_problems(forced_reports, reports(plain, copy), covered, copy, probe_file)
    findings += probe_problems(forced_reports, probe_file, spans)
    findings += environment_problems(
        [("the environment", os.environ), ("a control environment", CONTROL_ENVIRONMENT)]
    )
    findings += cargo_config_problems(
        [
            ("the copy's cargo configuration", cargo_config_files(copy)),
            ("a control configuration", [copy / CONTROL_CARGO_CONFIG]),
        ]
    )
    found, stack = zeroize_check(copy)
    findings += found

    failures, problems = match_controls(findings, controls)
    for problem in problems:
        print(f"FAIL: {problem.text}", file=sys.stderr)
    for failure in failures:
        print(f"FAIL: {failure}", file=sys.stderr)
    calls = [
        r
        for r in forced_reports
        if r.path != probe_file
        and not (r.path.is_relative_to(copy) and r.path.relative_to(copy).as_posix() in planted)
    ]
    unreported = sum(1 for f in findings if f.check == "probe" and f.where != CONTROL_PROBE[1])
    print(
        f"the tree: {len(calls)} reports with --force-warn, {sum(allows.values())} accepted"
        f" allows ({allows['fn']} on functions, {allows['statement']} on statements,"
        f" {allows['module']} on migration modules), in {len(covered)} files of {len(crates)}"
        f" crates (a copy of {files} files)"
    )
    print(f"probes: {len(spans) - 1 - unreported} of {len(spans) - 1} reported with --force-warn")
    print(f"controls: {len(controls)}, {len(failures)} not as planted")
    print(f"zeroize: {', '.join(stack)}")
    return 1 if failures or problems else 0


def main() -> int:
    # Line-buffered, so the FAIL lines on stderr keep their place among these
    # lines when both streams go to one log.
    sys.stdout.reconfigure(line_buffering=True)
    for stop in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(stop, _stop)
    # The workflow's toolchain action exports CARGO_TERM_COLOR=always to the
    # steps after it, and under it cargo tree writes escape codes into its
    # lines. Set for every command the guard starts, it makes a read that the
    # setting changes fail on every machine, not only in CI.
    os.environ["CARGO_TERM_COLOR"] = "always"
    metadata = cargo_metadata()
    crates = wasm_crates(metadata)
    print(f"crates the wasm build compiles: {', '.join(sorted(crates))}")
    copy = Path(tempfile.mkdtemp(prefix="wasm-clippy-guard-"))
    try:
        status = check(crates, metadata["target_directory"], copy)
    finally:
        shutil.rmtree(copy, ignore_errors=True)
    return 0 if status == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
