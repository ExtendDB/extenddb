def driver_probe_problems() -> tuple[list[str], str]:
    """Problems with DRIVER_PROBES: one driver_problems does not refuse, or
    refuses that it must accept."""
    problems = []
    for index, (env, messages, refuse) in enumerate(DRIVER_PROBES):
        found = driver_problems({"probe": env}, messages)
