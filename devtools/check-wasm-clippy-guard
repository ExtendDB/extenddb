    "std::env::vars": ["fn probe() { let _ = std::env::vars().count(); }"],
    "std::env::vars_os": ["fn probe() { use std::env; let _ = env::vars_os().count(); }"],
    "std::env::set_var": ['fn probe() { unsafe { std::env::set_var("K", "V") } }'],
    "std::env::remove_var": ['fn probe() { unsafe { std::env::remove_var("K") } }'],
    "std::env::split_paths": ['fn probe() { let _ = std::env::split_paths("a").count(); }'],
    "std::process::id": ["fn probe() { let _ = std::process::id(); }"],
    "std::process::exit": ["fn probe() -> ! { std::process::exit(0) }"],
