def lib_root(package: dict) -> Path:
    """The crate root of a package's library target, from `cargo metadata`."""
    return Path(
        next(t["src_path"] for t in package["targets"] if {"lib", "rlib"} & set(t["kind"]))
    )


def file_probe_problems(
    crates: dict[str, dict], metadata: dict, copy: Path
) -> tuple[list[str], str]:
    """Problems with FILE_PROBES, added to the copy of the tree at `copy`: a
    probe file that is not among the files the scan reads of FILE_PROBE_CRATE,
    or whose lint setting it does not refuse."""
    package = crates.get(FILE_PROBE_CRATE)
    if package is None:
        return [f"FILE_PROBE_CRATE {FILE_PROBE_CRATE} is not compiled by the wasm build"], ""
    crate_dir = Path(package["manifest_path"]).parent.relative_to(ROOT)
    crate_root = lib_root(package).relative_to(ROOT)
    for rel, text, declaration in FILE_PROBES:
        if (ROOT / crate_dir / rel).exists():
            return [f"{crate_dir / rel} exists; the file probes need that name"], ""
        (copy / crate_dir / rel).parent.mkdir(parents=True, exist_ok=True)
        (copy / crate_dir / rel).write_text(text, encoding="utf-8")
        with open(copy / crate_root, "a", encoding="utf-8") as root_file:
            root_file.write("\n" + declaration)
    compiled = compiled_files({FILE_PROBE_CRATE: package}, copy, metadata["target_directory"])
    problems = compiled.problems
    read = {path.resolve() for path in compiled.files.get(FILE_PROBE_CRATE, [])}
    refused = 0
    for rel, _, _ in FILE_PROBES:
        path = (copy / crate_dir / rel).resolve()
        if path not in read:
            problems.append(
                f"file probe {crate_dir / rel}: not among the files the lint-setting scan"
                f" reads of {FILE_PROBE_CRATE}"
            )
            continue
        found, _ = attribute_problems((crate_dir / rel).as_posix(), path.read_text(), set())
        if found:
            refused += 1
        else:
            problems.append(f"file probe {crate_dir / rel}: read, but its setting not refused")
    return problems, f"file probes: {refused} of {len(FILE_PROBES)} read and refused"


def copy_tree(destination: Path) -> int:
    """Copy the files git tracks or does not ignore, as they are now."""
    try:
        listing = subprocess.run(
            ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
            cwd=ROOT,
            capture_output=True,
            check=False,
        )
    except FileNotFoundError:
        sys.exit("error: git is not on PATH; the probes run in a copy of the files git lists")
    if listing.returncode != 0:
        sys.exit(f"error: git ls-files failed in {ROOT}:\n{listing.stderr.decode()}")
    copied = 0
    for rel in sorted(set(listing.stdout.decode().split("\0")) - {""}):
        source, target = ROOT / rel, destination / rel
        if not os.path.lexists(source):  # deleted in the working tree
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_symlink():
            os.symlink(os.readlink(source), target)
        elif source.is_file():
            # copy2 keeps the modification time, so cargo finds the copied
            # crates as fresh as the caller's.
            shutil.copy2(source, target)
        else:
            continue
        copied += 1
    return copied


def run_clippy(tree: Path, target_dir: str) -> tuple[int, list[dict], list[dict], str]:
    """Run the clippy step in the tree at `tree`, with the caller's clippy.toml
    and the cargo target directory `target_dir`. Returns its exit status, the
    compiler messages and the compiler-artifact records of its JSON output,
    and its stderr."""
    env = dict(os.environ, CLIPPY_CONF_DIR=str(CONF_DIR), CARGO_TARGET_DIR=target_dir)
    # In its own process group, so that it can be stopped with every compiler
    # it started.
    process = subprocess.Popen(
        CLIPPY,
        cwd=tree,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    try:
        stdout, stderr = process.communicate()
    finally:
        if process.poll() is None:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=30)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
    messages, artifacts = [], []
    for line in stdout.splitlines():
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        if record.get("reason") == "compiler-message":
            messages.append(record["message"])
        elif record.get("reason") == "compiler-artifact":
            artifacts.append(record)
    return process.returncode, messages, artifacts, stderr


def config_warnings(messages: list[dict], stderr: str) -> list[str]:
    found = set()
    for message in messages:
        in_config = any(
            Path(s["file_name"]).resolve() == CONFIG.resolve() for s in message.get("spans", [])
        )
        if in_config or any(text in message["message"] for text in CONFIG_WARNINGS):
            found.add(message.get("rendered") or message["message"])
    if not found and any(text in stderr for text in CONFIG_WARNINGS):
        found.add(stderr)
    return sorted(found)


def probe_problems(
    crates: dict[str, dict], metadata: dict, copy: Path, files: int
) -> tuple[list[str], str]:
    """Problems with the probe run: the clippy step, in the copy of the tree at
    `copy` (`files` files), with every probe added to PROBE_CRATE."""
    probe = crates.get(PROBE_CRATE)
    if probe is None:
        return [f"PROBE_CRATE {PROBE_CRATE} is not compiled by the wasm build"], ""
    needed = {p.split("::")[0] for _, probes in KINDS.values() for p in probes} - {"std"}
    direct = {
        d["name"] for d in probe["node"]["deps"] if any(k["kind"] is None for k in d["dep_kinds"])
    }
    if needed - direct:
        return [
            f"PROBE_CRATE {PROBE_CRATE} does not depend directly on"
            f" {', '.join(sorted(needed - direct))}, which the probes name"
        ], ""
    crate_root = lib_root(probe)
    probe_file = crate_root.parent / f"{PROBE_MODULE}.rs"
    if probe_file.exists():
        return [f"{probe_file.relative_to(ROOT)} exists; the probes need that name"], ""
    rel = probe_file.relative_to(ROOT).as_posix()

    lines = ["// Probes of devtools/check-wasm-clippy-guard (in its copy of the tree only)."]
    spans = []  # (kind, path, first line, last line) of each probe, 1-based, inclusive
    for kind, probes in KINDS.values():
        for path, items in probes.items():
            for item in items:
                lines.append(f"mod probe_{len(spans)} {{")
                first = len(lines) + 1
                lines.append(item)
                spans.append((kind, path, first, len(lines)))
                lines.append("}")

    problems = []
    (copy / rel).write_text("\n".join(lines) + "\n", encoding="utf-8")
    with open(copy / crate_root.relative_to(ROOT), "a", encoding="utf-8") as declaration:
        declaration.write(f"\n#[allow(dead_code, unused, deprecated)]\nmod {PROBE_MODULE};\n")
    code, messages, _, stderr = run_clippy(copy, metadata["target_directory"])

    if code == 0:
        problems.append("the clippy step passed with every probe in place")
    problems += [f"warning about {CONFIG_REL}:\n{w}" for w in config_warnings(messages, stderr)]
    refused, other = refused_probes(messages, rel, spans)
    for index, (kind, path, first, _) in enumerate(spans):
        if index in refused:
            print(f"refused: {path} ({kind}, {rel}:{first})")
        else:
            problems.append(f"{path}: the {kind} probe at {rel}:{first} was not refused")
    if len(refused) < len(spans) and other:
        problems.append("clippy's other reports in the probe file:\n" + "\n".join(other))
    if len(refused) < len(spans) and not messages:
        problems.append(f"cargo clippy printed no compiler message; its stderr:\n{stderr}")
    summary = f"{len(refused)} of {len(spans)} probes refused (in a copy of {files} files)"
    return problems, summary


def refused_probes(messages: list[dict], rel: str, spans: list[tuple]) -> tuple[set, list]:
    """The probes that clippy's `messages` refuse, as indexes into `spans` (the
    kind, the path, and the first and last line of each probe in the file
    `rel`), and clippy's other reports in that file. A probe is refused by an
    error-level report of its kind and path whose primary span lies inside it.
    The other reports are clippy's errors and its reports of a disallowed path
    at another level, which let the clippy step pass."""
    refused, other = set(), []
    for message in messages:
        primary = [s for s in message.get("spans", []) if s.get("is_primary")]
        in_probes = [s for s in primary if s["file_name"].endswith(rel)]
        match = REFUSAL.match(message["message"])
        if match and in_probes and message.get("level") == "error":
            for span in in_probes:
                for index, (kind, path, first, last) in enumerate(spans):
                    if (kind, path) == match.groups() and first <= span["line_start"] <= last:
                        refused.add(index)
        elif in_probes and (match or message.get("level") == "error"):
            other.append(message.get("rendered") or message["message"])
    return refused, other


# Compiler messages, in the shape of cargo's JSON messages, that refused_probes
# must count (True) or not count (False) as refusing a probe of
# MESSAGE_PROBE_SPANS: (level, message, line of its primary span, counted).
MESSAGE_PROBE_FILE = "crates/probe/src/wasm_clippy_guard_probes.rs"
MESSAGE_PROBE_SPANS = [
    ("method", "std::thread::sleep", 3, 3),
    ("type", "std::sync::mpsc::Receiver", 6, 6),
]
MESSAGE_PROBES = [
    ("error", "use of a disallowed method `std::thread::sleep`", 3, True),
    ("error", "use of a disallowed type `std::sync::mpsc::Receiver`", 6, True),
    # A report at the warning level (a lint forced to warn, or code under
    # warn(warnings)) lets the step pass; that is not a refusal.
    ("warning", "use of a disallowed method `std::thread::sleep`", 3, False),
    ("warning", "use of a disallowed type `std::sync::mpsc::Receiver`", 6, False),
    ("error", "use of a disallowed method `std::thread::spawn`", 3, False),
    ("error", "use of a disallowed method `std::thread::sleep`", 6, False),
]


def message_probe_problems() -> tuple[list[str], str]:
    """Problems with MESSAGE_PROBES: a message refused_probes counts as a
    refusal that it must not, or does not count that it must."""
    problems = []
    for index, (level, text, line, counted) in enumerate(MESSAGE_PROBES):
        message = {
            "level": level,
            "message": text,
            "rendered": f"{level}: {text}",
            "spans": [{"file_name": MESSAGE_PROBE_FILE, "line_start": line, "is_primary": True}],
        }
        refused, _ = refused_probes([message], MESSAGE_PROBE_FILE, MESSAGE_PROBE_SPANS)
        if bool(refused) != counted:
            problems.append(
                f"message probe {index} ({level}: {text}, line {line}) was"
                f"{' not' if counted else ''} counted as refusing a probe"
            )
    summary = (
        f"message probes: {len(MESSAGE_PROBES) - len(problems)} of {len(MESSAGE_PROBES)}"
        " counted as expected"
    )
    return problems, summary


def _stop(signum: int, _frame) -> None:
    raise SystemExit(128 + signum)


# ---------------------------------------------------------------- zeroize features

# The crates of the wasm32 AES-256-GCM stack whose `zeroize` feature must be on
# in the adapter's wasm32 build: each wipes its own key material, and only under
# that feature, and none of them has an item, such as a ZeroizeOnDrop
# implementation, that a compile-time bound could require. CORE_MANIFEST's
# wasm32 dependencies turn each one on.
ZEROIZE_CRATES = ("aes-gcm", "ghash", "polyval")
CORE_MANIFEST = "crates/core/Cargo.toml"


def zeroize_problems(features: dict[str, set[str]]) -> list[str]:
    """Problems with the `zeroize` features of ZEROIZE_CRATES among the
    resolved `features` of the adapter's wasm32 build. This function looks
    for none."""
    del features
    return []


def resolved_features(tree: Path, locked: bool) -> tuple[dict[str, set[str]], list[str]]:
    """The features cargo resolves for each package of the adapter's wasm32
    build, by name, in the tree at `tree`, and the problems found. `cargo tree
    -e normal` resolves them for the adapter and its normal dependencies on
    that target, as its build does. A tree whose manifests changed is resolved
    offline, without --locked, so that cargo may rewrite its Cargo.lock."""
    command = ["cargo", "tree", "-p", ADAPTER, "--target", TARGET, "-e", "normal"]
    command += ["--prefix", "none", "--format", "{p}|{f}"]
    command.append("--locked" if locked else "--offline")
    try:
        run = subprocess.run(command, cwd=tree, capture_output=True, text=True, check=False)
    except FileNotFoundError:
        sys.exit("error: cargo is not on PATH")
    if run.returncode != 0:
        return {}, [f"{' '.join(command)} failed in {tree}:\n{run.stderr}"]
    features = {}
    for line in run.stdout.splitlines():
        package, _, enabled = line.removesuffix(" (*)").partition("|")
        name = package.split(" ")[0]
        features.setdefault(name, set()).update(enabled.split(",") if enabled else ())
    return features, []


def zeroize_probe_problems(copy: Path) -> tuple[list[str], str]:
    """Problems with the zeroize check: in the copy of the tree at `copy`, with
    each crate of ZEROIZE_CRATES in turn without its `zeroize` feature in
    CORE_MANIFEST, the check must report that crate, and no other."""
    manifest = copy / CORE_MANIFEST
    lock = copy / "Cargo.lock"
    original, original_lock = manifest.read_text(encoding="utf-8"), lock.read_bytes()
    problems, reported = [], 0
    try:
        for crate in ZEROIZE_CRATES:
            entry = re.compile(
                rf'^(\s*{re.escape(crate)}\s*=\s*{{[^\n]*?features\s*=\s*\[)([^\]\n]*)\]', re.M
            )
            match = entry.search(original)
            listed = [f.strip() for f in match.group(2).split(",")] if match else []
            if '"zeroize"' not in listed:
                problems.append(
                    f"zeroize probe: {CORE_MANIFEST} has no `{crate} = {{ ... features = [...,"
                    ' "zeroize"] }` entry to remove the feature from'
                )
                continue
            kept = ", ".join(f for f in listed if f and f != '"zeroize"')
            manifest.write_text(
                original[: match.start(2)] + kept + original[match.end(2) :], encoding="utf-8"
            )
            features, found = resolved_features(copy, locked=False)
            found += zeroize_problems(features)
            if any(p.startswith(f"{crate}:") for p in found) and all(
                p.startswith(f"{crate}:") for p in found
            ):
                reported += 1
            else:
                problems.append(
                    f"zeroize probe: without {crate}'s zeroize feature in {CORE_MANIFEST},"
                    f" the check reported {found or 'nothing'}"
                )
            manifest.write_text(original, encoding="utf-8")
            lock.write_bytes(original_lock)
    finally:
        manifest.write_text(original, encoding="utf-8")
        lock.write_bytes(original_lock)
    return problems, f"zeroize probes: {reported} of {len(ZEROIZE_CRATES)} removals reported"


def main() -> int:
    # Line-buffered, so the FAIL lines on stderr keep their place among these
    # lines when both streams go to one log.
    sys.stdout.reconfigure(line_buffering=True)
    for stop in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(stop, _stop)
    paths, failures = read_config()
    entries = sum(len(p) for p in paths.values())
    if failures:
        for failure in failures:
            print(f"FAIL: {failure}", file=sys.stderr)
        print(f"{entries} entries in {CONFIG_REL}; no probe run")
        return 1

    metadata = cargo_metadata()
    crates = wasm_crates(metadata)
    print(f"crates the wasm build compiles: {', '.join(sorted(crates))}")
    found, settings = lint_setting_problems(crates, metadata)
    failures += found
    print(settings)
    found, settings = setting_probe_problems()
    failures += found
    print(settings)
    found, settings = driver_probe_problems()
    failures += found
    print(settings)
    found, settings = message_probe_problems()
    failures += found
    print(settings)
    copy = Path(tempfile.mkdtemp(prefix="wasm-clippy-guard-"))
    try:
        files = copy_tree(copy)
        found, settings = file_probe_problems(crates, metadata, copy)
        failures += found
        print(settings)
        found, probes = probe_problems(crates, metadata, copy, files)
        failures += found
        found, settings = zeroize_probe_problems(copy)
        failures += found
        print(settings)
    finally:
        shutil.rmtree(copy, ignore_errors=True)
    for failure in failures:
        print(f"FAIL: {failure}", file=sys.stderr)
    methods = len(paths.get("disallowed-methods", []))
    types = len(paths.get("disallowed-types", []))
    print(
        f"{entries} entries in clippy.toml ({methods} methods, {types}"
        f" type{'' if types == 1 else 's'}); {probes or 'no probe run'}"
    )
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
