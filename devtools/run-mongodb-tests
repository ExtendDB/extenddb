#
# Orchestrated mongo integration-test runner.
#
# Starts a mongo:7 single-node replica set in Docker, initializes and
# serves extenddb against it, then delegates the test workload to
# `devtools/run-tests --backend mongodb`. Tears everything down on exit.
#
# Usage:
#   devtools/run-mongodb-tests [OPTIONS] [-- RUN_TESTS_ARGS ...]
#
# Options:
#   --port PORT        HTTPS port extenddb should bind (default: 18443)
#   --mongo-port PORT  Host port to publish mongo on (default: 27021)
#   --output DIR       Directory for logs and generated config
#                      (default: /tmp/run-mongodb-tests-<ts>)
#   --backup-store KIND  filesystem (default): the server gets a filesystem
#                      [backup.store] under the output directory and the
#                      suites read EXTENDDB_TEST_BACKUP_STORE=filesystem;
#                      none: no [backup.store], the in-catalog backup path,
#                      EXTENDDB_TEST_BACKUP_STORE=none. The legacy LSI
#                      fallback cell of tests/test_mongodb_backup_restore.py
#                      runs only under none.
#   --keep             Do not tear down the mongo container / server
#                      on exit (useful for post-run inspection)
#   --mongo-only       Start the replica set, print its URI, and exit without
#                      writing a config or starting extenddb; implies --keep.
#                      For tests that talk to MongoDB directly (the storage
#                      crate's snapshot tests). Tear down with
#                      docker rm -f extenddb-runtests-mongo-<port>.
#   --backup-store-root DIR
#                      The filesystem store's root (default: backups/ under
#                      the output directory), created 0700 if missing; a
#                      fresh directory per run, since the store's identity
#                      file names the catalog that owns it and this runner
#                      initializes a new catalog each time. Implies
#                      --backup-store filesystem.
#   --rust-live        Also run the Rust live tests of the storage-mongodb
#                      crate against this runner's replica set. They are
#                      `#[ignore]`d, because they need a replica set, and
#                      they are the only tests of the startup key repair.
#   -h, --help         Show this help
#
# Arguments after `--` are passed to `devtools/run-tests` verbatim.
# Default suite is `--pytest --comprehensive --parallel`.
#
# Examples:
#   devtools/run-mongodb-tests
#   devtools/run-mongodb-tests -- --pytest --filter test_put_item
#   devtools/run-mongodb-tests --keep -- --pytest --filter test_rfc0003
#   devtools/run-mongodb-tests --rust-live -- --rust --rust-integration
#   devtools/run-mongodb-tests --backup-store none -- --pytest --filter test_mongodb_backup_restore
#
# Prerequisites:
#   - Docker running
#   - `cargo build --release --no-default-features --features mongodb-test-hooks` already done
#   - Python venv activated with pytest installed
#   - `~/.extenddb/tls/` populated (from a prior `extenddb init`)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_DIR"

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

BIND_PORT=18443
MONGO_PORT=27021
OUTPUT_DIR=""
KEEP=false
MONGO_ONLY=false
RUST_LIVE=false
BACKUP_STORE_ROOT=""
BACKUP_STORE=filesystem
RUN_TESTS_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --port)       BIND_PORT="$2"; shift 2 ;;
        --mongo-port) MONGO_PORT="$2"; shift 2 ;;
        --output)     OUTPUT_DIR="$2"; shift 2 ;;
        --backup-store)
            case "$2" in
                filesystem|none) BACKUP_STORE="$2" ;;
                *) echo "error: --backup-store takes filesystem or none, not: $2" >&2; exit 1 ;;
            esac
            shift 2 ;;
        --keep)       KEEP=true; shift ;;
        --mongo-only) MONGO_ONLY=true; KEEP=true; shift ;;
        --rust-live)  RUST_LIVE=true; shift ;;
        --backup-store-root) BACKUP_STORE_ROOT="$2"; BACKUP_STORE=filesystem; shift 2 ;;
        --)           shift; RUN_TESTS_ARGS=("$@"); break ;;
        -h|--help)    sed -n '5,60p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)            echo "error: unknown option: $1" >&2; exit 1 ;;
    esac
done

if [[ ${#RUN_TESTS_ARGS[@]} -eq 0 ]]; then
    RUN_TESTS_ARGS=(--pytest --comprehensive --parallel)
fi

# Derive the output dir and container name from the mongo port (plus PID for
# the dir) so concurrent runs on different ports do not collide: a shared
# container name + a shared `docker rm -f` at startup would let one run tear
# down another run's mongo and overwrite its logs.
if [[ -z "$OUTPUT_DIR" ]]; then
    OUTPUT_DIR="/tmp/run-mongodb-tests-${MONGO_PORT}-$(date +%Y%m%d-%H%M%S)-$$"
fi
# --mongo-only writes nothing, so it creates no directory.
if ! $MONGO_ONLY; then
    mkdir -p "$OUTPUT_DIR"
fi

CONFIG="$OUTPUT_DIR/extenddb.toml"
SERVER_LOG="$OUTPUT_DIR/server.log"
CONTAINER_NAME="extenddb-runtests-mongo-${MONGO_PORT}"
BINARY="./target/release/extenddb"

# Tell the integration test binary that this runner includes MongoDB test
# hooks. The production server has no effect from this variable; the hooks are
# compiled only by the `mongodb-test-hooks` feature.
export EXTENDDB_TEST_MONGODB_TEST_HOOKS=1

if ! $MONGO_ONLY && [[ ! -x "$BINARY" ]]; then
    echo "error: $BINARY not found. Build first: cargo build --release --no-default-features --features mongodb-test-hooks" >&2
    exit 1
fi

# The GSI race test requires the hook-enabled binary. Check the compiled
# capability before starting Docker or ExtendDB so a plain `mongodb` binary
# fails with the build error instead of timing out while waiting for a gate
# that was compiled out.
if ! $MONGO_ONLY && ! "$BINARY" version 2>/dev/null | grep -q '^test-hooks enabled$'; then
    echo "error: $BINARY does not include MongoDB test hooks; rebuild with:" >&2
    echo "  cargo build --release --no-default-features --features mongodb-test-hooks" >&2
    exit 1
fi

# Canonicalized `/tmp` — resolves through the macOS `/tmp -> /private/tmp`
# symlink so the server's import/export path check (which rejects symlink
# components) accepts it. Portable across Linux and macOS.
TMP_CANON=$(realpath /tmp)

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------

cleanup() {
    if $MONGO_ONLY; then
        echo "  mongo container:      $CONTAINER_NAME (port $MONGO_PORT); tear down with: docker rm -f $CONTAINER_NAME"
        return
    fi
    if $KEEP; then
        echo ""
        echo "=== --keep set; leaving mongo + extenddb running ==="
        echo "  server log:           $SERVER_LOG"
        echo "  mongo container:      $CONTAINER_NAME (port $MONGO_PORT)"
        echo "  tear down manually:   $BINARY stop --config $CONFIG; docker rm -f $CONTAINER_NAME"
        return
    fi
    echo ""
    echo "=== Cleanup ==="
    if [[ -f "$CONFIG" ]] && "$BINARY" stop --config "$CONFIG" >/dev/null 2>&1; then
        echo "  stopped extenddb server"
    fi
    if docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1; then
        echo "  removed docker container $CONTAINER_NAME"
    fi
}
trap cleanup EXIT

# ---------------------------------------------------------------------------
# Start mongo replica set
# ---------------------------------------------------------------------------

echo "=== Starting MongoDB 7 replica set on host port $MONGO_PORT ==="
docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
# Published on the loopback interface only: the replica set has no
# authentication, and everything that connects to it (the printed URI, the
# server config below, the CI job) uses 127.0.0.1. `--bind_ip_all` applies
# inside the container, where Docker's port forwarding arrives.
docker run -d --name "$CONTAINER_NAME" -p "127.0.0.1:$MONGO_PORT:27017" mongo:7 \
    mongod --replSet rs0 --bind_ip_all --wiredTigerCacheSizeGB 1 >/dev/null

# Wait for mongod to accept pings
for i in $(seq 1 30); do
    if docker exec "$CONTAINER_NAME" mongosh --quiet --eval "db.runCommand({ping:1}).ok" 2>/dev/null \
        | grep -q '^1$'; then
        echo "  mongod responsive after ${i}s"
        break
    fi
    sleep 1
done

# Initiate replica set (idempotent — rs.initiate() errors are non-fatal)
docker exec "$CONTAINER_NAME" mongosh --quiet --eval \
    'rs.initiate({_id: "rs0", members: [{_id: 0, host: "localhost:27017"}]})' >/dev/null 2>&1 || true

# Wait for PRIMARY election
for i in $(seq 1 30); do
    state=$(docker exec "$CONTAINER_NAME" mongosh --quiet --eval 'rs.status().members[0].stateStr' 2>/dev/null | tail -1)
    if [[ "$state" == "PRIMARY" ]]; then
        echo "  replica set PRIMARY after ${i}s"
        break
    fi
    sleep 1
done
if [[ "$state" != "PRIMARY" ]]; then
    echo "error: replica set did not elect a PRIMARY" >&2
    exit 1
fi

if $MONGO_ONLY; then
    echo ""
    echo "EXTENDDB_TEST_MONGODB_URI=mongodb://127.0.0.1:$MONGO_PORT/?directConnection=true"
    exit 0
fi

# ---------------------------------------------------------------------------
# Initialize extenddb
# ---------------------------------------------------------------------------

echo ""
echo "=== Initializing extenddb ==="

# `init --backend mongodb` reads the connection string from the config
# file, so write a minimal stub for it first.
cat > "$CONFIG" <<TOML
[storage]
backend = "mongodb"

[storage.mongodb]
connection_string = "mongodb://127.0.0.1:$MONGO_PORT/?replicaSet=rs0&directConnection=true"
TOML

ADMIN_PASSWORD=$(openssl rand -base64 16)
EXTENDDB_ADMIN_PASSWORD="$ADMIN_PASSWORD" "$BINARY" init \
    --backend mongodb --config "$CONFIG" --overwrite 2>&1 | tail -3

# `init` regenerates the config with default port 18443 and no
# `[import]` / `[export]` sections. Rewrite with the port + defaults the
# integration suite needs. This overwrite falls away once `extenddb init`
# grows flags for these knobs. With `--backup-store filesystem` (the
# default) the `[backup.store]` is a filesystem root under the output
# directory: CreateBackup is the store-backed job and RestoreTableFromBackup
# the store-backed restore, which the MongoDB restore cells
# (tests/test_mongodb_backup_restore.py) reach through the root
# (EXTENDDB_TEST_BACKUP_ROOT) and the server's log (EXTENDDB_TEST_SERVER_LOG);
# the suites read EXTENDDB_TEST_BACKUP_STORE=filesystem to expect that path.
# With `--backup-store none` the section is absent, CreateBackup writes the
# in-catalog format and the suites read EXTENDDB_TEST_BACKUP_STORE=none.
BACKUP_ROOT="${BACKUP_STORE_ROOT:-$OUTPUT_DIR/backups}"
STORE_SECTION=""
if [[ "$BACKUP_STORE" == "filesystem" ]]; then
    if [[ -z "$BACKUP_STORE_ROOT" ]]; then
        # A root left by an earlier run of a reused --output directory
        # carries that run's `extenddb-store.json`, which names that run's
        # catalog; the container is recreated every run, so the new catalog's
        # id differs and the server would find the store "owned by another
        # catalog". Start from an empty root. A root the caller named is
        # theirs to clear: it is created and made owner-only, nothing more.
        rm -rf "$BACKUP_ROOT"
    fi
    mkdir -p "$BACKUP_ROOT"
    chmod 0700 "$BACKUP_ROOT"
    echo "  backup store: filesystem at $BACKUP_ROOT"
    STORE_SECTION="
[backup.store]
kind = \"filesystem\"

[backup.store.filesystem]
path = \"$BACKUP_ROOT\"
"
fi
cat > "$CONFIG" <<TOML
[server]
bind_addr = "127.0.0.1"
port = $BIND_PORT
region = "us-east-1"
run_dir = "$OUTPUT_DIR"

[server.tls]
cert_path = "$HOME/.extenddb/tls/cert.pem"
key_path = "$HOME/.extenddb/tls/key.pem"

[storage]
backend = "mongodb"

[storage.mongodb]
connection_string = "mongodb://127.0.0.1:$MONGO_PORT/?replicaSet=rs0&directConnection=true"

[auth]
provider = "builtin"

[import]
paths = ["$TMP_CANON"]

[export]
paths = ["$TMP_CANON"]

[logging]
level = "info"
format = "pretty"

[backup]
reconcile_interval_secs = 2
$STORE_SECTION
TOML

# ---------------------------------------------------------------------------
# Start extenddb server
# ---------------------------------------------------------------------------

echo ""
echo "=== Starting extenddb server on 127.0.0.1:$BIND_PORT ==="
# The server runs in the foreground in the background of this shell, with its
# PID file written so `extenddb stop` (the cleanup) can signal it, and its
# whole log in SERVER_LOG: the restore cells read the job's log lines there,
# where a daemonized server's would go to syslog.
"$BINARY" serve --foreground --write-pid-file --config "$CONFIG" >"$SERVER_LOG" 2>&1 &

for i in $(seq 1 30); do
    if curl -sk "https://127.0.0.1:$BIND_PORT/health" >/dev/null 2>&1; then
        echo "  server healthy after ${i}s"
        break
    fi
    sleep 1
done

if ! curl -sk "https://127.0.0.1:$BIND_PORT/health" >/dev/null 2>&1; then
    echo "error: extenddb server did not become healthy" >&2
    tail -30 "$SERVER_LOG" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Delegate to run-tests
# ---------------------------------------------------------------------------

echo ""
# These two sections run when the arguments name --rust or --rust-integration.
# They do not run for --all, which run-tests expands to both suites. CI's
# mongodb-rust job passes --rust-integration, so these sections are where it
# runs records_live and the migration tests.
if [[ " ${RUN_TESTS_ARGS[*]} " == *" --rust "* \
    || " ${RUN_TESTS_ARGS[*]} " == *" --rust-integration "* ]]; then
    # The storage-level MongoDB tests that need a live server (the stream
    # records page over 16 MB and the shard ownership predicates) are
    # #[ignore]d in the crate and read their server from this variable; this
    # container is the one place in CI that has one.
    echo "=== Running MongoDB storage-level live tests (records_live) ==="
    echo ""
    EXTENDDB_TEST_MONGODB_URI="mongodb://localhost:$MONGO_PORT/?replicaSet=rs0&directConnection=true" \
        cargo test -p extenddb-storage-mongodb --lib -- --ignored records_live
    echo ""
    # The catalog migration tests and the metrics store test: each runs in
    # databases of its own on this server, and EXTENDDB_TEST_MONGODB_REQUIRED
    # turns a skip for a missing server into a failure.
    echo "=== Running MongoDB catalog migration tests (migrations_*, metrics_store) ==="
    echo ""
    EXTENDDB_TEST_MONGODB_URI="mongodb://localhost:$MONGO_PORT/?replicaSet=rs0&directConnection=true" \
    EXTENDDB_TEST_MONGODB_REQUIRED=1 \
        cargo test -p extenddb-storage-mongodb --test migrations_fresh --test migrations_guards \
            --test migrations_holders --test migrations_locks --test migrations_released \
            --test migrations_spill --test metrics_store
    echo ""
fi
echo "=== Running test suite via devtools/run-tests --backend mongodb ==="
echo "  passthrough args: ${RUN_TESTS_ARGS[*]}"
echo ""

export EXTENDDB_TEST_ENDPOINT="https://127.0.0.1:$BIND_PORT"
export EXTENDDB_ADMIN_USER=admin
export EXTENDDB_ADMIN_PASSWORD="$ADMIN_PASSWORD"
# MongoDB-specific tests use mongosh in this runner's container to verify
# physical collection cleanup after exercising the DynamoDB API.
export EXTENDDB_TEST_MONGODB_CONTAINER="$CONTAINER_NAME"

# MongoDB-specific tests use mongosh in this runner's container to verify
# physical index lifecycle after exercising the DynamoDB API.
export EXTENDDB_TEST_MONGODB_CONTAINER="$CONTAINER_NAME"

# Where the server writes its backups, which run-tests requires for --pytest
# and the backup suites read to pick their branch (filesystem: the
# store-backed job and restore; none: the in-catalog format). The MongoDB
# restore cells rewrite a backup's prefix under the store's root and read the
# restore job's log lines from the server's log; without a store there is no
# root and those cells skip, while the legacy LSI fallback cell runs.
export EXTENDDB_TEST_BACKUP_STORE="$BACKUP_STORE"
if [[ "$BACKUP_STORE" == "filesystem" ]]; then
    export EXTENDDB_TEST_BACKUP_ROOT="$BACKUP_ROOT"
fi
export EXTENDDB_TEST_SERVER_LOG="$SERVER_LOG"

# Some tests read EXTENDDB_CONFIG to invoke `extenddb settings` against
# the running instance. Without this, they fall back to `./extenddb.toml`
# in the repo root, which is a stale dev config that points at a
# postgres instance that isn't running — the CLI hangs on the doomed
# connection and pytest times its subprocess out.
export EXTENDDB_CONFIG="$CONFIG"

# import/export tests use tempfile.NamedTemporaryFile(), which honors
# $TMPDIR. On macOS $TMPDIR defaults to /var/folders/…/T, which isn't
# inside the server's configured [import]/[export] paths. Point TMPDIR
# at the canonical `/tmp` (matches the paths written above) so the
# tempfiles land in an allowed location on both Linux and macOS.
export TMPDIR="$TMP_CANON"

# The Rust live tests in crates/storage-mongodb connect to the replica set
# directly, rather than through the server, so they read its URI from here.
export EXTENDDB_TEST_MONGODB_URI="mongodb://localhost:$MONGO_PORT/?replicaSet=rs0&directConnection=true"

RC=0
devtools/run-tests --extenddb --backend mongodb --config "$CONFIG" "${RUN_TESTS_ARGS[@]}" || RC=$?

# The live tests of the storage-mongodb crate are `#[ignore]`d, so
# `cargo test` does not run them: they need the replica set this runner
# started. They are the only tests of the startup key repair, which is why
# they run here rather than in the plain `cargo test --workspace` job. Each
# one works in its own pair of databases and drops them at the end, so they
# do not touch the served instance's catalog or data.
if $RUST_LIVE; then
    echo ""
    echo "=== MongoDB live Rust tests (storage-mongodb, --ignored) ==="
    if cargo test -p extenddb-storage-mongodb --lib -- \
        --ignored --test-threads=1 data_engine::live_tests::; then
        echo "  ✓ MongoDB live Rust tests passed"
    else
        echo "  ✗ MongoDB live Rust tests failed"
        RC=1
    fi
    # The backup engine's live tests: the restore claim, the heartbeat, the
    # reconciler's listing and FAILED write, the delete and restore orderings
    # against a replica set. They are the only tests of several of those
    # conditions, so they run here with the replica set required (a missing
    # server is a failure, not a skip), one at a time as the tests above.
    echo ""
    echo "=== MongoDB backup engine live Rust tests (storage-mongodb, --ignored) ==="
    if EXTENDDB_TEST_MONGODB_REQUIRED=1 \
        cargo test -p extenddb-storage-mongodb --lib -- \
        --ignored --test-threads=1 backup_engine::live_tests::; then
        echo "  ✓ MongoDB backup engine live Rust tests passed"
    else
        echo "  ✗ MongoDB backup engine live Rust tests failed"
        RC=1
    fi

    # A deleted principal or account leaves nothing behind (#693, #694): the
    # shared `iam_leftovers_conformance` check, and a deleted account's user
    # and role granting nothing. Direct integration tests in tests/, which
    # skip without a URI; REQUIRED makes that a failure here.
    echo ""
    echo "=== MongoDB IAM delete direct integration tests (storage-mongodb) ==="
    if EXTENDDB_TEST_MONGODB_REQUIRED=1 \
        cargo test -p extenddb-storage-mongodb --test iam_leftovers -- \
        --test-threads=1; then
        echo "  ✓ MongoDB IAM delete direct integration tests passed"
    else
        echo "  ✗ MongoDB IAM delete direct integration tests failed"
        RC=1
    fi


    # The restore fence cells need the `test-hooks` feature (the GSI backfill
    # gate `bulk_load` honours is compiled only under it), and no other job
    # builds that feature, so the takeover fence has no CI coverage without
    # this step. Run them one at a time against the same replica set.
    echo ""
    echo "=== MongoDB restore fence cells (storage-mongodb, test-hooks) ==="
    if cargo test -p extenddb-storage-mongodb --lib --features test-hooks -- \
        --ignored --test-threads=1 \
        backup_engine::live_tests::a_takeover_during_bulk_load_fences_the_file_index_write \
        backup_engine::live_tests::live_bulk_load_stops_at_a_lost_claim_between_two_insert_many_calls \
        backup_engine::live_tests::live_bulk_load_records_each_batch_and_a_resume_continues_from_items_applied; then
        echo "  ✓ MongoDB restore fence cells passed"
    else
        echo "  ✗ MongoDB restore fence cells failed"
        RC=1
    fi
fi

exit $RC
