#!/usr/bin/env bash
# Copyright 2026 ExtendDB contributors
# SPDX-License-Identifier: Apache-2.0
#
# Unified test runner for extenddb. All test execution MUST go through this script.
#
# Usage:
#   devtools/run-tests --extenddb --rust
#   devtools/run-tests --extenddb --rust-integration
#   devtools/run-tests --extenddb --pytest --external --comprehensive
#   devtools/run-tests --extenddb --all
#   devtools/run-tests --real-dynamodb --pytest
#   devtools/run-tests --extenddb --rust --release
#   devtools/run-tests --extenddb --filter PATTERN --pytest
#   devtools/run-tests --extenddb --catalog-check --config PATH
#   devtools/run-tests --extenddb --pytest --backend mongodb
#
# Target flag (exactly one required, mutually exclusive):
#   --extenddb            targeting a local extenddb instance
#   --real-dynamodb   targeting real AWS DynamoDB
#
# Suite flags (at least one required):
#   --rust            Rust unit tests
#   --rust-integration Rust integration tests (tests/rust/, requires running server)
#   --pytest          Python integration tests
#   --external        External Java test suite
#   --comprehensive   Comprehensive Python suite
#   --all             all of the above
#   --terraform       Terraform apply of tests/terraform/warm-throughput (not in --all)
#   --catalog-check   post-test catalog integrity check
#
# Options:
#   --backend NAME    storage backend the running server uses:
#                       postgres (default) or mongodb.
#                       Gates postgres-only paths (pg connection-string
#                       extraction, test_cli_lifecycle.py).
#   --release         use release build for Rust tests
#   --filter PATTERN  pass to cargo test / pytest -k
#   --parallel[=N]    run pytest in parallel (default: 1/3 of CPU cores)
#   --shard K/N       run only shard K of N of each pytest suite (CI); only
#                     shard 1 runs --terraform, and no shard runs the SQLite
#                     build's backup store wire tests
#   --config PATH     config file path (default: extenddb.toml in repo root)
#
# Environment (--pytest against extenddb):
#   EXTENDDB_TEST_BACKUP_STORE  where the server writes its backups: filesystem,
#                               s3 or none; the backup tests derive their
#                               expected outcome from it, so it is required
#                               (the Rust integration suite's backup tests read
#                               it too and fail when it is unset).
#
# REQ-TEST-001, D-1, D-2, D-3, D-4, D-5

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_DIR"

# Never prompt for input — redirect stdin from /dev/null for the entire script.
# Any command that would block on stdin will get EOF immediately.
exec < /dev/null

# Ensure discussions directory exists for test artifacts
mkdir -p discussions

# Current short commit hash
HASH=$(git rev-parse --short HEAD)

# Target
TARGET=""

# Suite flags
RUN_RUST=false
RUN_RUST_INTEGRATION=false
RUN_PYTEST=false
RUN_EXTERNAL=false
RUN_COMPREHENSIVE=false
RUN_TERRAFORM=false
RUN_CATALOG_CHECK=false

# Options
RELEASE=false
FILTER=""
CONFIG_PATH=""
PARALLEL=""
# --shard K/N; CI sets EXTENDDB_TEST_SHARD instead.
SHARD="${EXTENDDB_TEST_SHARD:-}"
BACKEND="postgres"

usage() {
    cat <<'EOF'
Usage: devtools/run-tests --extenddb|--real-dynamodb SUITES [OPTIONS]

Target (exactly one required):
  --extenddb            local extenddb instance
  --real-dynamodb   real AWS DynamoDB

Suites (at least one required):
  --rust            Rust unit tests
  --rust-integration Rust integration tests (tests/rust/)
  --pytest          Python integration tests
  --external        External Java test suite
  --comprehensive   Comprehensive Python suite
  --terraform       Terraform apply of tests/terraform/warm-throughput (installs
                    the pinned linux_amd64 Terraform unless TERRAFORM names a
                    binary, and downloads the AWS provider; not part of --all)
  --all             all suites above except --terraform
  --catalog-check   post-test catalog integrity check

Options:
  --backend NAME    storage backend the running server uses:
                      postgres (default) or mongodb.
  --release         release build for Rust tests
  --filter PATTERN  filter for cargo test / pytest -k
  --parallel[=N]    run pytest in parallel (default: 1/3 of CPU cores)
  --shard K/N       run only shard K of N of each pytest suite; only shard 1
                    runs --terraform, and no shard runs the SQLite build's
                    backup store wire tests
  --config PATH     config file path

Environment (--extenddb with an integration suite):
  EXTENDDB_TEST_ENDPOINT      the server, https://localhost:<port> (required)
  EXTENDDB_ADMIN_PASSWORD     the password from 'extenddb init' (required)
  EXTENDDB_TEST_BACKUP_STORE  where the server writes its backups: filesystem,
                              s3 or none (required for --pytest; the Rust
                              integration suite's backup tests read it too)
Environment (--real-dynamodb): EXTENDDB_TEST_ENDPOINT and EXTENDDB_ADMIN_PASSWORD
  unset; AWS credentials from the SDK's chain or AWS_ACCESS_KEY_ID.
EOF
    exit 1
}

if [[ $# -eq 0 ]]; then
    usage
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --extenddb)           TARGET="extenddb"; shift ;;
        --real-dynamodb)  TARGET="real-dynamodb"; shift ;;
        --rust)           RUN_RUST=true; shift ;;
        --rust-integration) RUN_RUST_INTEGRATION=true; shift ;;
        --pytest)         RUN_PYTEST=true; shift ;;
        --external)       RUN_EXTERNAL=true; shift ;;
        --comprehensive)  RUN_COMPREHENSIVE=true; shift ;;
        --terraform)      RUN_TERRAFORM=true; shift ;;
        --all)            RUN_RUST=true; RUN_RUST_INTEGRATION=true; RUN_PYTEST=true; RUN_EXTERNAL=true; RUN_COMPREHENSIVE=true; shift ;;
        --release)        RELEASE=true; shift ;;
        --filter)         FILTER="$2"; shift 2 ;;
        --catalog-check)  RUN_CATALOG_CHECK=true; shift ;;
        --config)         CONFIG_PATH="$2"; shift 2 ;;
        --backend)        BACKEND="$2"; BACKEND_GIVEN=1; shift 2 ;;
        --parallel)
            # --parallel (no argument) or --parallel=N
            PARALLEL="auto"; shift
            ;;
        --parallel=*)
            PARALLEL="${1#--parallel=}"; shift
            ;;
        --shard)          SHARD="$2"; shift 2 ;;
        -h|--help)        usage ;;
        *)                echo "error: unknown option: $1"; usage ;;
    esac
done

# --- Validate: backend name ---
case "$BACKEND" in
    postgres|sqlite|mongodb|cassandra) ;;
    *)
        echo "error: --backend must be 'postgres', 'sqlite', 'mongodb' or 'cassandra' (got: $BACKEND)"
        exit 1
        ;;
esac
# Tests that depend on the backend (tests/test_ttl.py, and the update-size
# classes in tests/test_item_size_at_limit.py that apply only to the PostgreSQL
# and SQLite storage layers) read this rather than guess from a config file.
# Only exported when --backend was given: the SQLite CI leg runs without it.
if [[ -n "${BACKEND_GIVEN:-}" ]]; then
    export EXTENDDB_TEST_BACKEND="$BACKEND"
fi

# --- Validate: target flag required ---
if [[ -z "$TARGET" ]]; then
    echo "error: target flag is required (--extenddb or --real-dynamodb)"
    exit 1
fi

# --- Validate: at least one suite ---
if ! $RUN_RUST && ! $RUN_RUST_INTEGRATION && ! $RUN_PYTEST && ! $RUN_EXTERNAL && ! $RUN_COMPREHENSIVE && ! $RUN_TERRAFORM && ! $RUN_CATALOG_CHECK; then
    echo "error: at least one suite flag is required (--rust, --rust-integration, --pytest, --external, --comprehensive, --terraform, --all, --catalog-check)"
    exit 1
fi

# --- Credential validation ---
validate_local_target() {
    local prefix_upper="$1"  # EXTENDDB
    local prefix_lower="$2"  # extenddb

    # EXTENDDB_TEST_ENDPOINT must be set
    if [[ -z "${EXTENDDB_TEST_ENDPOINT:-}" ]]; then
        echo "error: --${prefix_lower} requires EXTENDDB_TEST_ENDPOINT to be set."
        echo "  export EXTENDDB_TEST_ENDPOINT=https://localhost:18443"
        exit 1
    fi

    # EXTENDDB_TEST_ENDPOINT must point to localhost
    if [[ ! "$EXTENDDB_TEST_ENDPOINT" =~ ^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?(/.*)?$ ]]; then
        echo "error: --${prefix_lower} requires EXTENDDB_TEST_ENDPOINT to point to localhost."
        echo "  Got: $EXTENDDB_TEST_ENDPOINT"
        echo "  This looks like a remote endpoint. Did you mean --real-dynamodb?"
        exit 1
    fi

    # EXTENDDB_ADMIN_PASSWORD must be set
    if [[ -z "${EXTENDDB_ADMIN_PASSWORD:-}" ]]; then
        echo "error: --${prefix_lower} requires EXTENDDB_ADMIN_PASSWORD to be set."
        echo "  This is the password from '${prefix_lower} init'."
        exit 1
    fi

    # EXTENDDB_TEST_BACKUP_STORE must say where the server writes its backups.
    # The backup tests derive their expected outcome from it (the store-backed
    # create backs up vector tables and is asynchronous; the in-catalog create
    # refuses them), so a run cannot leave it to be guessed.
    if $RUN_PYTEST; then
        case "${EXTENDDB_TEST_BACKUP_STORE:-}" in
            filesystem|s3|none) ;;
            *)
                echo "error: --${prefix_lower} --pytest requires EXTENDDB_TEST_BACKUP_STORE to be set."
                echo "  Set it to the server's [backup.store]: 'filesystem' or 's3' for a configured"
                echo "  store (a file-backed SQLite server without the section has the defaulted"
                echo "  filesystem root), 'none' for a server without one (kind = \"disabled\", or"
                echo "  PostgreSQL, MongoDB and Cassandra without the section)."
                echo "  Got: '${EXTENDDB_TEST_BACKUP_STORE:-}'"
                exit 1
                ;;
        esac
    fi
}

validate_real_dynamodb() {
    # EXTENDDB_TEST_ENDPOINT must NOT be set
    if [[ -n "${EXTENDDB_TEST_ENDPOINT:-}" ]]; then
        echo "error: --real-dynamodb requires EXTENDDB_TEST_ENDPOINT to be unset."
        echo "  Got: $EXTENDDB_TEST_ENDPOINT"
        echo "  This looks like a local ${TARGET} instance. Did you mean --extenddb?"
        exit 1
    fi

    # EXTENDDB_ADMIN_PASSWORD must NOT be set
    if [[ -n "${EXTENDDB_ADMIN_PASSWORD:-}" ]]; then
        echo "error: --real-dynamodb requires EXTENDDB_ADMIN_PASSWORD to be unset."
        echo "  Real DynamoDB has no admin password. Unset EXTENDDB_ADMIN_PASSWORD."
        exit 1
    fi

    # AWS_ACCESS_KEY_ID must not look like extenddb keys
    local aki="${AWS_ACCESS_KEY_ID:-}"
    if [[ -n "$aki" ]]; then
        if [[ "$aki" == AKIAEXTENDDB* || "$aki" == ASIAEXTENDDB* ]]; then
            echo "error: --real-dynamodb requires AWS_ACCESS_KEY_ID to NOT be an extenddb key."
            echo "  Got: $aki"
            echo "  This looks like a local key. Did you mean --extenddb?"
            exit 1
        fi
    fi
}

# Only validate credentials for integration suites
NEEDS_INTEGRATION=false
if $RUN_PYTEST || $RUN_EXTERNAL || $RUN_COMPREHENSIVE || $RUN_TERRAFORM || $RUN_CATALOG_CHECK || $RUN_RUST_INTEGRATION; then
    NEEDS_INTEGRATION=true
fi

if $NEEDS_INTEGRATION; then
    case "$TARGET" in
        extenddb) validate_local_target "EXTENDDB" "extenddb" ;;
        real-dynamodb) validate_real_dynamodb ;;
    esac
fi

# --- Echo target info (D3: always, before any tests) ---
echo "=== Test target: $TARGET ==="
echo "  commit:              $HASH"
if [[ "$TARGET" == "real-dynamodb" ]]; then
    echo "  EXTENDDB_TEST_ENDPOINT = (not set — using AWS SDK defaults)"
    echo "  AWS_ACCESS_KEY_ID  = ${AWS_ACCESS_KEY_ID:-(from ~/.aws)}"
else
    echo "  backend            = $BACKEND"
    echo "  EXTENDDB_TEST_ENDPOINT = ${EXTENDDB_TEST_ENDPOINT:-}"
    echo "  AWS_ACCESS_KEY_ID  = ${AWS_ACCESS_KEY_ID:-(will be provisioned)}"
fi
echo ""

# --- Health check (local targets only) ---
# With EXTENDDB_TEST_BACKUP_STORE at filesystem or s3 the check also waits for
# the backup store component to report healthy: /health answers 200 while the
# component is still "checking", and the backup suites assert the component
# is healthy at their start, so what is waited for here is what they assert.
health_check() {
    local endpoint="$1"
    local timeout=30
    local interval=1
    local elapsed=0
    local want_store=false
    case "${EXTENDDB_TEST_BACKUP_STORE:-}" in
        filesystem|s3) want_store=true ;;
    esac

    echo "=== Health check: ${endpoint}/health ==="
    while [[ $elapsed -lt $timeout ]]; do
        local body
        if body=$(curl -skf "${endpoint}/health" 2>/dev/null) && [[ -n "$body" ]]; then
            if ! $want_store; then
                echo "  ✓ Server is healthy (${elapsed}s)"
                return 0
            fi
            if printf '%s' "$body" | python3 -c 'import json, sys
h = json.load(sys.stdin)
sys.exit(0 if h.get("components", {}).get("backup_store", {}).get("status") == "healthy" else 1)' 2>/dev/null; then
                echo "  ✓ Server and its backup store are healthy (${elapsed}s)"
                return 0
            fi
        fi
        sleep "$interval"
        elapsed=$((elapsed + interval))
    done
    echo "  ✗ Server health check failed after ${timeout}s"
    if $want_store; then
        echo "  The backup store component did not report healthy; last: $(curl -sk "${endpoint}/health" 2>/dev/null)"
    fi
    echo "  Is the server running? Check: curl -sk ${endpoint}/health"
    return 1
}

PASS=true
CLEANUP_TRUSTSTORE=""

# --- Pre-flight for integration suites (local targets) ---
if $NEEDS_INTEGRATION && [[ "$TARGET" != "real-dynamodb" ]]; then
    # Health check
    if ! health_check "$EXTENDDB_TEST_ENDPOINT"; then
        echo "error: Server is not healthy. Cannot run integration tests."
        exit 1
    fi

    # Provision test credentials
    echo "=== Provisioning test credentials ==="
    export EXTENDDB_ADMIN_USER="${EXTENDDB_ADMIN_USER:-admin}"
    CRED_FILE=$(mktemp)
    if python3 devtools/provision-test-credentials > "$CRED_FILE"; then
        eval "$(cat "$CRED_FILE")"
        echo "  ✓ Credentials provisioned: AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID"
    else
        echo "  ✗ Credential provisioning failed"
        cat "$CRED_FILE"
        rm -f "$CRED_FILE"
        exit 1
    fi
    rm -f "$CRED_FILE"

    # Post-provisioning: validate key prefix matches target
    local_prefix=""
    case "$TARGET" in
        extenddb) local_prefix="EXTENDDB" ;;
    esac
    aki="${AWS_ACCESS_KEY_ID:-}"
    if [[ -n "$local_prefix" && -n "$aki" ]]; then
        if [[ "$aki" != AKIA${local_prefix}* && "$aki" != ASIA${local_prefix}* ]]; then
            echo "error: --${TARGET} requires AWS_ACCESS_KEY_ID to start with AKIA${local_prefix} or ASIA${local_prefix}."
            echo "  Got: $aki"
            echo "  Credential provisioning returned unexpected key format."
            exit 1
        fi
    fi

    # Java truststore for HTTPS
    if [[ "$EXTENDDB_TEST_ENDPOINT" == https://* ]]; then
        CERT_PATH="$HOME/.${TARGET}/tls/cert.pem"
        if [[ -f "$CERT_PATH" ]] && command -v keytool >/dev/null 2>&1; then
            TRUSTSTORE=$(mktemp -u).jks
            keytool -importcert -noprompt -alias "$TARGET" -file "$CERT_PATH" \
                -keystore "$TRUSTSTORE" -storepass changeit 2>/dev/null
            export JAVA_TOOL_OPTIONS="-Djavax.net.ssl.trustStore=$TRUSTSTORE -Djavax.net.ssl.trustStorePassword=changeit"
            echo "  ✓ Java truststore created: $TRUSTSTORE"
            CLEANUP_TRUSTSTORE="$TRUSTSTORE"
        fi
    fi

    # Runtime settings
    BINARY="target/release/$TARGET"
    if [[ ! -x "$BINARY" ]]; then
        BINARY="target/debug/$TARGET"
    fi
    CONFIG_FOR_SETTINGS="${CONFIG_PATH:-${TARGET}.toml}"
    if [[ -x "$BINARY" && -f "$CONFIG_FOR_SETTINGS" ]]; then
        if "$BINARY" settings --config "$CONFIG_FOR_SETTINGS" set control_plane_delay_seconds 0.05 2>/dev/null; then
            echo "  ✓ control_plane_delay_seconds set to 0.05"
        fi
        if "$BINARY" settings --config "$CONFIG_FOR_SETTINGS" set index_propagation_delay_ms 0 2>/dev/null; then
            echo "  ✓ index_propagation_delay_ms set to 0"
        fi
        if "$BINARY" settings --config "$CONFIG_FOR_SETTINGS" set throttling_enabled true 2>/dev/null; then
            echo "  ✓ throttling_enabled set to true"
        fi
    fi

    # Import/export paths. The Python tests write fixtures via tempfile, which
    # honours $TMPDIR — on macOS that is under /var/folders, not /tmp. Allow
    # whatever tempfile will use so exported/imported file paths validate on
    # every platform (Linux leaves TMPDIR unset, so this is /tmp there).
    TMP_ALLOWED="${TMPDIR:-/tmp}"; TMP_ALLOWED="${TMP_ALLOWED%/}"
    if [[ -f "$CONFIG_FOR_SETTINGS" ]]; then
        NEED_RESTART=false
        if ! grep -A1 '^\[import\]' "$CONFIG_FOR_SETTINGS" 2>/dev/null | grep -qF "$TMP_ALLOWED"; then
            sed '/^# \[import\]/d; /^# paths = \[\].*import/d' "$CONFIG_FOR_SETTINGS" > "$CONFIG_FOR_SETTINGS.tmp" \
                && mv "$CONFIG_FOR_SETTINGS.tmp" "$CONFIG_FOR_SETTINGS"
            printf '\n[import]\npaths = ["%s"]\n' "$TMP_ALLOWED" >> "$CONFIG_FOR_SETTINGS"
            NEED_RESTART=true
            echo "  ✓ [import] paths configured for $TMP_ALLOWED"
        fi
        if ! grep -A1 '^\[export\]' "$CONFIG_FOR_SETTINGS" 2>/dev/null | grep -qF "$TMP_ALLOWED"; then
            sed '/^# \[export\]/d; /^# paths = \[\].*export/d' "$CONFIG_FOR_SETTINGS" > "$CONFIG_FOR_SETTINGS.tmp" \
                && mv "$CONFIG_FOR_SETTINGS.tmp" "$CONFIG_FOR_SETTINGS"
            printf '\n[export]\npaths = ["%s"]\n' "$TMP_ALLOWED" >> "$CONFIG_FOR_SETTINGS"
            NEED_RESTART=true
            echo "  ✓ [export] paths configured for $TMP_ALLOWED"
        fi
        if $NEED_RESTART && [[ -x "$BINARY" ]]; then
            echo "  Restarting server to pick up import/export config..."
            # Report failures instead of hiding them. A health check alone is not
            # proof of a restart: if `stop` cannot signal the server (a
            # --foreground server without --write-pid-file writes no PID file)
            # the old process keeps serving and answers the health check while
            # the new config is never picked up.
            if ! "$BINARY" stop --config "$CONFIG_FOR_SETTINGS"; then
                echo "  ✗ Could not stop the running server to apply the config change."
                echo "    If it was started with 'serve --foreground', restart it with"
                echo "    --write-pid-file so 'stop' can signal it."
                exit 1
            fi
            sleep 1
            if ! "$BINARY" serve --config "$CONFIG_FOR_SETTINGS"; then
                echo "  ✗ Server failed to start after config change"
                exit 1
            fi
            sleep 2
            if health_check "$EXTENDDB_TEST_ENDPOINT"; then
                echo "  ✓ Server restarted with import/export enabled"
            else
                echo "  ✗ Server failed to restart after config change"
                exit 1
            fi
        fi
    fi

    # Export PG connection string for CLI lifecycle tests (PostgreSQL only).
    # test_cli_lifecycle.py is PostgreSQL-specific and excluded from the
    # main pytest suite; it opens its own extenddb instances via the
    # connection string. Skipped on the mongo backend.
    if [[ "$BACKEND" == "postgres" \
        && -z "${EXTENDDB_TEST_PG_CONNECTION_STRING:-}" \
        && -f "$CONFIG_FOR_SETTINGS" ]]; then
        FULL_CONN=$(grep 'connection_string' "$CONFIG_FOR_SETTINGS" 2>/dev/null | sed -n 's/.*connection_string[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' | head -1 || true)
        if [[ -n "$FULL_CONN" ]]; then
            # Strip trailing /database_name to get base URL
            export EXTENDDB_TEST_PG_CONNECTION_STRING="${FULL_CONN%/*}"
            echo "  ✓ EXTENDDB_TEST_PG_CONNECTION_STRING=${EXTENDDB_TEST_PG_CONNECTION_STRING}"
        fi
    fi
    echo ""
fi

# --- Rust tests ---
if $RUN_RUST; then
    if $RELEASE; then
        OUTFILE="discussions/test-rust-release-${HASH}.txt"
        echo "=== Rust tests (release) → ${OUTFILE} ==="
        CARGO_ARGS=(cargo test --release)
    else
        OUTFILE="discussions/test-rust-${HASH}.txt"
        echo "=== Rust tests (debug) → ${OUTFILE} ==="
        CARGO_ARGS=(cargo test)
    fi
    if [[ -n "$FILTER" ]]; then
        CARGO_ARGS+=(-- "$FILTER")
    fi
    if "${CARGO_ARGS[@]}" 2>&1 | tee "$OUTFILE"; then
        echo "  ✓ Rust tests passed"
    else
        echo "  ✗ Rust tests failed"
        PASS=false
    fi
    echo ""
fi

# --- Rust integration tests (tests/rust/) ---
if $RUN_RUST_INTEGRATION; then
    OUTFILE="discussions/test-rust-integration-${HASH}.txt"
    echo "=== Rust integration tests → ${OUTFILE} ==="
    # Set CA cert for TLS verification against self-signed certs
    if [[ "$TARGET" != "real-dynamodb" && "${EXTENDDB_TEST_ENDPOINT:-}" == https://* ]]; then
        CERT_PATH="$HOME/.${TARGET}/tls/cert.pem"
        if [[ -f "$CERT_PATH" ]]; then
            export EXTENDDB_CA_CERT="$CERT_PATH"
        fi
    fi
    CARGO_ARGS=(cargo test --manifest-path tests/rust/Cargo.toml)
    if $RELEASE; then
        CARGO_ARGS+=(--release)
    fi
    # Integration tests share a single Client whose HTTP/2 connection pool
    # is tied to the creating tokio runtime. Parallel #[tokio::test] runtimes
    # cause DispatchGone cascading failures. Force sequential execution.
    CARGO_ARGS+=(--)
    CARGO_ARGS+=(--test-threads=1)
    if [[ -n "$FILTER" ]]; then
        CARGO_ARGS+=("$FILTER")
    fi
    if "${CARGO_ARGS[@]}" 2>&1 | tee "$OUTFILE"; then
        echo "  ✓ Rust integration tests passed"
    else
        echo "  ✗ Rust integration tests failed"
        PASS=false
    fi
    echo ""
fi

# --- Shards (--shard K/N) ---
# CI splits the long pytest suites across jobs. Before each suite runs,
# devtools/test-shards prepare collects the whole suite with the suite's own
# arguments, picks this shard's files, and records both lists under
# $SHARD_DIR for the summary job's `devtools/test-shards check`. pytest then
# loads devtools/pytest_shard.py, which keeps only those files. A shard with
# no files of a suite runs nothing for it. shard_suite SUITE CMD... leaves
# the command to run in SHARD_CMD.
SHARD_DIR="${EXTENDDB_SHARD_DIR:-discussions/shards}"
shard_suite() {
    local suite="$1" rc=0
    shift
    # "${@:4}" is the suite's arguments after "python3 -m pytest".
    "$SCRIPT_DIR/test-shards" prepare --shard "$SHARD" --out "$SHARD_DIR" \
        --backend "$BACKEND" --config "${CONFIG_PATH:-extenddb.toml}" \
        "$suite" -- "${@:4}" || rc=$?
    SHARD_CMD=("$@")
    if (( rc == 0 )); then
        export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
        export EXTENDDB_SHARD_FILES="$SHARD_DIR/files-$suite.txt"
        SHARD_CMD+=(-p pytest_shard)
    elif (( rc == 10 )); then
        echo "  shard $SHARD has no $suite files; nothing to run"
        SHARD_CMD=(true)
    else
        echo "  ✗ devtools/test-shards prepare failed for the $suite suite"
        SHARD_CMD=(false)
    fi
}

# --- Pytest ---
if $RUN_PYTEST; then
    OUTFILE="discussions/test-pytest-${HASH}.txt"
    echo "=== Pytest → ${OUTFILE} ==="
    if [[ "$TARGET" == "real-dynamodb" ]]; then
        echo "  target: real DynamoDB (AWS SDK defaults)"
    else
        echo "  endpoint: $EXTENDDB_TEST_ENDPOINT"
    fi
    echo "  AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID:-}"
    # CLI lifecycle tests manage their own server; exclude from main suite.
    # tests/test_backup_store_config.py does too: it runs below, in the CLI
    # lifecycle list on PostgreSQL and, in a run without --shard, in its own
    # step on a SQLite build.
    # tests/test_backup_job.py starts its own servers as well; CI runs it in
    # the integration workflows' backup steps, this script does not run it.
    # -rP: the summary repeats the passed tests that printed something (the
    # backup cells print which branch ran and which store the server reports),
    # which pytest's capture would otherwise keep out of the log.
    PYTEST_ARGS=(python3 -m pytest tests/ -v -rP --ignore=tests/python --ignore=tests/test_cli_lifecycle.py --ignore=tests/test_cli_container_readiness.py --ignore=tests/test_cli_migrate_concurrency.py --ignore=tests/test_cli_vector_catalog_migration.py --ignore=tests/test_gsi_async_queue.py --ignore=tests/test_backup_store_config.py --ignore=tests/test_backup_job.py)
    # Parallel execution (--parallel): distribute by file so module/class-scoped
    # fixtures stay within a single worker.
    if [[ -n "$PARALLEL" ]] && python3 -c "import xdist" 2>/dev/null; then
        if [[ "$PARALLEL" == "auto" ]]; then
            XDIST_WORKERS=$(python3 -c "import os; print(max(2, os.cpu_count() // 3))")
        else
            XDIST_WORKERS="$PARALLEL"
        fi
        PYTEST_ARGS+=(-n "$XDIST_WORKERS" --dist loadfile)
    fi
    if [[ -n "$FILTER" ]]; then
        PYTEST_ARGS+=(-k "$FILTER")
    fi
    if [[ -n "$SHARD" ]]; then shard_suite main "${PYTEST_ARGS[@]}"; PYTEST_ARGS=("${SHARD_CMD[@]}"); fi
    if "${PYTEST_ARGS[@]}" 2>&1 | tee "$OUTFILE"; then
        echo "  ✓ Pytest passed"
    else
        echo "  ✗ Pytest failed (check output for details)"
        PASS=false
    fi
    echo ""
fi

# --- External tests ---
if $RUN_EXTERNAL; then
    OUTFILE="discussions/test-external-${HASH}.txt"
    JSONFILE="discussions/test-external-${HASH}.json"
    echo "=== External tests → ${OUTFILE} ==="
    if [[ "$TARGET" == "real-dynamodb" ]]; then
        echo "  target: real DynamoDB (AWS SDK defaults)"
        # External tests use EXTENDDB_ENDPOINT; for real DDB, leave it unset
        # so the Java SDK uses default endpoint resolution.
        unset EXTENDDB_ENDPOINT 2>/dev/null || true
        if devtools/run-external-tests --verbose --report "$JSONFILE" 2>&1 | tee "$OUTFILE"; then
            echo "  ✓ External tests passed"
        else
            echo "  ✗ External tests had failures (check output for details)"
            PASS=false
        fi
    else
        export EXTENDDB_ENDPOINT="${EXTENDDB_TEST_ENDPOINT}"
        echo "  endpoint: $EXTENDDB_ENDPOINT"
        if devtools/run-external-tests --verbose --endpoint "$EXTENDDB_TEST_ENDPOINT" --report "$JSONFILE" 2>&1 | tee "$OUTFILE"; then
            echo "  ✓ External tests passed"
        else
            echo "  ✗ External tests had failures (check output for details)"
            PASS=false
        fi
    fi
    echo ""
fi

# --- Comprehensive tests ---
if $RUN_COMPREHENSIVE; then
    OUTFILE="discussions/test-comprehensive-${HASH}.txt"
    echo "=== Comprehensive tests (Python) → ${OUTFILE} ==="
    if [[ "$TARGET" == "real-dynamodb" ]]; then
        echo "  target: real DynamoDB (AWS SDK defaults)"
        unset DYNAMODB_ENDPOINT 2>/dev/null || true
        unset EXTENDDB_CA_CERT 2>/dev/null || true
        # Set validation mode so extenddb-only tests are skipped against real DDB
        export EXTENDDB_VALIDATION_MODE=true
    else
        export DYNAMODB_ENDPOINT="${EXTENDDB_TEST_ENDPOINT}"
        echo "  endpoint: $DYNAMODB_ENDPOINT"
        if [[ "$EXTENDDB_TEST_ENDPOINT" == https://* ]]; then
            CERT_PATH="$HOME/.${TARGET}/tls/cert.pem"
            if [[ -f "$CERT_PATH" ]]; then
                export EXTENDDB_CA_CERT="$CERT_PATH"
            fi
        fi
    fi
    COMP_ARGS=(python3 -m pytest tests/python/ -v --tb=short)
    if [[ -n "$FILTER" ]]; then
        COMP_ARGS+=(-k "$FILTER")
    fi
    if [[ -n "$SHARD" ]]; then shard_suite comprehensive "${COMP_ARGS[@]}"; COMP_ARGS=("${SHARD_CMD[@]}"); fi
    if "${COMP_ARGS[@]}" 2>&1 | tee "$OUTFILE"; then
        echo "  ✓ Comprehensive tests passed"
    else
        echo "  ✗ Comprehensive tests had failures (check output for details)"
        PASS=false
    fi
    echo ""
fi

# --- Terraform (the provider's WarmThroughput wait, issue #462) ---
if $RUN_TERRAFORM; then
    OUTFILE="discussions/test-terraform-${HASH}.txt"
    echo "=== Terraform apply → ${OUTFILE} ==="
    if [[ "$TARGET" == "real-dynamodb" ]]; then
        echo "  skipped: the configuration points at an ExtendDB endpoint"
    elif [[ -n "$SHARD" && "${SHARD%%/*}" != "1" ]]; then
        # The apply is one run, not a suite of test files, so a sharded job
        # runs it on shard 1 only.
        echo "  skipped: shard $SHARD (shard 1 runs the apply)"
    elif EXTENDDB_TEST_ENDPOINT="$EXTENDDB_TEST_ENDPOINT" \
        tests/terraform/warm-throughput/run.sh 2>&1 | tee "$OUTFILE"; then
        echo "  ✓ Terraform apply passed"
    else
        echo "  ✗ Terraform apply failed"
        PASS=false
    fi
    echo ""
fi

# --- CLI lifecycle tests (postgres-only; run last — they start/stop their own servers) ---
if $RUN_PYTEST \
    && [[ "$TARGET" != "real-dynamodb" \
        && "$BACKEND" == "postgres" \
        && -n "${EXTENDDB_TEST_PG_CONNECTION_STRING:-}" ]]; then
    CLI_OUTFILE="discussions/test-cli-${HASH}.txt"
    echo "=== CLI lifecycle tests → ${CLI_OUTFILE} ==="
    CLI_ARGS=(python3 -m pytest tests/test_cli_lifecycle.py tests/test_cli_container_readiness.py tests/test_cli_migrate_concurrency.py tests/test_cli_vector_catalog_migration.py tests/test_backup_store_config.py -v)
    if [[ -n "$FILTER" ]]; then
        CLI_ARGS+=(-k "$FILTER")
    fi
    if [[ -n "$SHARD" ]]; then shard_suite cli "${CLI_ARGS[@]}"; CLI_ARGS=("${SHARD_CMD[@]}"); fi
    if "${CLI_ARGS[@]}" 2>&1 | tee "$CLI_OUTFILE"; then
        echo "  ✓ CLI lifecycle tests passed"
    else
        echo "  ✗ CLI lifecycle tests failed"
        PASS=false
    fi
    echo ""
fi

# --- Backup store wire tests on a SQLite build (run last — they start/stop their own servers) ---
# tests/test_backup_store_config.py's SQLite cells: the default root, the
# S3 store's health against moto (skipped with a reason unless
# EXTENDDB_TEST_S3_ENDPOINT names a moto endpoint), `backup list` and
# `backup purge` with their signals and exit codes. Its PostgreSQL cells run
# in the CLI lifecycle list above. The build decides: the step runs when the
# binary reports itself a SQLite build. A run with --shard skips it: the file
# is not split into shards, so every shard would run all of it, and CI's
# run-integration-sqlite-s3 job runs it once per run on the same build, with
# the S3 mock.
if $RUN_PYTEST && [[ "$TARGET" != "real-dynamodb" ]]; then
    WIRE_BINARY="${EXTENDDB_BINARY:-target/release/$TARGET}"
    if [[ ! -x "$WIRE_BINARY" ]]; then
        WIRE_BINARY="target/debug/$TARGET"
    fi
    if [[ -x "$WIRE_BINARY" ]] && "$WIRE_BINARY" version 2>/dev/null | grep -q '(sqlite)'; then
        WIRE_OUTFILE="discussions/test-backup-store-wire-${HASH}.txt"
        echo "=== Backup store wire tests (SQLite build) → ${WIRE_OUTFILE} ==="
        if [[ -n "$SHARD" ]]; then
            echo "  skipped: shard $SHARD (run-integration-sqlite-s3 runs this file)"
        else
            echo "  binary: $WIRE_BINARY"
            echo "  S3 endpoint: ${EXTENDDB_TEST_S3_ENDPOINT:-none (the S3 cells skip)}"
            WIRE_ARGS=(python3 -m pytest tests/test_backup_store_config.py -v)
            if [[ -n "$FILTER" ]]; then
                WIRE_ARGS+=(-k "$FILTER")
            fi
            if EXTENDDB_BINARY="$WIRE_BINARY" "${WIRE_ARGS[@]}" 2>&1 | tee "$WIRE_OUTFILE"; then
                echo "  ✓ Backup store wire tests passed"
            else
                echo "  ✗ Backup store wire tests failed"
                PASS=false
            fi
        fi
        echo ""
    fi
fi

# --- Catalog check ---
if $RUN_CATALOG_CHECK; then
    if [[ "$TARGET" == "real-dynamodb" ]]; then
        echo "=== Catalog check: skipped (not applicable for real DynamoDB) ==="
    else
        BINARY="target/release/$TARGET"
        if [[ ! -x "$BINARY" ]]; then
            BINARY="target/debug/$TARGET"
        fi
        if [[ ! -x "$BINARY" ]]; then
            echo "error: $TARGET binary not found. Build with: cargo build --release"
            exit 1
        fi
        CHECK_CONFIG="${CONFIG_PATH:-${TARGET}.toml}"
        if [[ ! -f "$CHECK_CONFIG" ]]; then
            echo "error: config file not found: $CHECK_CONFIG"
            exit 1
        fi
        echo "=== Catalog check (post-test integrity gate) ==="
        echo "  binary: $BINARY"
        echo "  config: $CHECK_CONFIG"
        if "$BINARY" catalog-check --config "$CHECK_CONFIG"; then
            echo "  ✓ Catalog check passed"
        else
            echo "  ✗ Catalog check FAILED — catalog inconsistencies detected"
            PASS=false
        fi
    fi
    echo ""
fi

# --- Test table cleanup (runs after integration suites, pass or fail) ---
if $NEEDS_INTEGRATION; then
    echo "=== Post-test table cleanup ==="
    python3 "$SCRIPT_DIR/cleanup-test-tables" || echo "  ⚠ cleanup script returned non-zero (non-fatal)"
    echo ""
fi

# --- Cleanup ---
[[ -n "$CLEANUP_TRUSTSTORE" && -f "$CLEANUP_TRUSTSTORE" ]] && rm -f "$CLEANUP_TRUSTSTORE"

if $PASS; then
    echo "=== All requested test suites completed ==="
else
    echo "=== Some test suites FAILED ==="
    exit 1
fi
