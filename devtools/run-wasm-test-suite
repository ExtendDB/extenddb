#
# Runs one of the wasm-bindgen-test suites of .github/workflows/wasm.yml and
# fails unless the run reports each test the suite names below `ok`, and no
# other test.
#
#   devtools/run-wasm-test-suite core|shim
#
#   core  extenddb-core's wasm32 unit tests (cargo test -p extenddb-core --lib)
#   shim  the SQLite shim's tests (cargo test -p extenddb-storage-sqlite
#         --test wasm_shim)
#
# `cargo test` exits 0 when a test binary holds no test, and passes with the
# rest when some tests lost their `wasm_bindgen_test` attribute, so its exit
# status is not enough. Each suite below names every one of its wasm tests, as
# the runner reports it; a change that adds, renames or removes a wasm test of
# a suite adds, renames or removes its line here.
#
# The workflow and `devtools/run-tests --wasm-test` both run the suites through
# this script, so the expectations exist once. The caller sets
# CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER to wasm-bindgen-test-runner (of the
# version of the wasm-bindgen crate in Cargo.lock), which runs each test module
# under the `node` on PATH. The script runs the cargo on PATH.

set -euo pipefail

usage() {
    echo "usage: devtools/run-wasm-test-suite core|shim" >&2
    exit 2
}

[ $# -eq 1 ] || usage
case "$1" in
    core)
        args=(-p extenddb-core --lib)
        # The nine cases of the crypto backend (src/crypto.rs) and the test of
        # limits::page_size (src/limits/mod.rs).
        tests=(
            crypto::tests::constant_time_eq_compares_contents_and_length
            crypto::tests::fill_random_produces_distinct_buffers
            crypto::tests::hmac_sha256_rfc4231_case2
            crypto::tests::open_decrypts_aws_lc_sealed_vector
            crypto::tests::open_decrypts_historical_aes_gcm_vector
            crypto::tests::open_rejects_input_too_short
            crypto::tests::open_rejects_wrong_aad_wrong_key_and_tampering
            crypto::tests::seal_open_round_trip_with_fresh_nonce
            crypto::tests::sha256_known_vector
            limits::tests::page_size_is_at_least_one_and_never_below_the_limit_it_can_hold
        )
        ;;
    shim)
        args=(-p extenddb-storage-sqlite --test wasm_shim)
        # The table of the shim's rules and the two tests that drive the
        # backend (tests/wasm_shim.rs).
        tests=(
            a_scan_limit_above_u32_max_returns_every_item
            an_update_table_that_creates_a_vector_index
            each_row_gives_its_expected_outcome
        )
        ;;
    *)
        usage
        ;;
esac
suite="$1"

if [ -z "${CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER:-}" ]; then
    echo "error: set CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER to wasm-bindgen-test-runner (the wasm-bindgen-cli of the version of the wasm-bindgen crate in Cargo.lock)" >&2
    exit 2
fi

cd "$(dirname "$0")/.."
log="$(mktemp "${TMPDIR:-/tmp}/run-wasm-test-suite.XXXXXX")"
trap 'rm -f "$log"' EXIT

echo "+ cargo test --locked ${args[*]} --target wasm32-unknown-unknown"
status=0
cargo test --locked "${args[@]}" --target wasm32-unknown-unknown 2>&1 | tee "$log" || status=$?

# The run's output without any colour escapes, for the checks below.
esc=$'\033'
output="$(sed "s/${esc}\[[0-9;]*m//g" "$log")"

problems=()
if [ "$status" -ne 0 ]; then
    problems+=("cargo test exited with status ${status}")
fi
results="$(grep -c '^test result: ' <<<"$output" || true)"
if [ "$results" -ne 1 ]; then
    problems+=("expected one 'test result:' line, found ${results}")
else
    line="$(grep '^test result: ' <<<"$output")"
    case "$line" in
        "test result: ok. ${#tests[@]} passed; 0 failed;"*) ;;
        *) problems+=("expected 'test result: ok. ${#tests[@]} passed; 0 failed;', found '${line}'") ;;
    esac
fi
# One "<name> <state>" line per test the run reports, and the lines the suite
# expects, each sorted the same way for comm.
reported="$(sed -n 's/^test \(.*\) \.\.\. \([^ ]*\)$/\1 \2/p' <<<"$output" | LC_ALL=C sort)"
expected="$(printf '%s ok\n' "${tests[@]}" | LC_ALL=C sort)"
while IFS= read -r line; do
    [ -n "$line" ] || continue
    name="${line% ok}"
    state="$(awk -v n="$name" '$1 == n { print $2; exit }' <<<"$reported")"
    problems+=("the test ${name} was ${state:+reported }${state:-not run}")
done < <(LC_ALL=C comm -23 <(printf '%s\n' "$expected") <(printf '%s\n' "$reported"))
while IFS= read -r line; do
    [ -n "$line" ] || continue
    name="${line% *}"
    if ! grep -qxF -- "$name" < <(printf '%s\n' "${tests[@]}"); then
        problems+=("the run reported ${line##* } for ${name}, a test the ${suite} suite here does not name")
    fi
done < <(LC_ALL=C comm -13 <(printf '%s\n' "$expected") <(printf '%s\n' "$reported"))

if [ ${#problems[@]} -ne 0 ]; then
    for problem in "${problems[@]}"; do
        echo "error: ${suite} suite: ${problem}" >&2
    done
    exit 1
fi
echo "${suite} suite: ${#tests[@]} tests passed, the ${#tests[@]} it names, and no other test ran"
